        registerMdbListAccountActions.call(this);
        if (TraktAuthService.getCurrentAuthState().deviceCode) this.startTraktPolling();
        if (SimklAuthService.getCurrentAuthState().userCode) this.startSimklPolling();
        const trakt = TraktAuthService.getCurrentAuthState();
        const simkl = SimklAuthService.getCurrentAuthState();
        const settings = TraktSettingsStore.get();
        const traktConnected = TraktAuthService.isAuthenticated();
        const simklConnected = SimklAuthService.isAuthenticated();
        const traktWaiting = Boolean(trakt.deviceCode && trakt.expiresAt > Date.now());
        const simklWaiting = Boolean(simkl.userCode && simkl.expiresAt > Date.now());
        const connectedWatchSources = [
          ...MdbListAccount.connected() ? [{ id: WatchProgressSource.MDBLIST, label: "MDBList" }] : [],
          { id: WatchProgressSource.NUVIO_SYNC, label: "Nuvio Sync" },
          ...traktConnected ? [{ id: WatchProgressSource.TRAKT, label: "Trakt" }] : [],
          ...simklConnected ? [{ id: WatchProgressSource.SIMKL, label: "Simkl" }] : []
        ];
        const connectedLibrarySources = [
          ...MdbListAccount.connected() ? [{ id: TraktLibrarySourceMode.MDBLIST, label: "MDBList" }] : [],
          { id: TraktLibrarySourceMode.LOCAL, label: "Nuvio" },
          ...traktConnected ? [{ id: TraktLibrarySourceMode.TRAKT, label: "Trakt" }] : [],
          ...simklConnected ? [{ id: TraktLibrarySourceMode.SIMKL, label: "Simkl" }] : []
        ];
        setAction("tracking:trakt", () => {
          this.expandedProvider = this.expandedProvider === "trakt" ? null : "trakt";
        });
        setAction("tracking:simkl", () => {
          this.expandedProvider = this.expandedProvider === "simkl" ? null : "simkl";
        });
        setAction("tracking:traktConnect", async () => {
          await this.startTraktDeviceAuth();
          if (current2()) this.expandedProvider = "trakt";
        });
        setAction("tracking:simklConnect", async () => {
          this.simklErrorMessage = null;
          try {
            await SimklAuthService.startPinAuth();
            if (!current2()) return;
            this.simklStatusMessage = t17(
              "simkl_status_enter_code",
              {},
              "Enter the code on Simkl to finish connecting."
            );
            this.startSimklPolling();
          } catch (error) {
            if (!current2()) return;
            this.simklErrorMessage = String(
              error?.message || error || t17("simkl_error_network", {}, "Unable to reach Simkl. Try again.")
            );
          }
          if (current2()) this.expandedProvider = "simkl";
        });
        setAction("tracking:traktDisconnect", () => {
          this.openOptionDialog({
            title: t17("trakt_disconnect_title", {}, "Disconnect Trakt?"),
            options: [
              { id: "disconnect", label: t17("trakt_disconnect", {}, "Disconnect") },
              { id: "cancel", label: t17("action_cancel", {}, "Cancel") }
            ],
            selectedId: "cancel",
            returnFocusKey: "tracking:trakt",
            onSelect: async (option) => {
              if (!current2() || option.id !== "disconnect") return;
              await TraktAuthService.disconnect();
            }
          });
        });
        setAction("tracking:simklDisconnect", () => {
          this.openOptionDialog({
            title: t17("simkl_disconnect_title", {}, "Disconnect Simkl?"),
            options: [
              { id: "disconnect", label: t17("simkl_disconnect", {}, "Disconnect") },
              { id: "cancel", label: t17("action_cancel", {}, "Cancel") }
            ],
            selectedId: "cancel",
            returnFocusKey: "tracking:simkl",
            onSelect: async (option) => {
              if (!current2() || option.id !== "disconnect") return;
              await SimklAuthService.disconnect();
              if (current2()) SimklSyncService.clearCurrentProfile();
            }
          });
        });
        setAction("tracking:simklSync", async () => {
          this.simklStatusMessage = t17("simkl_status_syncing", {}, "Syncing Simkl\u2026");
          this.simklErrorMessage = null;
          try {
            await SimklSyncService.refresh({ force: true });
            if (!current2()) return;
            this.simklStatusMessage = t17("simkl_status_synced", {}, "Simkl sync completed.");
          } catch (error) {
            this.simklStatusMessage = null;
            this.simklErrorMessage = String(
              error?.message || error || t17("simkl_error_network", {}, "Unable to reach Simkl. Try again.")
            );
          }
        });
        setAction("tracking:simklInfo", () => {
          this.showSimklInfo = !this.showSimklInfo;
        });
        setAction("tracking:simklVisit", () => window.open?.("https://simkl.com", "_blank"));
        setAction(
          "tracking:simklDocs",
          () => window.open?.("https://api.simkl.org/guides/sync", "_blank")
        );
        setAction(
          "tracking:librarySource",
          () => this.openTrackingChoice({
            title: t17("trakt_library_source_title", {}, "Library source"),
            options: connectedLibrarySources,
            selectedId: settings.librarySourceMode,
            returnFocusKey: "tracking:librarySource",
            onSelect: (option) => TraktSettingsStore.setLibrarySourceMode(option.id)
          })
        );
        setAction(
          "tracking:progressSource",
          () => this.openTrackingChoice({
            title: t17("trakt_watch_progress_title", {}, "Watch progress source"),
            options: connectedWatchSources,
            selectedId: settings.watchProgressSource,
            returnFocusKey: "tracking:progressSource",
            onSelect: (option) => TraktSettingsStore.setWatchProgressSource(option.id)
          })
        );
        setAction("tracking:cwWindow", () => {
          const values = [14, 30, 60, 90, 180, 365, 0];
          this.openTrackingChoice({
            title: t17("trakt_continue_watching_window", {}, "Continue Watching window"),
            options: values.map((days) => ({
              id: String(days),
              label: days === 0 ? t17("trakt_all_history", {}, "All history") : t17("trakt_days_format", [days], `${days} days`)
            })),
            selectedId: String(settings.continueWatchingDaysCap),
            returnFocusKey: "tracking:cwWindow",
            onSelect: (option) => TraktSettingsStore.setContinueWatchingDaysCap(
              normalizeTraktContinueWatchingDaysCap(Number(option.id))
            )
          });
        });
        setAction("tracking:comments", () => {
          TraktSettingsStore.setShowMetaComments(!settings.showMetaComments);
        });
        setAction(
          "tracking:moreLikeThis",
          () => this.openTrackingChoice({
            title: t17("trakt_more_like_this_source_title", {}, "More Like This source"),
            options: [
              { id: MoreLikeThisSourcePreference.TRAKT, label: "Trakt" },
              { id: MoreLikeThisSourcePreference.TMDB, label: "TMDB" }
            ],
            selectedId: settings.moreLikeThisSource,
            returnFocusKey: "tracking:moreLikeThis",
            onSelect: (option) => TraktSettingsStore.setMoreLikeThisSource(option.id)
          })
        );
        setAction(
          "tracking:animeId",
          () => this.openTrackingChoice({
            title: t17("tracking_simkl_anime_id_title", {}, "Simkl anime ID"),
            options: [
              { id: SimklAnimeIdPreference.IMDB, label: "IMDb / TMDB" },
              { id: SimklAnimeIdPreference.MAL, label: "MyAnimeList" },
              { id: SimklAnimeIdPreference.KITSU, label: "Kitsu" },
              { id: SimklAnimeIdPreference.TVDB, label: "TVDB" }
            ],
            selectedId: settings.simklAnimeIdPreference,
            returnFocusKey: "tracking:animeId",
            onSelect: (option) => {
              TraktSettingsStore.setSimklAnimeIdPreference(option.id);
              if (current2()) SimklSyncService.clearCurrentProfile();
              void SimklSyncService.refresh({ force: true });
            }
          })
        );
        const providerRow = ({ id, title, connected, waiting, username }) => this.renderActionRow({
          focusKey: `tracking:${id}`,
          leadingIconSrc: id === "simkl" ? "assets/icons/simkl_tv_glyph.svg" : "assets/icons/trakt_tv_glyph.svg",
          title,
          subtitle: connected ? t17(
            id === "simkl" ? "simkl_connected_as" : "trakt_connected_as",
            [username || `${title} user`],
            `Connected as ${username || `${title} user`}`
          ) : waiting ? t17("tracking_status_waiting", {}, "Waiting for approval") : t17(id === "simkl" ? "simkl_connect" : "trakt_login", {}, `Connect ${title}`),
          value: connected ? t17("tracking_status_connected", {}, "Connected") : waiting ? t17("tracking_status_waiting", {}, "Waiting") : t17("tracking_status_disconnected", {}, "Not connected")
        });
        return `
      <section class="settings-slide-panel settings-trakt-panel settings-tracking-panel">
        <div class="settings-trakt-hero settings-tracking-hero">
          <div>
            <div class="settings-trakt-title">${escapeHtml17(t17("settings_tracking_title", {}, "Tracking"))}</div>
            <p class="settings-trakt-description">${escapeHtml17(t17("settings_tracking_description", {}, "Connect tracking providers and choose which one powers your Library and Continue Watching."))}</p>
          </div>
        </div>
        <div class="settings-trakt-scroll-area">
          <div class="settings-trakt-card">
            <h3 class="settings-trakt-card-title">${escapeHtml17(t17("tracking_accounts_title", {}, "Accounts"))}</h3>
            <p class="settings-tracking-card-subtitle">${escapeHtml17(t17("tracking_accounts_subtitle", {}, "Connect and manage tracking services"))}</p>
            <div class="settings-trakt-options-stack">
              ${this.renderActionRow({ focusKey: "integration:mdblist:account", leadingIconSrc: "assets/icons/mdblist_logo.svg", title: "MDBList", subtitle: MdbListAccount.connected() ? t17("mdblist_connected_as", [MdbListAccount.user()?.name || t17("mdblist_account_fallback")]) : t17("mdblist_tracking_description"), value: MdbListAccount.connected() ? t17("tracking_status_connected", {}, "Connected") : t17("servers_connect"), disabled: !MdbListAccount.configured() && !MdbListAccount.connected() })}
              ${providerRow({ id: "trakt", title: "Trakt", connected: traktConnected, waiting: traktWaiting, username: trakt.username })}
              ${providerRow({ id: "simkl", title: "Simkl", connected: simklConnected, waiting: simklWaiting, username: simkl.username })}
            </div>
          </div>
          ${this.mdbListAccountMessage ? `<p class="settings-trakt-message" role="status">${escapeHtml17(this.mdbListAccountMessage)}</p>` : ""}
          ${this.expandedProvider === "trakt" ? this.renderTrackingTraktAccount(trakt, traktConnected, traktWaiting) : ""}
          ${this.expandedProvider === "simkl" ? this.renderTrackingSimklAccount(simkl, simklConnected, simklWaiting) : ""}
          <div class="settings-trakt-card">
            <h3 class="settings-trakt-card-title">${escapeHtml17(t17("tracking_sources_title", {}, "Sources"))}</h3>
            <p class="settings-tracking-card-subtitle">${escapeHtml17(t17("tracking_sources_subtitle", {}, "Choose where Nuvio reads your library and watch progress. Playback scrobbles to every connected service."))}</p>
            <div class="settings-trakt-options-stack">
              ${this.renderActionRow({ focusKey: "tracking:librarySource", title: t17("trakt_library_source_title", {}, "Library source"), subtitle: t17("tracking_library_source_dialog_subtitle", {}, "Choose the service Nuvio reads for your Library."), value: connectedLibrarySources.find((item) => item.id === settings.librarySourceMode)?.label || "Nuvio" })}
              ${this.renderActionRow({ focusKey: "tracking:progressSource", title: t17("trakt_watch_progress_title", {}, "Watch progress source"), subtitle: t17("tracking_watch_progress_dialog_subtitle", {}, "Choose the service Nuvio reads for resume and Continue Watching."), value: connectedWatchSources.find((item) => item.id === settings.watchProgressSource)?.label || "Nuvio Sync" })}
            </div>
          </div>
          ${traktConnected ? `
            <div class="settings-trakt-card">
              <h3 class="settings-trakt-card-title">${escapeHtml17(t17("tracking_trakt_features_title", {}, "Trakt features"))}</h3>
              <p class="settings-tracking-card-subtitle">${escapeHtml17(t17("tracking_trakt_features_subtitle", {}, "Trakt-specific history, reviews, and recommendations"))}</p>
              <div class="settings-trakt-options-stack">
                ${this.renderActionRow({ focusKey: "tracking:cwWindow", title: t17("trakt_continue_watching_window", {}, "Continue Watching window"), subtitle: t17("trakt_continue_watching_subtitle", {}, "Trakt history considered for Continue Watching"), value: settings.continueWatchingDaysCap === 0 ? t17("trakt_all_history", {}, "All history") : t17("trakt_days_format", [settings.continueWatchingDaysCap], `${settings.continueWatchingDaysCap} days`) })}
                ${this.renderToggleRow({ focusKey: "tracking:comments", title: t17("trakt_comments_title", {}, "Trakt comments"), subtitle: t17("trakt_comments_subtitle", {}, "Show Trakt reviews on metadata pages"), checked: Boolean(settings.showMetaComments) })}
                ${this.renderActionRow({ focusKey: "tracking:moreLikeThis", title: t17("trakt_more_like_this_source_title", {}, "More Like This source"), subtitle: t17("trakt_more_like_this_source_subtitle", {}, "Choose related titles from Trakt or TMDB"), value: settings.moreLikeThisSource === MoreLikeThisSourcePreference.TMDB ? "TMDB" : "Trakt" })}
              </div>
            </div>
          ` : ""}
          ${simklConnected ? `
            <div class="settings-trakt-card">
              <h3 class="settings-trakt-card-title">${escapeHtml17(t17("tracking_simkl_features_title", {}, "Simkl features"))}</h3>
              <p class="settings-tracking-card-subtitle">${escapeHtml17(t17("tracking_simkl_features_subtitle", {}, "Simkl-specific settings"))}</p>
              <div class="settings-trakt-options-stack">
                ${this.renderActionRow({ focusKey: "tracking:animeId", title: t17("tracking_simkl_anime_id_title", {}, "Anime ID preference"), subtitle: t17("tracking_simkl_anime_id_subtitle", {}, "Controls how anime series are identified"), value: settings.simklAnimeIdPreference === "mal" ? "MyAnimeList" : settings.simklAnimeIdPreference === "kitsu" ? "Kitsu" : settings.simklAnimeIdPreference === "tvdb" ? "TVDB" : "IMDb / TMDB" })}
              </div>
            </div>
          ` : ""}
          ${simklConnected ? `<p class="settings-trakt-meta-copy settings-tracking-attribution">${escapeHtml17(t17("licenses_attributions_simkl_body", {}, "Library and tracking data provided by Simkl."))}</p>` : ""}
        </div>
      </section>
    `;
      },
      renderTrackingTraktAccount(auth, connected, waiting) {
        if (connected) {
          const tokenRemainingMs = auth.createdAt && auth.expiresIn ? Math.max(0, (Number(auth.createdAt) + Number(auth.expiresIn)) * 1e3 - Date.now()) : 0;
          return `<div class="settings-trakt-card settings-tracking-account-card"><h3 class="settings-trakt-card-title">${escapeHtml17(t17("trakt_account_login", {}, "Trakt account"))}</h3><p class="settings-trakt-body-copy">${escapeHtml17(t17("trakt_connected_as", [auth.username || "Trakt user"], `Connected as ${auth.username || "Trakt user"}`))}</p>${tokenRemainingMs ? `<p class="settings-trakt-meta-copy">${escapeHtml17(t17("trakt_token_refreshes", [formatCountdown(tokenRemainingMs)], `Token refreshes in ${formatCountdown(tokenRemainingMs)}`))}</p>` : ""}${this.renderTraktStatsStrip(this.traktStats, this.traktStatsLoading)}${this.renderActionRow({ focusKey: "tracking:traktDisconnect", title: t17("trakt_disconnect", {}, "Disconnect Trakt"), subtitle: t17("trakt_disconnect_subtitle", {}, "Remove this profile's Trakt connection") })}</div>`;
        }
        return `<div class="settings-trakt-card settings-tracking-account-card"><h3 class="settings-trakt-card-title">${escapeHtml17(t17("trakt_login", {}, "Connect Trakt"))}</h3>${waiting ? `<p class="settings-trakt-body-copy">${escapeHtml17(t17("trakt_awaiting_instruction", {}, "Open the Trakt activation page on another device and enter this code."))}</p><strong>${escapeHtml17(auth.verificationUrl || "https://trakt.tv/activate")}</strong><div class="settings-trakt-code">${escapeHtml17(auth.userCode || "-")}</div><p class="settings-trakt-meta-copy">${escapeHtml17(t17("trakt_code_expires", [formatCountdown(Number(auth.expiresAt) - Date.now())], `Code expires in ${formatCountdown(Number(auth.expiresAt) - Date.now())}`))}</p>` : `<p class="settings-trakt-body-copy">${escapeHtml17(t17("trakt_manual_code_description", {}, "A manual activation code will be shown here. No QR code is required."))}</p>${this.renderActionRow({ focusKey: "tracking:traktConnect", title: t17("trakt_login", {}, "Connect Trakt"), subtitle: TraktAuthService.hasRequiredCredentials() ? t17("trakt_manual_code_description", {}, "Generate activation code") : t17("trakt_missing_credentials", {}, "Missing Trakt client credentials") })}`}${this.traktStatusMessage ? `<p class="settings-trakt-message">${escapeHtml17(this.traktStatusMessage)}</p>` : ""}${this.traktErrorMessage ? `<p class="settings-trakt-error">${escapeHtml17(this.traktErrorMessage)}</p>` : ""}</div>`;
      },
      renderTrackingSimklAccount(auth, connected, waiting) {
        if (connected) {
          return `<div class="settings-trakt-card settings-tracking-account-card"><h3 class="settings-trakt-card-title">${escapeHtml17(t17("simkl_account_title", {}, "Simkl account"))}</h3><p class="settings-trakt-body-copy">${escapeHtml17(t17("simkl_connected_as", [auth.username || "Simkl user"], `Connected as ${auth.username || "Simkl user"}`))}</p>${this.renderActionRow({ focusKey: "tracking:simklSync", title: t17("simkl_sync_now", {}, "Sync now"), subtitle: t17("simkl_status_syncing", {}, "Check Simkl immediately for remote changes") })}${this.renderActionRow({ focusKey: "tracking:simklVisit", title: t17("simkl_visit", {}, "Visit Simkl") })}${this.renderActionRow({ focusKey: "tracking:simklInfo", title: t17("simkl_sync_info_action", {}, "How syncing works"), subtitle: t17("simkl_sync_info_title", {}, "Automatic refresh and Continue Watching rules") })}${this.showSimklInfo ? `<div class="settings-tracking-sync-info"><p>${escapeHtml17(t17("simkl_sync_info_description", [15], "Nuvio checks Simkl automatically at most once every 15 minutes."))}</p><p>${escapeHtml17(t17("simkl_sync_info_activity", {}, "Each refresh downloads only changes."))}</p><p>${escapeHtml17(t17("simkl_sync_info_manual", {}, "Changes made in Nuvio are sent immediately."))}</p><p>${escapeHtml17(t17("simkl_sync_info_library_statuses", {}, "On Hold and Dropped shows stay hidden from Continue Watching."))}</p>${this.renderActionRow({ focusKey: "tracking:simklDocs", title: t17("simkl_sync_info_docs", {}, "Read the Simkl sync guide") })}</div>` : ""}${this.renderActionRow({ focusKey: "tracking:simklDisconnect", title: t17("simkl_disconnect", {}, "Disconnect Simkl"), subtitle: t17("simkl_disconnect_subtitle", {}, "Remove this profile's Simkl connection") })}${this.simklStatusMessage ? `<p class="settings-trakt-message">${escapeHtml17(this.simklStatusMessage)}</p>` : ""}${this.simklErrorMessage ? `<p class="settings-trakt-error">${escapeHtml17(this.simklErrorMessage)}</p>` : ""}</div>`;
        }
        return `<div class="settings-trakt-card settings-tracking-account-card"><h3 class="settings-trakt-card-title">${escapeHtml17(t17("simkl_connect", {}, "Connect Simkl"))}</h3>${waiting ? `<p class="settings-trakt-body-copy">${escapeHtml17(t17("simkl_awaiting_instruction", {}, "Open the Simkl verification page and enter this code."))}</p><strong>${escapeHtml17(auth.verificationUrl || "https://simkl.com/pin")}</strong><div class="settings-trakt-code">${escapeHtml17(auth.userCode || "-")}</div><p class="settings-trakt-meta-copy">${escapeHtml17(t17("simkl_code_expires", [formatCountdown(Number(auth.expiresAt) - Date.now())], `Code expires in ${formatCountdown(Number(auth.expiresAt) - Date.now())}`))}</p>` : `<p class="settings-trakt-body-copy">${escapeHtml17(t17("simkl_description", {}, "A manual PIN will be shown here. Enter it on Simkl from a phone or computer."))}</p>${this.renderActionRow({ focusKey: "tracking:simklConnect", title: t17("simkl_connect", {}, "Connect Simkl"), subtitle: SimklAuthService.hasRequiredCredentials() ? t17("simkl_status_enter_code", {}, "Generate manual PIN") : t17("simkl_missing_credentials", {}, "Missing SIMKL_CLIENT_ID") })}`}${this.simklStatusMessage ? `<p class="settings-trakt-message">${escapeHtml17(this.simklStatusMessage)}</p>` : ""}${this.simklErrorMessage ? `<p class="settings-trakt-error">${escapeHtml17(this.simklErrorMessage)}</p>` : ""}</div>`;
      },
      startSimklPolling(force = false) {
        if (this.simklPollInFlight && !force) return;
        if (this.simklPollTimer && !force) return;
        if (this.simklPollTimer) clearTimeout(this.simklPollTimer);
        const generation3 = this.trackingWorkGeneration || 0;
        const profileId2 = ProfileManager.getActiveProfileId();
        const isCurrent = () => isTrackingActive(this) && (this.trackingWorkGeneration || 0) === generation3 && ProfileManager.getActiveProfileId() === profileId2;
        const poll2 = async () => {
          if (!isCurrent()) return;
          const lease = {};
          if (this.simklPollInFlight) return;
          this.simklPollInFlight = lease;
          try {
            const state3 = SimklAuthService.getCurrentAuthState();
            if (!state3.userCode || !isTrackingActive(this)) {
              this.simklPollTimer = null;
              return;
            }
            const result = await SimklAuthService.pollPin().catch((error) => ({
              type: "failed",
              message: String(
                error?.message || error || t17("simkl_error_network", {}, "Unable to reach Simkl. Try again.")
              )
            }));
            if (!isCurrent()) return;
            if (result.type === "approved") {
              this.simklPollTimer = null;
              this.simklStatusMessage = t17(
                "simkl_connected_as",
                [result.username || "Simkl"],
                `Connected as ${result.username || "Simkl"}`
              );
              await SimklSyncService.refresh({ force: true }).catch(() => false);
              if (!isCurrent()) return;
              await this.render();
              return;
            }
            if (result.type === "pending") {
              this.simklStatusMessage = t17("simkl_status_waiting", {}, "Waiting for Simkl approval\u2026");
            } else if (result.type === "expired" || result.type === "invalidated") {
              this.simklErrorMessage = t17(
                "simkl_error_code_expired",
                {},
                "Simkl code expired. Start again."
              );
              this.simklPollTimer = null;
              await this.render();
              return;
            } else if (result.type === "failed") {
              this.simklErrorMessage = result.message;
              this.simklPollTimer = null;
              await this.render();
              return;
            }
            await this.render();
            if (!isCurrent()) return;
            const next = SimklAuthService.getCurrentAuthState();
            this.simklPollTimer = setTimeout(
              () => {
                this.simklPollTimer = null;
                void poll2();
              },
              Math.max(1, Number(next.pollInterval || 5)) * 1e3
            );
          } finally {
            if (this.simklPollInFlight === lease) this.simklPollInFlight = null;
          }
        };
        void poll2();
      },
      startTraktPolling(force = false) {
        if (this.traktPollInFlight && !force) return;
        if (this.traktPollTimer && !force) {
          return;
        }
        this.stopTraktPolling();
        const generation3 = this.trackingWorkGeneration || 0;
        const profileId2 = ProfileManager.getActiveProfileId();
        const isCurrent = () => isTrackingActive(this) && (this.trackingWorkGeneration || 0) === generation3 && ProfileManager.getActiveProfileId() === profileId2;
        const poll2 = async () => {
          if (!isCurrent()) return;
          const lease = {};
          if (this.traktPollInFlight) return;
          this.traktPollInFlight = lease;
          try {
            const state3 = TraktAuthService.getCurrentAuthState();
            if (!state3.deviceCode || !isTrackingActive(this)) {
              this.stopTraktPolling();
              return;
            }
            const result = await TraktAuthService.pollDeviceToken().catch((error) => ({
              type: "failed",
              message: String(
                error?.message || error || t17("trakt_error_network_will_retry", {}, "Network error, will retry")
              )
            }));
            if (!isCurrent()) return;
            if (result.type === "approved") {
              this.stopTraktPolling();
              this.traktStatusMessage = t17(
                "trakt_connected_as",
                [result.username || "Trakt"],
                `Connected as ${result.username || "Trakt"}`
              );
              this.traktErrorMessage = null;
              await this.loadTraktStats(true);
              if (!isCurrent()) return;
              await this.render();
              return;
            }
            if (result.type === "pending") {
              this.traktStatusMessage = t17("tracking_status_waiting", {}, "Waiting for approval");
              this.traktErrorMessage = null;
            } else if (result.type === "slow_down") {
              this.traktStatusMessage = t17(
                "trakt_status_rate_limited_slowing_polling",
                {},
                "Rate limited, slowing down polling..."
              );
              this.traktErrorMessage = null;
            } else if (result.type === "expired") {
              this.stopTraktPolling();
              this.traktStatusMessage = null;
              this.traktErrorMessage = t17(
                "trakt_error_code_expired",
                {},
                "Device code expired. Start again."
              );
            } else if (result.type === "denied") {
              this.stopTraktPolling();
