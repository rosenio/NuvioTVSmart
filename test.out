      },
      collectTraktModel() {
        const auth = TraktAuthService2.getCurrentAuthState();
        const settings = TraktSettingsStore2.get();
        const mode = auth.accessToken && auth.refreshToken ? "connected" : auth.deviceCode ? "awaiting_approval" : "disconnected";
        return {
          auth,
          settings,
          mode,
          credentialsConfigured: TraktAuthService2.hasRequiredCredentials(),
          isLoading: Boolean(this.traktLoading),
          isStatsLoading: Boolean(this.traktStatsLoading),
          statusMessage: this.traktStatusMessage || null,
          errorMessage: this.traktErrorMessage || null,
          stats: this.traktStats || null
        };
      },
      ensureAccountSyncOverview(authState = AuthManager2.getAuthState()) {
        if (authState !== "authenticated") {
          this.accountSyncOverview = null;
          this.accountSyncOverviewPromise = null;
          this.accountSyncOverviewLoaded = false;
          return;
        }
        if (this.accountSyncOverviewLoaded || this.accountSyncOverviewPromise) {
          return;
        }
        this.accountSyncOverviewPromise = fetchAccountSyncOverview2().then((overview) => {
          this.accountSyncOverview = overview;
        }).catch((error) => {
          console.warn("Account sync overview failed", error);
        }).finally(() => {
          this.accountSyncOverviewLoaded = true;
          this.accountSyncOverviewPromise = null;
          if (this.container && this.activeSection === "account") {
            void this.render();
          }
        });
      },
      renderNav() {
        return this.visibleSections.map(
          (item, index) => `
          <button class="settings-nav-item focusable${this.activeSection === item.id ? " selected" : ""}"
                  data-zone="nav" role="tab" aria-selected="${this.activeSection === item.id ? "true" : "false"}"
                  data-nav-index="${index}"
                  data-focus-key="nav:${item.id}"
                  data-section="${item.id}">
            <span class="settings-nav-leading">
              ${renderSectionNavIcon2(item.id)}
              <span class="settings-nav-label-wrap">
                <span class="settings-nav-label">${escapeHtml31(translateSectionCopy2(item).label)}</span>
              </span>
            </span>
            ${iconSvg2(ROW_ICONS2.chevron, "settings-nav-chevron")}
          </button>
        `
        ).join("");
      },
      renderSectionHeader(section) {
        const copy = translateSectionCopy2(section);
        return `
          <header class="settings-content-header">
            <h1 class="settings-title">${escapeHtml31(copy.label)}</h1>
            <p class="settings-subtitle">${escapeHtml31(copy.subtitle)}</p>
          </header>
        `;
      }
    };
  }

  // js/ui/screens/settings/settingsScreenMethods-02-render-action-row.js
  function createSettingsScreenMethods02() {
    const {
      ThemeColors: ThemeColors2,
