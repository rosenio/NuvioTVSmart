      return {
        homeLayout: false,
        homeContent: false,
        continueWatching: false,
        detailPage: false,
        focusedPoster: false,
        cardAppearance: false
      };
    }
    if (sectionId === "playback") {
      return {
        general: false,
        stream: false,
        audio: false,
        subtitles: false,
        p2p: false
      };
    }
    return {};
  }
  function normalizeExpandedState(sectionId, value) {
