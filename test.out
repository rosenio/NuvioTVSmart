        const playerEpisodes = itemType === "series" || itemType === "tv" ? Array.isArray(this.params?.episodes) ? this.params.episodes : null : [];
        const startFromBeginning = Boolean(this.params?.startFromBeginning);
        const routeResumeProgress = {
