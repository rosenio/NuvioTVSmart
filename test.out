                   data-company-name="${escapeHtml31(company.name || "")}"
                   aria-label="${escapeHtml31(company.name || title || "Company")}">
            ${company.logo ? `<img src="${company.logo}" alt="${escapeHtml31(company.name || "Company")}" loading="lazy" decoding="async" />` : `<span>${escapeHtml31(company.name || "")}</span>`}
          </article>
        `
        ).join("");
        return `
          <section class="detail-company-section">
            <h3 class="detail-company-title">${escapeHtml31(title)}</h3>
            <div class="detail-company-track" data-scroll-key="company:${escapeHtml31(String(title || "").toLowerCase())}">${logos}</div>
          </section>
        `;
      },
      async refreshPreviewWatchedBadges() {
        const token = this.detailLoadToken;
        const request2 = (this.previewWatchedRequest || 0) + 1;
        this.previewWatchedRequest = request2;
        const container = this.container;
        const cards = Array.from(container?.querySelectorAll(".detail-morelike-card") || []);
        if (!cards.length) return;
        const items = cards.map((card) => posterItemFromNode(card, this.params?.itemType || "movie"));
        const baseWatchedItems = await watchedItemsRepository.getAll(2e3).catch(() => []);
        if (token !== this.detailLoadToken || request2 !== this.previewWatchedRequest || container !== this.container) return;
        const watchedItems = await watchedTitleStateRepository.getTitleWatchedItems(items, { baseWatchedItems, limit: 2e3 }).catch(() => baseWatchedItems);
        if (token !== this.detailLoadToken || request2 !== this.previewWatchedRequest || container !== this.container) return;
        const watchedTitleIds = buildWatchedTitleIdSet(watchedItems);
        cards.forEach((card, index) => {
          if (!container.contains(card)) return;
          const wrap = card.querySelector(".detail-morelike-poster-wrap");
          if (!wrap || !items[index]) return;
          const badge = wrap.querySelector(".title-watched-badge");
          if (isTitleItemWatched(items[index], watchedTitleIds)) {
            if (!badge) wrap.insertAdjacentHTML("beforeend", renderTitleWatchedBadge());
          } else if (badge) {
            wrap.removeChild(badge);
          }
        });
      },
      bindDetailChrome() {
        this.container?.querySelector(".series-detail-shell")?.style.setProperty(
          "--detail-episode-radius",
          `${Math.max(0, Number(LayoutPreferences2.get().posterCardCornerRadiusDp ?? 12)) * 2}px`
        );
        const logo = this.container?.querySelector(".series-detail-logo");
        if (logo) {
          logo.onerror = () => {
            const title = document.createElement("h1");
            title.className = "series-detail-title";
            title.textContent = logo.alt;
            logo.replaceWith(title);
          };
          if (logo.complete && !logo.naturalWidth) logo.onerror();
        }
        void this.refreshPreviewWatchedBadges();
        this.observeEpisodeThumbnails();
        const description = this.container?.querySelector(".series-detail-description");
        const preview = description?.querySelector(".detail-synopsis-preview");
        if (preview) {
          const truncated = preview.scrollHeight > preview.clientHeight + 1;
          description.classList.toggle("focusable", truncated);
          if (truncated) description.setAttribute("role", "button");
          else description.removeAttribute("role");
          description.tabIndex = -1;
          description.querySelector(".detail-synopsis-more").hidden = !truncated;
          this._detailFocusListCache = null;
        }
        const content = this.container?.querySelector(".series-detail-content");
        if (!content) {
          return;
        }
        if (this.detailScrollHandler) {
          content.removeEventListener("scroll", this.detailScrollHandler);
        }
        this.detailScrollHandler = () => {
          const shell = this.container?.querySelector(".series-detail-shell");
          if (!shell) {
            return;
          }
          if (this.isTrailerPlaying && this.trailerPlaybackMode === "autoplay") {
            this.stopTrailerPlayback({ restartAutoplay: false });
          }
          shell.classList.toggle("detail-scrolled", content.scrollTop > 160);
        };
        content.addEventListener("scroll", this.detailScrollHandler, { passive: true });
        if (this.episodeTrackScrollNode && this.episodeTrackScrollHandler) {
          this.episodeTrackScrollNode.removeEventListener("scroll", this.episodeTrackScrollHandler);
        }
        this.episodeTrackScrollNode = null;
        this.episodeTrackScrollHandler = null;
        if (this.detailFocusHandler) {
          this.container.removeEventListener("focusin", this.detailFocusHandler, true);
        }
        this.detailFocusHandler = (event) => {
          const target = event?.target;
          if (!(target instanceof HTMLElement) || !this.container?.contains(target)) {
            return;
          }
          if (!this.isTrailerPlaying) {
            if (target.matches('.series-detail-actions [data-action="playDefault"]')) {
              this.restartTrailerAutoplayTimer();
            } else if (this.trailerAutoplayTimer) {
              clearTimeout(this.trailerAutoplayTimer);
              this.trailerAutoplayTimer = null;
            }
          }
          if (target.matches(".series-season-btn.focusable")) {
            const season = Number(target.dataset.season || 0);
            if (season >= 0 && season !== this.selectedSeason) {
              let deferSeason = false;
              try {
                deferSeason = typeof this.isPerformanceConstrained === "function" && this.isPerformanceConstrained() || globalThis?.document?.body?.classList?.contains("legacy-tizen") || globalThis?.document?.documentElement?.classList?.contains("legacy-tizen");
              } catch (_) {
              }
              if (deferSeason) {
                if (this.seasonSwitchTimer) {
                  clearTimeout(this.seasonSwitchTimer);
                }
                const pendingSeason = season;
                this.seasonSwitchTimer = setTimeout(() => {
                  this.seasonSwitchTimer = null;
                  if (Router2.getCurrent?.() !== "detail") {
                    return;
                  }
                  const live = this.container?.querySelector(".series-season-btn.focusable.focused") || null;
                  if (Number(live?.dataset?.season ?? -1) === pendingSeason && pendingSeason !== this.selectedSeason) {
                    this.selectSeason(pendingSeason);
                  }
                }, 250);
                return;
              }
              this.selectSeason(season);
            }
            return;
          }
          if (target.matches(".series-insight-tab.focusable")) {
            const tab = String(target.dataset.tab || "");
            if (!tab) {
              return;
            }
            if (isSeriesDetailMeta2(this.meta, this.episodes) && tab !== this.seriesInsightTab) {
              this.seriesInsightTab = ["cast", "ratings", "morelike", "trailer", "collection"].includes(tab) ? tab : "cast";
              this.updateRenderedDetailSections(this.meta);
              return;
            }
            if (!isSeriesDetailMeta2(this.meta, this.episodes) && tab !== this.movieInsightTab) {
              this.movieInsightTab = ["cast", "morelike", "trailer", "collection"].includes(tab) ? tab : "cast";
              this.updateRenderedDetailSections(this.meta);
            }
            return;
          }
          if (target.matches(".series-rating-season.focusable")) {
            const season = Number(target.dataset.season || 0);
            if (season > 0 && season !== this.selectedRatingSeason) {
              this.selectedRatingSeason = season;
              this.render(this.meta, { selector: `.series-rating-season[data-season="${season}"]` });
            }
          }
        };
        this.container.addEventListener("focusin", this.detailFocusHandler, true);
        if (this.detailClickHandler) {
          this.container.removeEventListener("click", this.detailClickHandler, true);
        }
        this.detailClickHandler = () => {
          if (this.isTrailerPlaying && this.trailerPlaybackMode === "autoplay") {
            this.stopTrailerPlayback({ restartAutoplay: false });
            return;
          }
        };
        this.container.addEventListener("click", this.detailClickHandler, true);
        this.detailScrollHandler();
        this.restoreChromeState();
        this.syncTrailerDom();
        this.restartTrailerAutoplayTimer();
        this.restorePendingFocus();
        this.syncEpisodeTitleMarquee();
      },
      restoreChromeState() {
        const content = this.container?.querySelector(".series-detail-content");
        if (content) {
          content.scrollTop = Number(this.restoredContentScrollTop || 0);
        }
        Array.from(this.container?.querySelectorAll("[data-scroll-key]") || []).forEach((node) => {
          const key3 = String(node.dataset.scrollKey || "");
          if (!key3) {
            return;
          }
          node.scrollLeft = Number(this.restoredTrackScrollLeftByKey?.[key3] || 0);
        });
      },
      syncDetailActionButtons() {
        if (!this.container) {
          return;
        }
        Array.from(this.container.querySelectorAll('[data-action="toggleLibrary"]')).forEach((node) => {
          if (!(node instanceof HTMLElement)) {
            return;
          }
          if (node.classList.contains("series-circle-btn")) {
            node.classList.toggle("is-library-selected", this.isSavedInLibrary);
            node.innerHTML = renderLibraryGlyph2(this.isSavedInLibrary);
            node.setAttribute(
              "aria-label",
              this.isSavedInLibrary ? t31("detail.removeFromLibrary", {}, "Remove from Library") : t31("detail.addToLibrary", {}, "Add to Library")
            );
          } else {
            node.textContent = this.isSavedInLibrary ? t31("detail.removeFromLibrary", {}, "Remove from Library") : t31("detail.addToLibrary", {}, "Add to Library");
          }
        });
        Array.from(this.container.querySelectorAll('[data-action="toggleWatched"]')).forEach((node) => {
          if (!(node instanceof HTMLElement)) {
            return;
          }
          if (node.classList.contains("series-circle-btn")) {
            node.classList.toggle("is-selected", this.isMarkedWatched);
            node.innerHTML = renderWatchedGlyph2(this.isMarkedWatched);
            node.setAttribute(
              "aria-label",
              this.isMarkedWatched ? t31("common.markUnwatched", {}, "Mark Unwatched") : t31("common.markWatched", {}, "Mark Watched")
            );
          } else {
            node.textContent = this.isMarkedWatched ? t31("common.markUnwatched", {}, "Mark Unwatched") : t31("common.markWatched", {}, "Mark Watched");
          }
        });
        Router2.captureCurrentRouteState();
      }
    };
  }

  // js/ui/screens/detail/metaDetailsScreenMethods-17-capture-detail-focus.js
  function createMetaDetailsScreenMethods17() {
    const {
      PlayerSettingsStore: PlayerSettingsStore2,
      getTvRuntimePerformanceProfile: getTvRuntimePerformanceProfile2,
      DETAIL_SCROLL_STIFFNESS: DETAIL_SCROLL_STIFFNESS2,
      DETAIL_SCROLL_DAMPING_RATIO: DETAIL_SCROLL_DAMPING_RATIO2,
      DETAIL_SCROLL_MAX_FRAME_SECONDS: DETAIL_SCROLL_MAX_FRAME_SECONDS2,
      escapeSelectorValue: escapeSelectorValue3
    } = metaDetailsScreenContext_exports;
    return {
      captureDetailFocus() {
        if (this.episodeHoldMenu) {
          return this.getEpisodeFocusDescriptor(this.episodeHoldMenu?.videoId);
        }
        if (this.seasonHoldMenu) {
          const season = Number(this.seasonHoldMenu.season ?? this.selectedSeason ?? 1);
          return { selector: `.series-season-btn[data-season="${season}"]` };
        }
        if (this.posterOptionsController?.dialog) {
          return this.posterOptionsFocusRestore || null;
        }
        if (this.libraryListMenu) {
          return { selector: ".series-detail-actions [data-action='toggleLibrary']" };
        }
        if (this.heroPlayMenu) {
          return { selector: ".series-detail-actions [data-action='playDefault']" };
        }
        if (!this.container) {
          return null;
        }
        const active3 = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        const activeTarget = active3 && this.container.contains(active3) && active3.classList.contains("focusable") ? active3 : null;
        const current2 = this.container.querySelector(".focusable.focused");
        const target = activeTarget || current2 || (active3 && this.container.contains(active3) ? active3 : null);
        if (!(target instanceof HTMLElement) || !target.closest(".series-detail-content")) {
          return null;
        }
        const action = String(target.dataset.action || "");
        if (action === "selectSeason") {
          const season = Number(target.dataset.season || 0);
          return season >= 0 ? { selector: `.series-season-btn[data-season="${season}"]` } : null;
        }
        if (action === "setSeriesInsightTab" || action === "setMovieInsightTab") {
          const tab = String(target.dataset.tab || "");
          return tab ? { selector: `.series-insight-tab[data-tab="${tab}"]` } : null;
        }
        if (action === "setCommentsMode") {
          const mode = String(target.dataset.commentsMode || "title") === "episode" ? "episode" : "title";
          return {
            selector: `.detail-comments-mode[data-comments-mode="${mode}"]`,
            preserveVerticalScroll: true
