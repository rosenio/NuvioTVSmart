  // js/ui/screens/settings/settingsScreenMethods-07-render-plugins-section.js
  function createSettingsScreenMethods07() {
    const { Router: Router2, ExperienceModeStore: ExperienceModeStore2, PluginManager: PluginManager2, SECTION_META: SECTION_META2, t: t31, arePluginsSupported: arePluginsSupported2, escapeHtml: escapeHtml31 } = settingsScreenContext_exports;
    return {
      renderPluginsSection(model = {}) {
        if (!arePluginsSupported2()) {
          return "";
        }
        const summary = model.pluginSummary || PluginManager2.getSummary();
        const runtime = summary.runtime || {};
        this.actionMap.set("plugins:open", async () => {
          await Router2.navigate("plugins");
        });
        return `
          ${this.renderSectionHeader(SECTION_META2.find((item) => item.id === "plugins"))}
          <div class="settings-group-card">
            <div class="settings-stack">
              ${this.renderActionRow({
          focusKey: "plugins:open",
          title: t31("plugin_title", {}, "Plugins"),
          subtitle: t31("settings.plugins.openSubtitle", {}, "Manage executable Nuvio JS providers and preserved external metadata"),
          value: `${Number(summary.repositories?.length || 0)} \xB7 ${Number(summary.scrapers?.length || 0)}`,
          icon: "chevron"
        })}
              <div class="settings-subsection-card">
                <div class="settings-group-heading">
                  <div>
                    <div class="settings-group-title">${escapeHtml31(t31("plugin_runtime_heading", {}, "TV plugin runtime"))}</div>
                    <div class="settings-group-subtitle">${escapeHtml31(runtime.executable ? t31("plugin_runtime_ready", {}, "Runtime ready") : runtime.reason || t31("plugin_runtime_unsupported", {}, "Execution unavailable on this TV runtime"))}</div>
                  </div>
                  <span class="settings-row-value">${escapeHtml31(t31("plugin_providers_count", { count: Number(summary.scrapers?.length || 0) }, `${Number(summary.scrapers?.length || 0)} providers`))}</span>
                </div>
              </div>
              <p class="settings-row-subtitle">${escapeHtml31(t31("plugin_runtime_tv_only", {}, "Only Nuvio JS repositories execute. CloudStream DEX and legacy URL-template sources are retained for display but never executed or converted."))}</p>
            </div>
          </div>
        `;
      },
      renderContentDiscoverySection() {
        if (this.mediaServersView) return renderMediaServersSection.call(this);
        this.actionMap.set("contentDiscovery:servers", () => {
          this.mediaServersView = "list";
          this.contentFocusKey = "mediaServers:back";
        });
        this.actionMap.set("contentDiscovery:addons", async () => {
          await Router2.navigate("plugin");
        });
        if (arePluginsSupported2()) {
          this.actionMap.set("contentDiscovery:plugins", async () => {
            await Router2.navigate("plugins");
          });
        }
        return `
          ${this.renderSectionHeader(SECTION_META2.find((item) => item.id === "contentDiscovery"))}
          <div class="settings-group-card">
            <div class="settings-stack">
              ${this.renderActionRow({ focusKey: "contentDiscovery:servers", title: t31("settings_media_servers"), subtitle: t31("settings_media_servers_subtitle"), leadingIcon: "dns" })}
              ${this.renderActionRow({
          focusKey: "contentDiscovery:addons",
          title: t31("addon_title", {}, "Addons"),
          subtitle: t31("settings.contentDiscovery.addonsSubtitle", {}, "Manage add-ons, catalog order, and collections"),
          leadingIcon: "grid_view"
        })}
              ${ExperienceModeStore2.isEssential() || !arePluginsSupported2() ? "" : this.renderActionRow({
          focusKey: "contentDiscovery:plugins",
          title: t31("plugin_title", {}, "Plugins"),
          subtitle: t31("settings.contentDiscovery.pluginsSubtitle", {}, "Manage repositories and stream providers"),
          leadingIcon: "build"
        })}
            </div>
          </div>
        `;
      },
      renderIntegrationHub() {
        this.actionMap.set("integration:hub:debrid", () => {
          this.integrationView = "debrid";
          this.contentFocusKey = "integration:back";
        });
        this.actionMap.set("integration:hub:tmdb", () => {
          this.integrationView = "tmdb";
          this.contentFocusKey = "integration:back";
        });
        this.actionMap.set("integration:hub:mdblist", () => {
          this.integrationView = "mdblist";
          this.contentFocusKey = "integration:back";
        });
        this.actionMap.set("integration:hub:animeskip", () => {
          this.integrationView = "animeskip";
          this.contentFocusKey = "integration:back";
        });
        return `
            ${this.renderSectionHeader(SECTION_META2.find((item) => item.id === "integration"))}
            <div class="settings-group-card settings-group-card-fill">
              <div class="settings-stack">
                ${this.renderActionRow({
          focusKey: "integration:hub:debrid",
          title: t31("settings.integration.debrid.label", {}, "Debrid"),
          subtitle: t31("settings.integration.debrid.subtitle", {}, "Connect accounts for links and library access")
        })}
                ${this.renderActionRow({
          focusKey: "integration:hub:tmdb",
          title: t31("settings.integration.tmdb.label"),
          subtitle: t31("settings.integration.tmdb.subtitle")
        })}
                ${this.renderActionRow({
          focusKey: "integration:hub:mdblist",
