      },
      setPinActionMessage(message) {
        if (this.pinActionMessageTimer) {
          clearTimeout(this.pinActionMessageTimer);
          this.pinActionMessageTimer = null;
        }
        this.pinActionMessage = String(message || "");
        if (!this.pinActionMessage) {
          this.render();
          return;
        }
        this.render();
        this.pinActionMessageTimer = setTimeout(() => {
          this.pinActionMessageTimer = null;
          this.pinActionMessage = "";
          this.render();
        }, 2600);
      },
      triggerPinShake() {
        const row = this.container?.querySelector("[data-role='pin-box-row']");
        if (!row) {
          return;
        }
        row.classList.remove("is-shaking");
        void row.offsetWidth;
        row.classList.add("is-shaking");
      }
    };
  }

  // js/core/profile/profileSelectionScreenMethods-06-submit-completed-pin.js
  function createProfileSelectionScreenMethods06() {
    const {
      ProfileManager: ProfileManager2,
      ProfileSyncService: ProfileSyncService2,
      ScreenUtils: ScreenUtils2,
      NuvioDialog: NuvioDialog2,
      PluginStore: PluginStore2,
      PluginCodeStore: PluginCodeStore2,
      PROFILE_PIN_LENGTH: PROFILE_PIN_LENGTH2,
      PROFILE_PIN_TEXT: PROFILE_PIN_TEXT2,
      t: t31,
      keyEventToDigit: keyEventToDigit2,
      getDefaultProfileColor: getDefaultProfileColor2
    } = profileSelectionScreen_exports;
    return {
      async submitCompletedPin(pin) {
        const state3 = this.pinOverlayState;
        const profile2 = this.getPinOverlayProfile();
        if (!state3 || !profile2 || this.isPinOperationInProgress) {
          return;
        }
        this.isPinOperationInProgress = true;
        this.render();
        if (state3.type === "set") {
          const success2 = await ProfileSyncService2.setProfilePin(profile2.id, pin, state3.currentPin);
          this.isPinOperationInProgress = false;
          if (success2) {
            this.profilePinEnabled = {
              ...this.profilePinEnabled,
              [String(profile2.id)]: true
            };
            this.pinOverlayError = "";
            this.setPinActionMessage(PROFILE_PIN_TEXT2.saved(profile2.name));
            this.closePinOverlay({ focusKey: `profile:${profile2.id}` });
            return;
          }
          this.pinOverlayError = PROFILE_PIN_TEXT2.saveFailed;
          this.pinValue = "";
          this.render();
          this.triggerPinShake();
          return;
        }
        if (state3.type === "verify-remove") {
          const success2 = await ProfileSyncService2.clearProfilePin(profile2.id, pin);
          this.isPinOperationInProgress = false;
          if (success2) {
            this.profilePinEnabled = {
              ...this.profilePinEnabled,
              [String(profile2.id)]: false
            };
            this.pinOverlayError = "";
            this.setPinActionMessage(PROFILE_PIN_TEXT2.removed(profile2.name));
            this.closePinOverlay({ focusKey: `profile:${profile2.id}` });
            return;
          }
          this.pinOverlayError = PROFILE_PIN_TEXT2.incorrectCurrent;
          this.pinValue = "";
          this.render();
          this.triggerPinShake();
          return;
        }
        const verification = await ProfileSyncService2.verifyProfilePin(profile2.id, pin);
        this.isPinOperationInProgress = false;
        if (!verification) {
          this.pinOverlayError = PROFILE_PIN_TEXT2.verifyFailed;
          this.pinValue = "";
          this.render();
          this.triggerPinShake();
          return;
        }
        if (verification.unlocked) {
          if (state3.type === "unlock") {
            this.pinOverlayError = "";
            this.isPinOperationInProgress = true;
            this.render();
            try {
              await this.activateProfile(profile2.id);
            } finally {
              this.isPinOperationInProgress = false;
            }
            return;
          }
          if (state3.type === "verify-change") {
            this.openPinOverlay("set", profile2, pin);
            return;
          }
        }
        this.pinOverlayError = verification.retryAfterSeconds > 0 ? PROFILE_PIN_TEXT2.lockedRetry(verification.retryAfterSeconds) : state3.type === "unlock" ? PROFILE_PIN_TEXT2.invalidPin : PROFILE_PIN_TEXT2.incorrectCurrent;
        this.pinValue = "";
        this.render();
        this.triggerPinShake();
      },
      async handleCompletedPinEntry() {
        if (this.pinValue.length !== PROFILE_PIN_LENGTH2 || this.isPinOperationInProgress || !this.pinOverlayState) {
          return;
        }
        if (this.pinOverlayState.type !== "set") {
          await this.submitCompletedPin(this.pinValue);
          return;
        }
        if (this.pinEntryStage === "create") {
          this.pinDraftValue = this.pinValue;
          this.pinValue = "";
          this.pinOverlayError = "";
          this.pinEntryStage = "confirm";
          this.render();
          return;
        }
        if (this.pinDraftValue === this.pinValue) {
          await this.submitCompletedPin(this.pinValue);
          return;
        }
        this.pinValue = "";
        this.pinDraftValue = "";
        this.pinEntryStage = "create";
        this.pinOverlayError = PROFILE_PIN_TEXT2.mismatch;
        this.render();
        this.triggerPinShake();
      },
      async activatePinKey(value) {
        if (this.isPinOperationInProgress) {
          return;
        }
        if (value === "delete") {
          if (this.pinValue) {
            this.pinValue = this.pinValue.slice(0, -1);
            this.pinOverlayError = "";
            this.pendingFocusKey = "pin:delete";
            this.render();
          }
          return;
        }
        const digit = String(value || "");
        if (!/^\d$/.test(digit) || this.pinValue.length >= PROFILE_PIN_LENGTH2) {
          return;
        }
        this.pinValue += digit;
        this.pinOverlayError = "";
        this.pendingFocusKey = `pin:${digit}`;
        this.render();
        await this.handleCompletedPinEntry();
      },
      async handlePinOverlayKeyDown(event) {
        const code = Number(event?.keyCode || 0);
        const key3 = String(event?.key || "");
        if (code === 8 || code === 46 || key3 === "Backspace" || key3 === "Delete") {
          event?.preventDefault?.();
          if (!this.isPinOperationInProgress && this.pinValue) {
            this.pinValue = this.pinValue.slice(0, -1);
            this.pinOverlayError = "";
            this.render();
          }
          return true;
        }
        if (code === 27 || code === 461 || code === 10009 || key3 === "Escape") {
          event?.preventDefault?.();
          this.closePinOverlay();
          return true;
        }
        if ([37, 38, 39, 40].includes(code)) {
          const overlayRoot = this.container?.querySelector("[data-overlay-root='pin']");
          if (overlayRoot) {
            ScreenUtils2.handleDpadNavigation(event, overlayRoot, ".profile-pin-key");
          }
          return true;
        }
        if (code === 13) {
          event?.preventDefault?.();
          const focused = this.container?.querySelector(".profile-pin-key.focused") || (document.activeElement?.matches?.(".profile-pin-key") ? document.activeElement : null);
          if (focused) {
            await this.activatePinKey(focused.dataset.pinKey);
          }
          return true;
        }
        const digit = keyEventToDigit2(event);
        if (!digit || this.isPinOperationInProgress || this.pinValue.length >= PROFILE_PIN_LENGTH2) {
          return false;
        }
        event?.preventDefault?.();
        this.pinValue += digit;
        this.pinOverlayError = "";
        this.render();
        await this.handleCompletedPinEntry();
        return true;
      },
      openDeleteDialog(profile2) {
        if (!profile2 || profile2.isPrimary) {
          return;
        }
        this._destroyDialogs();
        this.deleteProfileId = String(profile2.id);
        this._deleteDialog = new NuvioDialog2({
          title: t31("profile_delete_confirm_title", {}, "Delete Profile?"),
          subtitle: t31(
            "profile_delete_confirm_subtitle",
            {},
            "This will permanently delete this profile and all its data including library, watch history, and addon settings. This cannot be undone."
          ),
          widthVw: 43.75,
          // 420dp / 960dp screen = 43.75vw
          buttons: [
            {
              label: t31("profile_delete_btn", {}, "Delete Profile"),
              key: "confirm",
              danger: true,
              onAction: () => {
                const id = this.deleteProfileId;
                this._deleteDialog = null;
                this.deleteProfileId = null;
                this.deleteProfile(id);
              }
            }
          ],
          onDismiss: () => {
            this._deleteDialog = null;
            this.closeDeleteDialog();
          }
        }).mount(document.body);
      },
      closeDeleteDialog() {
        const profileId2 = this.deleteProfileId;
        this.deleteProfileId = null;
        if (this._deleteDialog) {
          this._deleteDialog.destroy();
          this._deleteDialog = null;
        }
        this.pendingFocusKey = profileId2 ? `profile:${profileId2}` : this.lastProfileFocusKey || "profile:1";
        this.restoreFocus();
      },
      async submitEditor() {
        if (!this.editorState || this.isEditorSubmitDisabled()) {
          return;
        }
        const editorState = { ...this.editorState };
        const trimmedName = String(editorState.name || "").trim();
        const focusProfileId = editorState.mode === "edit" ? editorState.profileId : String(ProfileManager2.getNextProfileIndex(this.getVisibleProfiles()) || "");
        this.editorState = null;
        this.pendingFocusKey = `profile:${focusProfileId}`;
        this.render();
        let success2 = false;
        if (editorState.mode === "edit") {
          const existing = this.getProfileById(editorState.profileId);
          if (!existing) {
            await this.reloadProfiles();
            return;
          }
          success2 = await ProfileManager2.updateProfile({
            ...existing,
            name: trimmedName,
            avatarColorHex: editorState.selectedColorHex || getDefaultProfileColor2(),
            avatarId: editorState.selectedAvatarId || null,
            avatarUrl: editorState.selectedAvatarId !== editorState.baseAvatarId ? null : String(existing.avatarUrl || "").trim() || null,
            profileBackgroundId: editorState.selectedBackgroundId || null,
            profileBackgroundUrl: String(editorState.selectedBackgroundUrl || "").trim() || null
          });
        } else {
          success2 = await ProfileManager2.createProfile({
            name: trimmedName,
            avatarColorHex: editorState.selectedColorHex || getDefaultProfileColor2(),
            avatarId: editorState.selectedAvatarId || null,
            avatarUrl: null,
            profileBackgroundId: editorState.selectedBackgroundId || null,
            profileBackgroundUrl: String(editorState.selectedBackgroundUrl || "").trim() || null
          });
        }
        if (success2 !== false) {
          await ProfileSyncService2.push();
          await this.refreshProfilePinStates();
        }
        await this.reloadProfiles(`profile:${focusProfileId}`);
      },
      async deleteProfile(profileId2) {
        const profile2 = this.getProfileById(profileId2);
        if (!profile2 || profile2.isPrimary) {
          return;
        }
        this.deleteProfileId = null;
        this.render();
        const deleted = await ProfileManager2.deleteProfile(profile2.id);
        if (deleted !== false) {
          await ProfileSyncService2.deleteProfileData(profile2.id);
          await ProfileSyncService2.push();
          await this.refreshProfilePinStates();
        }
