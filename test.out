        text5.focus({ preventScroll: true });
      },
      renderCommentsSection() {
        if (this.commentsLoading) {
          const cards2 = Array.from({ length: 3 }).map(() => `<article class="detail-comment-card is-loading"><span></span><span></span><span></span></article>`).join("");
          return `<div class="detail-comments-track" data-scroll-key="comments:loading">${cards2}</div>`;
        }
