  var DEBRID_DEVICE_AUTH_STATUS = Object.freeze({
    AUTHORIZED: "authorized",
    PENDING: "pending",
    EXPIRED: "expired",
    FAILED: "failed",
    UNSUPPORTED: "unsupported"
  });
  function textValue(value) {
    return String(value || "").trim();
  }
  function positiveSeconds(value, fallback2 = 5) {
    const seconds = Number(value);
    return Number.isFinite(seconds) && seconds > 0 ? Math.max(1, Math.trunc(seconds)) : fallback2;
  }
  function failureMessage(response) {
    const data = response?.data;
    if (data && typeof data === "object") {
