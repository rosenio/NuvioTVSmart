      const behind = member.id === party.memberId ? selfBehindMs : memberBehindMs(party, member);
      const status = behind != null ? t5("party_behind", [formatPlaybackTime2(behind)]) : memberStatusText(party, member);
      const name = member.id === party.memberId ? `${member.display_name} (${t5("party_you")})` : member.display_name;
      const content = `
