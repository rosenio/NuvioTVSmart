          originalAvatarUrl: String(profile2.avatarUrl || "").trim() || null,
          name: String(profile2.name || ""),
          selectedColorHex: String(profile2.avatarColorHex || getDefaultProfileColor2()),
          selectedAvatarId: profile2.avatarId || null,
          baseAvatarId: profile2.avatarId || null,
          baseColorHex: String(profile2.avatarColorHex || getDefaultProfileColor2()),
          originalBackgroundUrl: String(profile2.profileBackgroundUrl || "").trim() || null,
          baseBackgroundId: profile2.profileBackgroundId || null,
          baseBackgroundUrl: String(profile2.profileBackgroundUrl || "").trim() || null,
          selectedBackgroundId: profile2.profileBackgroundId || null,
          selectedBackgroundUrl: String(profile2.profileBackgroundUrl || "").trim() || null,
          category: "all",
          editorTab: "avatar",
          focusedAvatarName: null
        };
        this.pendingFocusKey = "editor:name";
        this.render();
      },
      closeEditor() {
        this.editorState = null;
        this.pendingFocusKey = this.lastProfileFocusKey || "profile:1";
        this.render();
      },
      async openOptionsDialog(profile2) {
        const mountToken = this.mountToken;
        await this.initialProfileSync;
        if (!this.isMounted || this.mountToken !== mountToken) return;
        profile2 = this.getProfileById(profile2?.id);
        if (!profile2) {
          return;
        }
        this._destroyDialogs();
        this.optionsProfileId = String(profile2.id);
        const pinEnabled = this.isProfilePinEnabled(profile2.id);
        const buttons = [
          {
            label: t31("profile_edit_label", {}, "Edit"),
            key: "edit",
            onAction: () => {
              this._optionsDialog?.destroy();
              this._optionsDialog = null;
              this.openEditEditor(this.getProfileById(profile2.id));
            }
          },
          {
            label: pinEnabled ? PROFILE_PIN_TEXT2.change : PROFILE_PIN_TEXT2.set,
            key: "pin",
