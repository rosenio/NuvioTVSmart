            await MdbListLibrary.setVisible(option.id, visible);
          } catch (error2) {
            if (this.isMounted && mountToken === this.settingsMountToken)
              show(option.id, t16(error2?.code || "mdblist_unavailable", {}, t16("mdblist_unavailable")));
            return false;
          }
          snapshot3.hidden = visible ? snapshot3.hidden.filter((k) => k !== option.id) : [...snapshot3.hidden, option.id];
          if (!this.isMounted || mountToken !== this.settingsMountToken) return true;
          show(option.id);
