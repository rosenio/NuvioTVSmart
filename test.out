  // js/ui/screens/settings/settingsMdbListAccount.js
  function stopMdbListAuthorization() {
    this.mdbListAuthNonce = (this.mdbListAuthNonce || 0) + 1;
    clearTimeout(this.mdbListAuthTimer);
    this.mdbListAuthTimer = null;
  }
  function openMdbListAuthorization() {
    stopMdbListAuthorization.call(this);
    const nonce = this.mdbListAuthNonce;
    const profileId2 = String(ProfileManager.getActiveProfileId());
    const current2 = () => this.isMounted && this.mdbListAuthNonce === nonce && String(ProfileManager.getActiveProfileId()) === profileId2;
    let session2 = null;
    const show = (message, html = "") => {
      if (!current2()) return;
      this.openOptionDialog({
        title: "MDBList",
        message: html ? "" : message,
        messageHtml: html ? `<p class="settings-debrid-auth-copy">${escapeHtml16(message)}</p>${html}` : "",
        options: [{ id: "cancel", label: t16("common.cancel") }],
        returnFocusKey: "integration:mdblist:account",
        onClose: () => stopMdbListAuthorization.call(this),
        onSelect: () => true,
        onRender: (slot) => {
          const canvas = slot.querySelector("[data-mdblist-qr]");
          if (canvas && session2) {
            try {
              QrCodeGenerator.generate(canvas, session2.completeUrl, 420);
            } catch (_) {
              canvas.remove();
            }
          }
        }
      });
    };
    show(t16("common.loading"));
    void (async () => {
      try {
        session2 = await MdbListAccount.start();
        if (!current2()) return;
        show(
          t16("mdblist_awaiting_instruction"),
          `<div class="settings-debrid-auth-body"><canvas class="settings-debrid-auth-qr" data-mdblist-qr aria-label="${escapeAttribute5(t16("mdblist_qr_description"))}"></canvas><div class="settings-debrid-auth-code">${escapeHtml16(session2.userCode)}</div><div class="settings-debrid-auth-url">${escapeHtml16(session2.url)}</div></div>`
        );
        await this.render({ refreshModel: false });
        const poll2 = async () => {
          try {
            if (!current2()) return;
            const authorized = await MdbListAccount.poll(session2, current2);
            if (!current2()) return;
            if (authorized) {
              void MdbListTracking.refresh({ force: true }).then(() => {
                if (this.isMounted && String(ProfileManager.getActiveProfileId()) === profileId2)
                  void this.render();
              });
              this.closeOptionDialog();
              await this.render();
              return;
            }
            this.mdbListAuthTimer = setTimeout(() => void poll2(), session2.interval * 1e3);
          } catch (error) {
            if (!current2()) return;
            show(t16(error?.code || "mdblist_unavailable", {}, t16("mdblist_unavailable")));
            await this.render({ refreshModel: false });
          }
        };
        this.mdbListAuthTimer = setTimeout(() => void poll2(), session2.interval * 1e3);
      } catch (error) {
        if (!current2()) return;
        show(t16(error?.code || "mdblist_unavailable", {}, t16("mdblist_unavailable")));
        await this.render({ refreshModel: false });
      }
    })();
  }
  async function openMdbListVisibility() {
    const scope = MdbListAccount.scope();
    const mountToken = this.settingsMountToken;
    const snapshot3 = await MdbListLibrary.snapshot();
    MdbListAccount.check(scope);
    if (!this.isMounted || mountToken !== this.settingsMountToken) return;
    const show = (selectedId = null, error = null) => {
      this.openOptionDialog({
        title: t16("mdblist_library_lists"),
        message: error || (snapshot3.tabs.length <= 1 ? t16("mdblist_library_lists_empty") : t16("mdblist_library_lists_description")),
        selectedId,
        options: snapshot3.tabs.filter((tab) => tab.key !== "mdblist:watchlist").map((tab) => ({
          id: tab.key,
          label: `${snapshot3.hidden.includes(tab.key) ? "\u2610" : "\u2611"} ${tab.title}`
        })),
        returnFocusKey: "integration:mdblist:lists",
        onSelect: async (option) => {
          MdbListAccount.check(scope);
          const visible = snapshot3.hidden.includes(option.id);
