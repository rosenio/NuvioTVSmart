    }
    const normalized = { ...defaults };
    Object.keys(defaults).forEach((key3) => {
      normalized[key3] = Boolean(value[key3]);
    });
    return normalized;
  }
  function normalizeExpandedSections(value) {
    const source = value && typeof value === "object" ? value : {};
