    } = state3;
    return `
        ${this.renderSectionHeader({ labelKey: "settings.integration.debrid.label", subtitleKey: "settings.integration.debrid.subtitle" })}
        <div class="settings-group-card settings-group-card-fill">
          <div class="settings-stack">
            ${this.renderActionRow({
      focusKey: "integration:back",
      title: t31("settings.integration.backToIntegrations.title"),
      subtitle: t31("settings.integration.backToIntegrations.subtitle"),
      icon: "back"
    })}
            <div class="settings-group-heading">
              <div class="settings-group-title">${escapeHtml31(t31("debrid_experimental_notice", {}, "Experimental Direct Debrid integration"))}</div>
            </div>
            ${this.renderToggleRow({
      focusKey: "integration:debrid:cloud",
      title: t31("settings.integration.debrid.cloud.title", {}, "Cloud library"),
      subtitle: t31("settings.integration.debrid.cloud.subtitle", {}, "Browse and play files already in your connected accounts."),
      checked: canUseCloudLibrary,
      disabled: !hasCloudLibraryProvider
    })}
            ${this.renderToggleRow({
      focusKey: "integration:debrid:enabled",
      title: t31("settings.integration.debrid.enable.title", {}, "Resolve playable links"),
      subtitle: t31(
        "settings.integration.debrid.enable.subtitle",
        {},
        "Ask a connected service for playable links when a result needs it. This may add the item to that service."
      ),
      checked: canResolvePlayableLinks,
      disabled: !hasResolverProvider
    })}
            ${canResolvePlayableLinks && resolverProviders.length > 1 && activeResolverProvider ? this.renderActionRow({
      focusKey: "integration:debrid:provider",
      title: t31("settings.integration.debrid.resolveWith.title", {}, "Resolve with"),
      subtitle: t31(
        "settings.integration.debrid.resolveWith.subtitle",
        {},
        "Choose which connected account handles playable links."
      ),
      value: preferredProviderId ? labelForDebridProvider2(preferredProviderId) : activeResolverProvider.displayName
    }) : ""}
            ${!hasResolverProvider ? `<div class="settings-group-heading"><div class="settings-group-subtitle">${escapeHtml31(t31("settings.integration.debrid.addKeyFirst", {}, "Connect an account first."))}</div></div>` : ""}
            <div class="settings-group-heading">
              <div class="settings-group-title">${escapeHtml31(t31("debrid_section_account", {}, "Account"))}</div>
            </div>
            ${providers3.map(
      (provider) => this.renderActionRow({
        focusKey: `integration:debrid:key:${provider.id}`,
        title: provider.displayName,
        subtitle: provider.authMethod === DEBRID_AUTH_METHODS2.DEVICE_CODE ? t31(
          "debrid_provider_device_description",
          { provider: provider.displayName },
          `Link your ${provider.displayName} account in the browser.`
        ) : t31(
          "settings.integration.debrid.providerDescription",
          { provider: provider.displayName },
          `Connect your ${provider.displayName} account.`
        ),
        value: maskValue2(
          provider.authMethod === DEBRID_AUTH_METHODS2.DEVICE_CODE ? "" : DebridProviders2.apiKeyFor(model.debrid, provider.id),
          DebridProviders2.apiKeyFor(model.debrid, provider.id) ? t31("debrid_connected", {}, "Connected") : t31("settings.integration.debrid.notSet", {}, "Not set")
        ),
        icon: "chevron"
      })
    ).join("")}
            ${canResolvePlayableLinks ? `
                  <div class="settings-group-heading">
                    <div class="settings-group-title">${escapeHtml31(t31("debrid_section_instant_playback", {}, "Instant Playback"))}</div>
                  </div>
                  ${this.renderToggleRow({
      focusKey: "integration:debrid:prepareToggle",
      title: t31("settings.integration.debrid.prepare.title", {}, "Prepare links"),
      subtitle: t31("settings.integration.debrid.prepare.subtitle", {}, "Resolve playable links before playback starts."),
      checked: Number(model.debrid.instantPlaybackPreparationLimit || 0) > 0
    })}
                  ${Number(model.debrid.instantPlaybackPreparationLimit || 0) > 0 ? this.renderActionRow({
      focusKey: "integration:debrid:prepareCount",
      title: t31("settings.integration.debrid.prepare.count.title", {}, "Links to prepare"),
      value: labelForOption2(DEBRID_PREPARE_COUNT_OPTIONS2, model.debrid.instantPlaybackPreparationLimit, "2 links")
    }) : ""}
                ` : ""}
            <div class="settings-group-heading">
              <div class="settings-group-title">${escapeHtml31(t31("debrid_section_formatting", {}, "Formatting"))}</div>
            </div>
            ${this.renderActionRow({
      focusKey: "integration:debrid:nameTemplate",
      title: t31("settings.integration.debrid.template.name.title", {}, "Stream name pattern"),
      subtitle: t31("settings.integration.debrid.template.name.subtitle", {}, "Pattern used to generate Direct Debrid source names."),
      value: t31("common.edit", {}, "Edit"),
      disabled: !model.debrid.enabled
    })}
            ${this.renderActionRow({
      focusKey: "integration:debrid:descriptionTemplate",
      title: t31("settings.integration.debrid.template.description.title", {}, "Stream description pattern"),
      subtitle: t31(
        "settings.integration.debrid.template.description.subtitle",
        {},
        "Pattern used to generate Direct Debrid source details."
      ),
      value: t31("common.edit", {}, "Edit"),
      disabled: !model.debrid.enabled
    })}
            ${this.renderActionRow({
      focusKey: "integration:debrid:resetTemplates",
      title: t31("settings.integration.debrid.template.reset.title", {}, "Reset formatting"),
      subtitle: t31("settings.integration.debrid.template.reset.subtitle", {}, "Restore default source formatting."),
      value: t31("settings.integration.debrid.template.reset.value", {}, "Reset"),
      disabled: !model.debrid.enabled
    })}
            ${canResolvePlayableLinks ? `
                  <div class="settings-group-heading">
                    <div class="settings-group-title">${escapeHtml31(t31("debrid_section_filters", {}, "Filters"))}</div>
                  </div>
                  ${this.renderActionRow({
      focusKey: "integration:debrid:maxResults",
      title: t31("settings.integration.debrid.maxResults.title", {}, "Max results"),
      subtitle: t31("settings.integration.debrid.maxResults.subtitle", {}, "Limit how many Direct Debrid sources appear."),
      value: labelForOption2(DEBRID_MAX_RESULTS_OPTIONS2, streamPreferences.maxResults, "All streams")
    })}
                  ${this.renderActionRow({
      focusKey: "integration:debrid:sort",
      title: t31("settings.integration.debrid.sort.title", {}, "Sort streams"),
      subtitle: t31("settings.integration.debrid.sort.subtitle", {}, "Choose how Direct Debrid sources are ordered."),
      value: debridSortProfileLabel2(streamPreferences.sortCriteria)
    })}
                  ${this.renderActionRow({
      focusKey: "integration:debrid:maxPerResolution",
      title: t31("debrid_stream_per_resolution_limit_title", {}, "Per resolution limit"),
      subtitle: t31(
        "debrid_stream_per_resolution_limit_subtitle",
        {},
        "Cap repeated 2160p, 1080p, 720p results after sorting."
      ),
      value: labelForOption2(DEBRID_MAX_RESULTS_OPTIONS2, streamPreferences.maxPerResolution, "All streams")
    })}
                  ${this.renderActionRow({
      focusKey: "integration:debrid:maxPerQuality",
      title: t31("debrid_stream_per_quality_limit_title", {}, "Per quality limit"),
      subtitle: t31(
        "debrid_stream_per_quality_limit_subtitle",
        {},
        "Cap repeated BluRay, WEB-DL, REMUX results after sorting."
      ),
      value: labelForOption2(DEBRID_MAX_RESULTS_OPTIONS2, streamPreferences.maxPerQuality, "All streams")
    })}
                  ${this.renderActionRow({
      focusKey: "integration:debrid:sizeRange",
      title: t31("debrid_stream_size_range_title", {}, "Size range"),
      subtitle: t31("debrid_stream_size_range_subtitle", {}, "Filter streams by file size."),
      value: debridSizeRangeLabel2(streamPreferences.sizeMinGb, streamPreferences.sizeMaxGb)
    })}
                  ${debridRuleRows2(streamPreferences).map(
      (row) => this.renderActionRow({
        focusKey: `integration:debrid:pref:${row.field}`,
        title: t31(row.titleKey, {}, row.field),
        subtitle: t31(row.subtitleKey, {}, ""),
        value: debridSelectionCountLabel2(row.selectedValues)
      })
    ).join("")}
                ` : ""}
          </div>
        </div>
      `;
  }

  // js/ui/screens/settings/settingsIntegrationDetailDebrid.js
  function renderDebridIntegrationDetail(model) {
    const state3 = createDebridIntegrationState(model);
