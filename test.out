  // js/core/player/audioTrackCodecMetadata.js
  function cleanCodecText(value) {
    return String(value ?? "").replace(/\s+/g, " ").trim();
  }
  function formatAudioCodecName(value) {
    const text5 = cleanCodecText(value).toLowerCase();
    if (!text5) {
      return "";
    }
    if (text5.includes("truehd") && text5.includes("atmos")) return "TrueHD Atmos";
    if (text5.includes("eac3-joc") || text5.includes("ec-3-joc") || text5.includes("e-ac-3-joc") || /\bjoc\b/.test(text5) || text5.includes("atmos"))
      return "E-AC-3-JOC";
    if (text5.includes("truehd")) return "TrueHD";
    if (text5.includes("dts-hd")) return "DTS-HD";
    if (text5.includes("dts express")) return "DTS Express";
    if (text5.includes("dts")) return "DTS";
    if (text5.includes("ec-3") || text5.includes("eac3") || text5.includes("ddp") || text5.includes("dolby digital plus"))
      return "E-AC-3";
    if (text5.includes("ac-3") || text5.includes("ac3") || text5.includes("dolby digital"))
      return "AC-3";
    if (text5.includes("ac-4") || text5.includes("ac4")) return "AC-4";
    if (text5.includes("aac") || text5.includes("mp4a")) return "AAC";
    if (text5.includes("mp3") || text5.includes("mpeg audio")) return "MP3";
    if (text5.includes("mp2")) return "MP2";
    if (text5.includes("vorbis")) return "Vorbis";
    if (text5.includes("opus")) return "Opus";
    if (text5.includes("flac")) return "FLAC";
    if (text5.includes("alac")) return "ALAC";
    if (text5.includes("wav") || text5.includes("pcm")) return "WAV";
    if (text5.includes("amr-wb")) return "AMR-WB";
    if (text5.includes("amr-nb")) return "AMR-NB";
    if (text5.includes("amr")) return "AMR";
    if (text5.includes("iamf")) return "IAMF";
    if (text5.includes("mpegh") || text5.includes("mhm1") || text5.includes("mha1")) return "MPEG-H";
    return "";
