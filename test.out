      return false;
    }
    try {
      const maxSampleSize = 48;
      const scale = Math.min(
        1,
        maxSampleSize / Math.max(Number(image4.naturalWidth), Number(image4.naturalHeight))
      );
      const width = Math.max(1, Math.round(Number(image4.naturalWidth) * scale));
      const height = Math.max(1, Math.round(Number(image4.naturalHeight) * scale));
      const canvas = document.createElement("canvas");
