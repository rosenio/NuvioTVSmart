      const providerRow = target.closest?.(".plugins-provider-row");
      const testResult = target.dataset?.action?.startsWith("test-scraper:") && providerRow?.nextElementSibling?.classList?.contains("plugins-test-result") ? providerRow.nextElementSibling : null;
