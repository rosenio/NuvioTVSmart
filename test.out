        registerPlaybackActionsPart01.call(this, model);
        registerPlaybackActionsPart02.call(this, model);
        return renderPlaybackSectionMarkup.call(this, model);
      }
    };
  }

  // js/ui/screens/settings/settingsScreenMethods-11-start-trakt-device-auth.js
  function createSettingsScreenMethods11() {
    const {
      Router: Router2,
      TraktAuthService: TraktAuthService2,
      TraktLibrarySourceMode: TraktLibrarySourceMode2,
      TraktSettingsStore: TraktSettingsStore2,
      WatchProgressSource: WatchProgressSource2,
      TRAKT_CONTINUE_WATCHING_DAY_OPTIONS: TRAKT_CONTINUE_WATCHING_DAY_OPTIONS2,
      TRAKT_WATCH_PROGRESS_OPTIONS: TRAKT_WATCH_PROGRESS_OPTIONS2,
      TRAKT_LIBRARY_SOURCE_OPTIONS: TRAKT_LIBRARY_SOURCE_OPTIONS2,
      TRAKT_COMMENTS_OPTIONS: TRAKT_COMMENTS_OPTIONS2,
      t: t31,
      escapeHtml: escapeHtml31,
      labelForTraktContinueWatchingDays: labelForTraktContinueWatchingDays2,
      renderTraktCountdownText: renderTraktCountdownText2,
      createTraktQrDataUrl: createTraktQrDataUrl2,
      settingsScrollIndicatorMarkup: settingsScrollIndicatorMarkup2
    } = settingsScreenContext_exports;
    return {
      async startTraktDeviceAuth() {
        this.traktLoading = true;
        this.traktErrorMessage = null;
        this.traktStatusMessage = null;
        this.contentFocusKey = "trakt:back";
        await this.render();
        try {
          await TraktAuthService2.startDeviceAuth();
          this.traktStatusMessage = "Enter code on trakt.tv/activate";
          this.startTraktPolling();
        } catch (error) {
          this.traktErrorMessage = String(error?.message || error || t31("qr_login_start_failed", {}, "Failed to start QR login"));
        } finally {
          this.traktLoading = false;
          await this.render();
        }
      },
      startTraktPolling(force = false) {
        if (this.traktPollTimer && !force) {
          return;
        }
        this.stopTraktPolling();
        const poll2 = async () => {
          const state3 = TraktAuthService2.getCurrentAuthState();
          if (!state3.deviceCode || Router2.getCurrent() !== "settings" || this.activeSection !== "trakt") {
            this.stopTraktPolling();
            return;
          }
          const result = await TraktAuthService2.pollDeviceToken().catch((error) => ({
            type: "failed",
            message: String(error?.message || error || "Network error, will retry")
          }));
          if (result.type === "approved") {
            this.stopTraktPolling();
            this.traktStatusMessage = `Connected as ${result.username || "Trakt user"}`;
            this.traktErrorMessage = null;
            await this.loadTraktStats(true);
            await this.render();
            return;
          }
          if (result.type === "pending") {
            this.traktStatusMessage = t31("trakt_waiting_approval", {}, "Waiting for approval...");
            this.traktErrorMessage = null;
          } else if (result.type === "slow_down") {
            this.traktStatusMessage = "Rate limited, slowing down polling...";
            this.traktErrorMessage = null;
          } else if (result.type === "expired") {
            this.stopTraktPolling();
            this.traktStatusMessage = null;
            this.traktErrorMessage = t31("trakt_error_code_expired", {}, "Code expired. Generate a new code.");
          } else if (result.type === "denied") {
            this.stopTraktPolling();
            this.traktStatusMessage = null;
            this.traktErrorMessage = t31("trakt_error_denied", {}, "Trakt authorization was denied.");
          } else if (result.type === "already_used") {
            this.stopTraktPolling();
            this.traktStatusMessage = null;
            this.traktErrorMessage = t31("trakt_error_code_used", {}, "This Trakt code was already used.");
          } else if (result.type === "failed") {
            this.traktStatusMessage = null;
            this.traktErrorMessage = result.message || "Token polling failed";
          }
          await this.render();
          const nextState = TraktAuthService2.getCurrentAuthState();
          if (nextState.deviceCode && !this.traktPollTimer) {
            this.traktPollTimer = setTimeout(
              () => {
                this.traktPollTimer = null;
                void poll2();
              },
              Math.max(1, Number(nextState.pollInterval || 5)) * 1e3
            );
          }
        };
        void poll2();
      },
      stopTraktPolling() {
        if (this.traktPollTimer) {
          clearTimeout(this.traktPollTimer);
          this.traktPollTimer = null;
        }
      },
      async loadTraktStats(forceRefresh = false) {
        if (!TraktAuthService2.isAuthenticated()) {
          this.traktStats = null;
          this.traktStatsLoading = false;
          return;
        }
        this.traktStatsLoading = true;
        try {
          this.traktStats = await TraktAuthService2.fetchStats(forceRefresh);
        } catch (error) {
          console.warn("Failed to load Trakt stats", error);
        } finally {
          this.traktStatsLoading = false;
        }
      },
      openTraktDisconnectDialog() {
        this.openOptionDialog({
          title: t31("trakt_disconnect_title", {}, "Disconnect Trakt?"),
          options: [
            { id: "disconnect", labelKey: "trakt_disconnect" },
            { id: "cancel", labelKey: "action_cancel", label: "Cancel" }
          ],
          selectedId: "cancel",
          returnFocusKey: "trakt:disconnect",
          dialogClassName: "settings-trakt-confirm-dialog",
          onSelect: async (option) => {
            if (option.id !== "disconnect") {
              return;
            }
            this.stopTraktPolling();
            this.traktLoading = true;
            await TraktAuthService2.disconnect();
            this.traktStats = null;
            this.traktLoading = false;
            this.traktStatusMessage = "Disconnected from Trakt";
          }
        });
      },
      renderTraktSection(model) {
        const trakt = model.trakt || this.collectTraktModel();
        const auth = trakt.auth || {};
        const settings = trakt.settings || TraktSettingsStore2.get();
        const mode = trakt.mode || "disconnected";
        const isConnected = mode === "connected";
        const isAwaitingApproval = mode === "awaiting_approval";
        const userCode = auth.userCode || "";
        const remaining = auth.expiresAt ? Math.max(0, Number(auth.expiresAt) - Date.now()) : 0;
        const tokenRemaining = auth.createdAt && auth.expiresIn ? Math.max(0, (Number(auth.createdAt) + Number(auth.expiresIn)) * 1e3 - Date.now()) : 0;
        if (isAwaitingApproval) {
          if (!this.deferTraktAutoWork?.("polling")) {
            this.startTraktPolling();
          }
        }
        if (isConnected && !this.traktStats && !this.traktStatsLoading) {
          if (!this.deferTraktAutoWork?.("stats")) {
            void this.loadTraktStats(false).then(() => {
              if (this.container && this.activeSection === "trakt") {
                void this.render();
              }
            });
          }
        }
        this.actionMap.set("trakt:back", () => {
          this.syncNavFocusToActive();
          this.focusZone = "nav";
        });
        this.actionMap.set("trakt:login", () => this.startTraktDeviceAuth());
        this.actionMap.set("trakt:cancel", async () => {
          this.stopTraktPolling();
          await TraktAuthService2.disconnect();
          this.traktStatusMessage = null;
          this.traktErrorMessage = null;
        });
        this.actionMap.set("trakt:retry", () => this.startTraktPolling(true));
        this.actionMap.set("trakt:disconnect", () => this.openTraktDisconnectDialog());
        this.actionMap.set("trakt:librarySource", () => {
          this.openOptionDialog({
            title: t31("trakt_library_source_dialog_title", {}, "Library Source"),
            options: TRAKT_LIBRARY_SOURCE_OPTIONS2,
            selectedId: settings.librarySourceMode,
            returnFocusKey: "trakt:librarySource",
            dialogClassName: "settings-trakt-dialog",
            onSelect: (option) => {
              TraktSettingsStore2.setLibrarySourceMode(option.id);
              this.traktStatusMessage = option.id === TraktLibrarySourceMode2.TRAKT ? t31("trakt_library_source_trakt_selected", {}, "Trakt library selected") : t31("trakt_library_source_nuvio_selected", {}, "Nuvio library selected");
            }
          });
        });
        this.actionMap.set("trakt:watchProgress", () => {
          this.openOptionDialog({
            title: t31("trakt_watch_progress_dialog_title", {}, "Watch Progress"),
            options: TRAKT_WATCH_PROGRESS_OPTIONS2,
            selectedId: settings.watchProgressSource,
            returnFocusKey: "trakt:watchProgress",
            dialogClassName: "settings-trakt-dialog",
            onSelect: (option) => {
              TraktSettingsStore2.setWatchProgressSource(option.id);
              this.traktStatusMessage = option.id === WatchProgressSource2.TRAKT ? t31("trakt_watch_progress_trakt_selected", {}, "Watch progress source set to Trakt") : t31("trakt_watch_progress_nuvio_selected", {}, "Watch progress source set to Nuvio Sync");
            }
          });
        });
        this.actionMap.set("trakt:cwWindow", () => {
          this.openOptionDialog({
            title: t31("trakt_cw_window_title", {}, "Continue Watching Window"),
            message: t31("trakt_cw_window_subtitle", {}, "Choose how much Trakt activity should appear in continue watching."),
            options: TRAKT_CONTINUE_WATCHING_DAY_OPTIONS2.map((days) => ({
              id: String(days),
              label: labelForTraktContinueWatchingDays2(days)
            })),
            selectedId: String(settings.continueWatchingDaysCap),
            returnFocusKey: "trakt:cwWindow",
            dialogClassName: "settings-trakt-dialog",
            optionRenderer: "single-choice",
            onSelect: (option) => {
              TraktSettingsStore2.setContinueWatchingDaysCap(Number(option.id));
              this.traktStatusMessage = t31("trakt_status_cw_window_updated", {}, "Continue watching window updated");
            }
          });
        });
        this.actionMap.set("trakt:comments", () => {
          this.openOptionDialog({
            title: t31("trakt_comments_dialog_title", {}, "Comments"),
            options: TRAKT_COMMENTS_OPTIONS2,
            selectedId: settings.showMetaComments ? "on" : "off",
            returnFocusKey: "trakt:comments",
            dialogClassName: "settings-trakt-dialog",
            onSelect: (option) => {
              const enabled = option.id === "on";
              TraktSettingsStore2.setShowMetaComments(enabled);
              this.traktStatusMessage = enabled ? t31("trakt_comments_now_shown", {}, "Trakt reviews on metadata pages are now shown") : t31("trakt_comments_now_hidden", {}, "Trakt reviews on metadata pages are now hidden");
            }
          });
        });
        return `
          <div class="settings-slide-panel settings-trakt-panel">
            <div class="settings-trakt-hero">
              <img class="settings-trakt-logo" src="assets/icons/trakt_tv_favicon.svg" alt="" aria-hidden="true" />
              <div class="settings-trakt-title">Trakt</div>
              <p class="settings-trakt-description">${escapeHtml31(t31("trakt_description", {}, "Sync your watchlist, watch progress, continue watching, scrobbles, and personal lists with Trakt."))}</p>
              ${isConnected ? `<p class="settings-trakt-connected">${escapeHtml31(t31("trakt_connected_as", [auth.username || "Trakt user"], `Connected as ${auth.username || "Trakt user"}`))}</p>` : ""}
            </div>
            <div class="settings-trakt-card">
              <div class="settings-trakt-scroll-frame settings-content-frame">
                <div class="settings-trakt-scroll-area">
                  <div class="settings-trakt-header-row">
                    <div class="settings-trakt-card-title">${escapeHtml31(t31("trakt_account_login", {}, "Account Login"))}</div>
                    ${isAwaitingApproval ? `<button class="settings-trakt-small-button settings-content-focusable focusable" data-zone="content" ${this.registerAction("trakt:cancel", this.actionMap.get("trakt:cancel"))}>${escapeHtml31(t31("action_cancel", {}, "Cancel"))}</button>` : ""}
                  </div>
                  ${isAwaitingApproval ? this.renderTraktAwaitingApproval(userCode, remaining) : ""}
                  ${isConnected ? this.renderTraktConnected(auth, tokenRemaining, trakt) : ""}
                  ${!isAwaitingApproval && !isConnected ? this.renderTraktDisconnected(trakt) : ""}
                  ${isConnected ? this.renderTraktOptions(settings) : ""}
                  ${!isConnected && trakt.statusMessage ? `<p class="settings-trakt-message">${escapeHtml31(trakt.statusMessage)}</p>` : ""}
                  ${trakt.errorMessage ? `<p class="settings-trakt-error">${escapeHtml31(trakt.errorMessage)}</p>` : ""}
                </div>
                ${settingsScrollIndicatorMarkup2("vertical")}
              </div>
              <div class="settings-trakt-footer-row">
                ${isAwaitingApproval ? `<button class="settings-trakt-button settings-content-focusable focusable" data-zone="content" ${this.registerAction("trakt:retry", this.actionMap.get("trakt:retry"))}>${escapeHtml31(t31("trakt_retry", {}, "Retry"))}</button>` : ""}
                <button class="settings-trakt-button settings-content-focusable focusable" data-zone="content" ${this.registerAction("trakt:back", this.actionMap.get("trakt:back"))}>${escapeHtml31(t31("trakt_back", {}, "Back"))}</button>
              </div>
            </div>
          </div>
        `;
      },
      renderTraktAwaitingApproval(userCode, remainingMs) {
        const qrDataUrl = createTraktQrDataUrl2(userCode);
        return `
          <p class="settings-trakt-body-copy">${escapeHtml31(t31("trakt_awaiting_instruction", {}, "Go to trakt.tv/activate and enter this code:"))}</p>
          <div class="settings-trakt-code">${escapeHtml31(userCode || "-")}</div>
          ${qrDataUrl ? `<img class="settings-trakt-qr" src="${escapeHtml31(qrDataUrl)}" alt="${escapeHtml31(t31("cd_trakt_qr", {}, "Trakt QR code"))}" />` : ""}
          <p class="settings-trakt-meta-copy">${renderTraktCountdownText2("trakt_code_expires", remainingMs, "Code expires in", "data-trakt-device-countdown")}</p>
        `;
      },
      renderTraktDisconnected(trakt) {
        return `
          <p class="settings-trakt-body-copy">${escapeHtml31(t31("trakt_login_instruction", {}, "Press Login to start Trakt device authentication. A QR code will appear here."))}</p>
          <button class="settings-trakt-button settings-trakt-login-button settings-content-focusable focusable${!trakt.credentialsConfigured || trakt.isLoading ? " is-disabled" : ""}"
                  data-zone="content"
                  ${this.registerAction("trakt:login", !trakt.credentialsConfigured || trakt.isLoading ? () => {
        } : this.actionMap.get("trakt:login"))}>
            ${escapeHtml31(t31("trakt_login", {}, "Login"))}
          </button>
          ${!trakt.credentialsConfigured ? `<p class="settings-trakt-warning">${escapeHtml31(t31("trakt_missing_credentials", {}, "Missing TRAKT_CLIENT_ID / TRAKT_CLIENT_SECRET in local.properties."))}</p>` : ""}
        `;
      },
      renderTraktConnected(auth, tokenRemainingMs, trakt) {
        return `
          ${tokenRemainingMs ? `<p class="settings-trakt-meta-copy">${renderTraktCountdownText2("trakt_token_refreshes", tokenRemainingMs, "Trakt access token refreshes in", "data-trakt-token-countdown")}</p>` : ""}
          <button class="settings-trakt-button settings-content-focusable focusable" data-zone="content" ${this.registerAction("trakt:disconnect", this.actionMap.get("trakt:disconnect"))}>${escapeHtml31(t31("trakt_disconnect", {}, "Disconnect"))}</button>
          ${this.renderTraktStatsStrip(trakt.stats, trakt.isStatsLoading)}
        `;
      }
    };
  }

  // js/ui/screens/settings/settingsAmbientSection.js
  init_profileManager();
  init_ambientModeStore();
  init_i18n();
  var t19 = (key3, params = []) => I18n.t(key3, params, { fallback: key3 });
  function renderAmbientSection() {
    const settings = AmbientModeStore.get();
    const pid = ProfileManager.getActiveProfileId();
    const mount = this.settingsMountToken;
    const current2 = () => this.isMounted && this.activeSection === "ambient" && this.settingsMountToken === mount && ProfileManager.getActiveProfileId() === pid;
    this.actionMap.set(
      "ambient:enabled",
      () => current2() && AmbientModeStore.set({ enabled: !AmbientModeStore.get().enabled })
    );
    this.actionMap.set(
      "ambient:timeout",
      () => this.openOptionDialog({
        title: t19("ambient_mode_timeout"),
        options: AMBIENT_TIMEOUT_OPTIONS.map((minutes) => ({
          id: String(minutes),
          label: I18n.getQuantityString("ambient_mode_timeout_minutes", minutes, [minutes])
        })),
        selectedId: String(settings.timeoutMinutes),
        returnFocusKey: "ambient:timeout",
        onSelect: (option) => current2() && AmbientModeStore.set({ timeoutMinutes: Number(option.id) })
      })
    );
    this.actionMap.set("ambient:catalogs", async () => {
      const mountToken = this.settingsMountToken;
      const profileId2 = ProfileManager.getActiveProfileId();
      const catalogs = await getAmbientCatalogs();
      if (!this.isMounted || this.activeSection !== "ambient" || this.settingsMountToken !== mountToken || ProfileManager.getActiveProfileId() !== profileId2)
        return;
      this.openMultiChoiceDialog({
        title: t19("ambient_mode_catalogs"),
        message: t19("ambient_mode_catalogs_dialog_subtitle"),
        options: catalogs.map((entry) => ({
          id: entry.key,
          label: `${entry.title} \xB7 ${entry.source}`
        })),
        selectedIds: AmbientModeStore.get().catalogKeys,
        returnFocusKey: "ambient:catalogs",
        onToggle: (keys) => {
          if (!current2()) return;
          if (keys.length <= 3) AmbientModeStore.set({ catalogKeys: keys });
          else this.optionDialog.selectedIds = new Set(AmbientModeStore.get().catalogKeys);
        }
      });
    });
    return `<div class="settings-stack">${this.renderToggleRow({ focusKey: "ambient:enabled", title: t19("ambient_mode_title"), subtitle: t19("ambient_mode_enabled_subtitle"), checked: settings.enabled })}${settings.enabled ? this.renderActionRow({ focusKey: "ambient:timeout", title: t19("ambient_mode_timeout"), subtitle: t19("ambient_mode_timeout_subtitle"), value: I18n.getQuantityString("ambient_mode_timeout_minutes", settings.timeoutMinutes, [settings.timeoutMinutes]) }) + this.renderActionRow({ focusKey: "ambient:catalogs", title: t19("ambient_mode_catalogs"), subtitle: t19("ambient_mode_catalogs_subtitle"), value: settings.catalogKeys.length ? t19("ambient_mode_catalogs_count", [settings.catalogKeys.length, 3]) : t19("ambient_mode_catalogs_default") }) : ""}</div>`;
  }

  // js/ui/screens/settings/settingsScreenMethods-12-render-trakt-stats-strip.js
  function createSettingsScreenMethods12() {
    const {
      Router: Router2,
      ScreenUtils: ScreenUtils2,
      renderMemberBrandWordmark: renderMemberBrandWordmark2,
      bindRootSidebarEvents: bindRootSidebarEvents2,
      renderRootSidebar: renderRootSidebar2,
      getLatestAppUpdate: getLatestAppUpdate2,
      showAppUpdatePrompt: showAppUpdatePrompt2,
      CURRENT_APP_VERSION: CURRENT_APP_VERSION2,
      SETTINGS_VERSION_LABEL: SETTINGS_VERSION_LABEL2,
      PRIVACY_URL: PRIVACY_URL2,
      SECTION_META: SECTION_META2,
      clamp: clamp7,
      t: t31,
      escapeHtml: escapeHtml31,
      syncLayoutPreviewMetricsSoon: syncLayoutPreviewMetricsSoon2,
      labelForTraktContinueWatchingDays: labelForTraktContinueWatchingDays2,
      labelForTraktWatchProgressSource: labelForTraktWatchProgressSource2,
      labelForTraktLibrarySource: labelForTraktLibrarySource2,
      labelForTraktComments: labelForTraktComments2,
      updateSettingsScrollIndicatorsSoon: updateSettingsScrollIndicatorsSoon2,
      bindSettingsScrollIndicators: bindSettingsScrollIndicators2,
      getVisibleSections: getVisibleSections2,
      getSettingsSectionById: getSettingsSectionById2,
      updateSettingsRailIndicators: updateSettingsRailIndicators2,
      updateSettingsRailIndicatorsSoon: updateSettingsRailIndicatorsSoon2,
      captureSettingsScrollState: captureSettingsScrollState2,
      restoreSettingsScrollState: restoreSettingsScrollState2
    } = settingsScreenContext_exports;
    return {
      renderTraktStatsStrip(stats, isLoading) {
        const values = isLoading ? ["...", "...", "...", "..."] : [
          stats?.moviesWatched ?? "-",
          stats?.showsWatched ?? "-",
          stats?.episodesWatched ?? "-",
          stats?.totalWatchedHours == null ? "-" : `${stats.totalWatchedHours}h`
        ];
        const labels = [
          t31("trakt_stat_movies", {}, "Movies"),
          t31("trakt_stat_shows", {}, "Shows"),
          t31("trakt_stat_episodes", {}, "Episodes"),
          t31("trakt_stat_watched_hours", {}, "Watched Hours")
        ];
        return `
          <div class="settings-trakt-stats">
            <div class="settings-trakt-stats-label">${escapeHtml31(t31("trakt_cached_label", {}, "Cached"))}</div>
            <div class="settings-trakt-stats-line" aria-hidden="true"></div>
            <div class="settings-trakt-stats-row">
              ${values.map(
          (value, index) => `
                <div class="settings-trakt-stat">
                  <strong>${escapeHtml31(value)}</strong>
                  <span>${escapeHtml31(labels[index])}</span>
                </div>
              `
        ).join("")}
            </div>
            <div class="settings-trakt-stats-line" aria-hidden="true"></div>
          </div>
        `;
      },
      renderTraktOptions(settings) {
        return `
          <div class="settings-stack settings-trakt-options-stack">
            ${this.renderActionRow({
          focusKey: "trakt:librarySource",
          title: t31("trakt_library_source_title", {}, "Library Source"),
          subtitle: t31("trakt_library_source_subtitle", {}, "Choose which library to use for saving and viewing your collection"),
          value: labelForTraktLibrarySource2(settings.librarySourceMode)
        })}
            ${this.renderActionRow({
          focusKey: "trakt:watchProgress",
          title: t31("trakt_watch_progress_title", {}, "Watch Progress"),
          subtitle: t31("trakt_watch_progress_subtitle", {}, "Choose which progress source powers resume and continue watching"),
          value: labelForTraktWatchProgressSource2(settings.watchProgressSource)
        })}
            ${this.renderActionRow({
          focusKey: "trakt:cwWindow",
          title: t31("trakt_continue_watching_window", {}, "Continue Watching Window"),
          subtitle: t31("trakt_continue_watching_subtitle", {}, "Trakt history considered for continue watching"),
          value: labelForTraktContinueWatchingDays2(settings.continueWatchingDaysCap)
        })}
            ${this.renderActionRow({
          focusKey: "trakt:comments",
          title: t31("trakt_comments_title", {}, "Comments"),
          subtitle: t31("trakt_comments_subtitle", {}, "Show Trakt reviews on metadata pages"),
          value: labelForTraktComments2(settings.showMetaComments)
        })}
          </div>
        `;
      },
      renderTraktLauncher() {
        this.actionMap.set("trakt:open", () => Router2.navigate("trakt"));
        return `
          ${this.renderSectionHeader(SECTION_META2.find((item) => item.id === "trakt"))}
          <div class="settings-group-card settings-group-card-fill">
            <div class="settings-stack">
              ${this.renderActionRow({
          focusKey: "trakt:open",
          title: t31("settings.tracking.openSettings", {}, "Tracking"),
          subtitle: t31("settings.tracking.openSettingsSubtitle", {}, "Connect Trakt or Simkl and choose library and progress sources.")
        })}
            </div>
          </div>
        `;
      },
      renderAboutSection(model = this.model) {
        this.actionMap.set("about:privacy", () => {
          window.open?.(PRIVACY_URL2, "_blank");
        });
        this.actionMap.set("about:supporters", () => Router2.navigate("supportersContributors"));
        this.actionMap.set("about:licenses", () => Router2.navigate("licensesAttributions"));
        this.actionMap.set("about:checkUpdates", async () => {
          this.aboutUpdateStatus = t31("update_checking", {}, "Checking for updates\u2026");
          await this.render({ refreshModel: false });
          try {
            const update = await getLatestAppUpdate2({ currentVersion: CURRENT_APP_VERSION2 });
            this.aboutUpdateStatus = update ? String(update.tag || "") : t31("update_latest_version", {}, "You\u2019re using the latest version.");
            if (update) showAppUpdatePrompt2(update);
          } catch (_) {
            this.aboutUpdateStatus = t31("update_error_check_failed", {}, "Update check failed");
          }
          await this.render({ refreshModel: false });
        });
        this.actionMap.set("about:debugConsole", () => Router2.navigate("debugConsole"));
        return `
          ${this.renderSectionHeader(SECTION_META2.find((item) => item.id === "about"))}
          <div class="settings-group-card settings-group-card-fill">
            <div class="settings-about-brand">
              ${renderMemberBrandWordmark2({
          access: model?.memberAccess,
          imageClass: "settings-about-logo",
          wrapperClass: "settings-about-wordmark"
        })}
              <p class="settings-about-copy">${t31("settings.about.madeWithLove")}</p>
              <p class="settings-about-copy">${t31("settings.about.version", { version: SETTINGS_VERSION_LABEL2 })}</p>
              <p class="settings-about-copy">${t31("settings.about.portedBy")}</p>
            </div>
            <div class="settings-stack">
              ${this.renderActionRow({
          focusKey: "about:checkUpdates",
          title: t31("about_check_updates", {}, "Check for updates"),
          subtitle: this.aboutUpdateStatus || t31("about_check_updates_subtitle", {}, "Check the latest release for manual installation")
        })}
              ${this.renderActionRow({
