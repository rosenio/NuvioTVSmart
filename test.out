      controls: "0",
      loop: "1",
      playlist: cleanId,
      playsinline: "1",
      rel: "0",
      modestbranding: "1",
      enablejsapi: "1",
      cc_load_policy: "0",
      iv_load_policy: "3"
    });
    const origin = String(globalThis?.location?.origin || "").trim();
    if (/^https?:\/\//i.test(origin)) {
