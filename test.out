          return true;
        }
        if (action === "refreshMembership") {
          this.focusKey = MembershipOverviewRepository2.getState()?.overview ? "membership:action" : "membership:refresh";
          await MembershipOverviewRepository2.refresh();
          if (Router2.getCurrent() === "supportersContributors") {
