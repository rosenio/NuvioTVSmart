      /(?:youtube\.com\/watch\?v=|youtube\.com\/embed\/|youtu\.be\/)([A-Za-z0-9_-]{11})/i,
      /(?:youtube\.com\/shorts\/)([A-Za-z0-9_-]{11})/i
