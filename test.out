  // js/ui/screens/settings/settingsCustomPosterSection.js
  init_profileManager();

  // js/ui/screens/settings/customPosterPhoneConfig.js
  init_platform();
  init_pluginServiceClient();
  init_profileManager();
  init_qrCodeGenerator();
  init_layoutPreferences();
  init_i18n();
  function escape2(value) {
    return String(value || "").replace(
      /[&<>"']/g,
      (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]
    );
  }
  async function openCustomPosterPhoneConfig(screen) {
    const profileId2 = ProfileManager.getActiveProfileId();
    const mountToken = screen.settingsMountToken;
    const current2 = () => screen.isMounted && screen.settingsMountToken === mountToken && screen.activeSection === "layout" && ProfileManager.getActiveProfileId() === profileId2;
    const bytes = new Uint8Array(32);
    globalThis.crypto.getRandomValues(bytes);
    const token = Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("");
    const health = await PluginServiceClient.ensureReady();
    if (!current2()) return;
    const port = Number(health.port || (Platform.isWebOS() ? 2721 : 2711));
    if (![2711, 2721].includes(port)) throw new Error("web_custom_poster_error_connection");
    const control = async (action, extra = {}) => {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 1e4);
      try {
        const response = await fetch(`http://127.0.0.1:${port}/poster-config`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action, token, ...extra }),
          signal: controller.signal
        });
        if (!response.ok) throw new Error("web_custom_poster_error_connection");
        const result = await response.json();
        if (result.returnValue === false) throw new Error("web_custom_poster_error_connection");
        return result;
      } finally {
        clearTimeout(timeout);
      }
    };
    const keys = {
      title: "title",
      subtitle: "subtitle",
      label: "label",
      save: "save",
      clear: "clear",
      saved: "saved",
      cleared: "cleared",
      info: "placeholders_info",
      error: "error_connection"
    };
    const labels = Object.fromEntries(
      Object.entries(keys).map(([key3, suffix]) => [key3, I18n.t(`web_custom_poster_${suffix}`)])
    );
    const session2 = await control("start", {
      pattern: LayoutPreferences.get().customPosterUrlPattern,
      labels
    });
    let timer4 = null;
    let closed = false;
    const stop = () => {
      if (closed) return;
      closed = true;
      clearTimeout(timer4);
      void control("stop").catch(() => {
      });
    };
    if (!current2()) {
      stop();
      return;
    }
    let address = session2.address;
    if (!address && Platform.isTizen()) {
      try {
        address = globalThis.webapis?.network?.getIp?.();
      } catch (_) {
      }
    }
    if (!/^\d{1,3}(?:\.\d{1,3}){3}$/.test(address || "") || /^127\./.test(address)) {
      stop();
      throw new Error("web_custom_poster_error_connection");
    }
    const url = `http://${address}:${session2.port}/${token}/`;
    const canvas = document.createElement("canvas");
    try {
      QrCodeGenerator.generate(canvas, url, 420);
    } catch (error) {
      stop();
      throw error;
    }
    screen.closeCustomPosterPhoneConfig?.();
    screen.closeCustomPosterPhoneConfig = stop;
    screen.openOptionDialog({
      title: I18n.t("layout_custom_poster_qr"),
      messageHtml: `<p>${escape2(I18n.t("custom_poster_qr_instruction"))}</p><img class="settings-trakt-qr" src="${escape2(canvas.toDataURL("image/png"))}" alt="${escape2(I18n.t("layout_custom_poster_qr"))}" />`,
      options: [{ id: "close", label: I18n.t("action_back") }],
      selectedId: "close",
      returnFocusKey: "layout:customPosterPhone",
      onClose: stop
    });
    let revision2 = 0;
    const poll2 = async () => {
      if (closed) return;
      if (!current2() || screen.optionDialog?.returnFocusKey !== "layout:customPosterPhone") {
        stop();
        return;
      }
      try {
        const state3 = await control("read");
        if (closed || !current2()) {
          stop();
          return;
        }
        if (state3.revision > revision2) {
          revision2 = state3.revision;
          LayoutPreferences.set({
            customPosterUrlPattern: state3.pattern,
            ...state3.cleared ? { customPosterEnabledScreens: CUSTOM_POSTER_SCREENS } : {}
          });
          await screen.render({ refreshModel: false });
        }
      } catch (_) {
        stop();
        return;
      }
      if (!closed) timer4 = setTimeout(poll2, 1e3);
    };
    timer4 = setTimeout(poll2, 1e3);
  }

  // js/ui/screens/settings/settingsCustomPosterSection.js
  init_platform();
  init_layoutPreferences();
  init_i18n();
  var t18 = (key3) => I18n.t(key3);
  function renderCustomPosterSettings() {
    const settings = LayoutPreferences.get();
    const pid = ProfileManager.getActiveProfileId();
    const mount = this.settingsMountToken;
    const current2 = () => this.isMounted && this.activeSection === "layout" && this.settingsMountToken === mount && ProfileManager.getActiveProfileId() === pid;
    const phoneSupported = Platform.isWebOS() || Platform.isTizen();
    this.actionMap.set("layout:customPosterPhone", async () => {
      if (!current2() || this.customPosterPhoneStarting) return;
      this.customPosterPhoneStarting = true;
      this.customPosterPhoneError = false;
      try {
        await openCustomPosterPhoneConfig(this);
      } catch (_) {
        if (current2()) this.customPosterPhoneError = true;
      } finally {
        this.customPosterPhoneStarting = false;
      }
    });
    this.actionMap.set(
      "layout:customPoster",
      () => this.openTextDialog({
        title: t18("layout_custom_poster_title"),
        value: settings.customPosterUrlPattern,
        placeholder: t18("web_custom_poster_placeholder"),
        returnFocusKey: "layout:customPoster",
        clearLabel: t18("layout_custom_poster_clear"),
        onClear: () => {
          if (!current2()) return false;
          LayoutPreferences.set({
            customPosterUrlPattern: "",
            customPosterEnabledScreens: CUSTOM_POSTER_SCREENS
          });
        },
        onSubmit: (value) => {
          if (!current2()) return false;
          if (value.trim() && !/^https?:\/\//i.test(value.trim())) return false;
