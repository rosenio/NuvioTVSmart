        return t10("library_source_nuvio", {}, "NUVIO");
      }
      return t10("library_source_local", {}, "LOCAL");
    }
    getSelectedTypeLabel() {
      const label = this.state.availableTypeTabs.find((item) => item.key === this.state.selectedTypeKey)?.label || t10("library_type_all", {}, "All");
      return stripCountSuffix(label);
