  // js/ui/screens/search/discoverScreenMethods-03-open-picker-menu.js
  function createDiscoverScreenMethods03() {
    const {
      Router: Router2,
      PosterOptionsDialogController: PosterOptionsDialogController2,
      posterItemFromNode: posterItemFromNode2,
      focusWithoutAutoScroll: focusWithoutAutoScroll2,
      setLegacySidebarExpanded: setLegacySidebarExpanded2,
