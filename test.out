  // js/ui/screens/supporters/supportersContributorsScreenMethods-03-activate-target.js
  function createSupportersContributorsScreenMethods03() {
    const { Router: Router2, Platform: Platform2, SUPPORT_URL: SUPPORT_URL2, MembershipOverviewRepository: MembershipOverviewRepository2, DEFAULT_TAB: DEFAULT_TAB2, normalizeBaseUrl: normalizeBaseUrl8, visibleFocusableNodes: visibleFocusableNodes2 } = supportersContributorsScreen_exports;
