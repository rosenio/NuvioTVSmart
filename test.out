          this.syncOpenPickerScroll();
          return;
        }
        this.restoreScrollState();
        const scrollMode = this.preserveViewportOnNextRender ? "none" : "center";
        this.preserveViewportOnNextRender = false;
        this.restoreContentFocus({ scrollMode });
