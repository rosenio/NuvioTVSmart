                    <div class="library-grid-poster${item.poster ? "" : " placeholder"}"${item.poster && !item.rawPosterUrl ? ` style="background-image:url('${escapeHtml31(item.poster)}')"` : ""}>
                      ${item.rawPosterUrl ? `<img class="library-custom-poster" src="${escapeHtml31(item.poster)}"${posterFallbackAttributes(item)} alt="" loading="lazy" decoding="async" />` : ""}
                      ${isWatched ? renderTitleWatchedBadge2({ className: "library-watched-badge", iconClassName: "library-watched-badge-svg" }) : ""}
                    </div>
