      const result = await PartyRepository.join(this.code);
      if (token !== this.mountToken) return;
      const joinedParty = PartyRepository.getState().party;
      if (result == null && joinedParty) {
        this.pendingCode = "";
        this.joining = false;
        this.joined = joinedParty;
        this.render();
        await wait(JOINED_DELAY_MS);
        if (token !== this.mountToken || !this.joined) return;
        const media = this.joined.media;
        this.joined = null;
        void openPartyMedia(media);
        return;
      }
      await this.reject(result || PartyError.Network);
    },
    activate(node) {
      if (!node) return;
      const key3 = node.dataset.partyKey;
      if (key3) {
        if (key3 === "delete") this.changeCode(this.code.slice(0, -1));
        else if (key3 === "submit") void this.submit();
        else if (this.code.length < PARTY_CODE_LENGTH) this.changeCode(this.code + key3);
        return;
      }
      const party = PartyRepository.getState().party;
      if (!party) return;
      switch (node.dataset.partyAction) {
        case "watch":
          void openPartyMedia(party.media);
          break;
        case "leave":
          void PartyRepository.leave();
          break;
        case "end":
          showConfirmDialog({
            title: t5("party_end_title"),
            message: t5("party_end_message"),
            confirmLabel: t5("party_end"),
            onConfirm: () => void PartyRepository.end()
          });
          break;
        case "remove": {
          const member = party.members.find((entry) => entry.id === node.dataset.memberId);
          if (!member) return;
          showConfirmDialog({
            title: t5("party_remove_title", [member.display_name]),
            message: t5("party_remove_message"),
            confirmLabel: t5("party_remove"),
            onConfirm: () => void PartyRepository.removeMember(member.id)
          });
          break;
        }
        case "invite":
          void showInviteDialog(party);
          break;
        case "hostOnly":
          void PartyRepository.setHostOnly(!party.hostOnly);
          break;
        case "sharing":
          PartyRepository.setSharing(!party.sharing);
          break;
        default:
          break;
      }
    },
    onKeyDown(event) {
      if (!this.container) return;
      if (this.mode() === "join" && !this.blockedError()) {
        const character = String(event?.key || "").length === 1 ? String(event.key).toUpperCase() : "";
        if (!event?.ctrlKey && !event?.altKey && !event?.metaKey) {
          if (character && PARTY_CODE_ALPHABET.includes(character)) {
            event.preventDefault?.();
            if (this.code.length < PARTY_CODE_LENGTH) this.changeCode(this.code + character);
            return;
          }
          if (event?.key === "Backspace" || event?.key === "Delete") {
            event.preventDefault?.();
            this.changeCode(this.code.slice(0, -1));
            return;
          }
        }
      }
      const keyCode = Number(event?.keyCode || 0);
      if (this.mode() === "party" && (keyCode === 38 || keyCode === 40)) {
        event.preventDefault?.();
        const focused = moveListFocus(this.container, keyCode === 40 ? 1 : -1);
        if (focused) this.focusKey = focused.dataset.focusKey || "";
        return;
      }
      if (ScreenUtils.handleDpadNavigation(event, this.container)) {
        const focused = this.container.querySelector(".focusable.focused");
        if (focused) {
          this.focusKey = focused.dataset.focusKey || "";
          focused.scrollIntoView?.({ block: "nearest" });
        }
        return;
      }
      if (Number(event?.keyCode) === 13 || event?.key === "Enter") {
        event.preventDefault?.();
        this.activate(this.container.querySelector(".focusable.focused"));
      }
    },
    consumeBackRequest() {
      return false;
    },
    cleanup() {
      this.mountToken = (this.mountToken || 0) + 1;
      this.previewToken += 1;
      this.unsubscribers?.forEach((unsubscribe) => unsubscribe());
      this.unsubscribers = [];
      if (this.renderFrame) {
        if (typeof cancelAnimationFrame === "function") cancelAnimationFrame(this.renderFrame);
        clearTimeout(this.renderFrame);
        this.renderFrame = null;
      }
      this.joined = null;
      ScreenUtils.hide(this.container);
    }
  };

  // js/ui/screens/livetv/liveTvScreen.js
  init_i18n();
  init_platform();
  init_tvRuntimePerformance();
  init_localStore();

  // js/ui/screens/livetv/liveTvScreenMethods-01-get-route-state-key.js
  function createLiveTvScreenMethods01() {
    return {
      getRouteStateKey() {
        return "livetv";
      }
    };
  }

  // js/ui/screens/livetv/liveTvScreenMethods-02-render.js
  init_i18n();
  init_localStore();
  function createLiveTvScreenMethods02() {
    return {
      async render() {
        if (!this.container || !this.isMounted || !this.container.isConnected) {
          console.warn("[LiveTvScreen] render() skipped: no container or not mounted");
          return;
        }
        const state3 = LiveTvRepository.getUiState();
        console.log("[LiveTvScreen] render state:", {
          hasPlaylist: state3.hasPlaylist,
          channels: state3.channels?.length,
          isLoading: state3.isLoading,
          error: state3.errorMessage,
          playlists: state3.playlists?.map((p) => ({ name: p.name, enabled: p.isEnabled }))
        });
        const profileState = await getSidebarProfileState({ cacheOnly: true });
        const isModern = LocalStore.get("modernSidebar", false);
        this.container.innerHTML = `
        <div class="home-shell livetv-screen" style="background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f0f23 100%); min-height: 100vh; position: relative;">
          ${renderRootSidebar({ selectedRoute: "livetv", profile: profileState, layout: { modernSidebar: isModern } })}
          <main class="livetv-main" role="main" style="background: transparent; min-height: 100vh; padding: 20px; margin-left: 320px; box-sizing: border-box;">
            <header class="livetv-header">
              <h1 class="livetv-title">${I18n.t("live_tv_title", {}, "Live TV")}</h1>
              ${state3.hasPlaylist ? `
                <button class="livetv-refresh-btn focusable" data-action="refresh" aria-label="${I18n.t("action_retry", {}, "Refresh")}">
                  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M17.65 6.35A7.958 7.958 0 0012 4C9.79 4 7.61 4.74 5.9 6.04L3.59 3.72A9.96 9.96 0 0112 2c5.52 0 10 4.48 10 10 0 2.02-.72 3.87-1.88 5.33L17.65 6.35zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg>
                </button>
              ` : ""}
            </header>

            <div class="livetv-content" data-load-state="${state3.isLoading ? "loading" : state3.errorMessage ? "error" : state3.channels.length === 0 ? "empty" : "loaded"}">
              ${this.renderContent(state3)}
            </div>
          </main>
        </div>
      `;
        console.log("[LiveTvScreen] Binding sidebar events with currentRoute=livetv");
        bindRootSidebarEvents(this.container, {
          currentRoute: "livetv",
          onSelectedAction: this.onSelectedAction.bind(this),
          onExpandSidebar: this.onExpandSidebar.bind(this)
        });
        this.container.querySelectorAll('[data-action="refresh"]').forEach((btn) => {
          btn.onclick = () => LiveTvRepository.reloadChannels();
        });
        this.bindChannelCards();
        this.buildNavModel();
        this.applyFocus();
      },
      renderContent(state3) {
        console.log("[LiveTvScreen] renderContent state:", {
          hasPlaylist: state3.hasPlaylist,
          channels: state3.channels?.length,
          isLoading: state3.isLoading,
          error: state3.errorMessage
        });
        if (state3.isLoading && state3.channels.length === 0) {
          return renderLoadingIndicator({ size: "large", label: I18n.t("live_tv_loading", {}, "Loading channels...") });
        }
        if (!state3.hasPlaylist) {
          console.log("[LiveTvScreen] Rendering NO PLAYLIST empty state with Settings button");
          return `
          <div class="livetv-empty-state">
            <svg class="livetv-empty-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
            <h2>${I18n.t("live_tv_no_playlist_title", {}, "No Playlist")}</h2>
            <p>${I18n.t("live_tv_no_playlist_message", {}, "Add an M3U playlist URL or configure Xtream/Stalker in Settings to start watching Live TV.")}</p>
            <button class="livetv-settings-btn focusable" data-action="gotoSettings">${I18n.t("action_settings", {}, "Open Settings")}</button>
          </div>
        `;
        }
        if (state3.errorMessage && state3.channels.length === 0) {
          return `
          <div class="livetv-empty-state">
            <svg class="livetv-empty-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
            <h2>${I18n.t("live_tv_load_failed", {}, "Failed to Load")}</h2>
            <p>${I18n.t("live_tv_error_message", { message: state3.errorMessage }, state3.errorMessage)}</p>
            <button class="livetv-retry-btn focusable" data-action="refresh">${I18n.t("action_retry", {}, "Retry")}</button>
          </div>
        `;
        }
        if (state3.channels.length === 0) {
          return `
          <div class="livetv-empty-state">
            <svg class="livetv-empty-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
            <h2>${I18n.t("live_tv_empty_title", {}, "No Channels")}</h2>
            <p>${I18n.t("live_tv_empty_message", {}, "No channels found in the current playlist.")}</p>
            <button class="livetv-retry-btn focusable" data-action="refresh">${I18n.t("action_retry", {}, "Refresh")}</button>
          </div>
        `;
        }
        return `
        <div class="livetv-controls-sticky">
          ${this.renderChannelControls(state3)}
        </div>
        <div class="livetv-channel-list" role="list" aria-label="${I18n.t("live_tv_channels", {}, "Channels")}" style="max-height: calc(100vh - 280px); overflow-y: auto; padding-right: 8px;">
          ${this.renderChannelList(state3)}
        </div>
        ${this.visibleChannels.length === 0 ? `
          <div class="livetv-empty-state">
            <h2>${I18n.t("live_tv_no_matching_channels_title", {}, "No Matching Channels")}</h2>
            <p>${I18n.t("live_tv_no_matching_channels_message", {}, "Try adjusting your search or filter.")}</p>
          </div>
        ` : ""}
      `;
      },
      renderChannelControls(state3) {
        const categories = this.buildCategoryOptions(state3);
        const allLabel = I18n.t("live_tv_group_all_channels", {}, "All Channels");
        const favoritesLabel = I18n.t("live_tv_filter_favorites", {}, "Favorites");
        const uncategorizedLabel = I18n.t("live_tv_group_uncategorized", {}, "Uncategorized");
        const chooseCategoryLabel = I18n.t("live_tv_filter_choose_category", {}, "Choose Category");
        return `
        <div class="livetv-search-wrapper">
          <input type="search" class="livetv-search-input focusable" placeholder="${I18n.t("live_tv_search_placeholder", {}, "Search channels...")}" value="${this.searchQuery || ""}" aria-label="${I18n.t("live_tv_search_placeholder", {}, "Search channels")}">
          ${this.searchQuery ? `<button class="livetv-search-clear focusable" data-action="clear-search" aria-label="${I18n.t("action_clear", {}, "Clear")}">\u2715</button>` : ""}
        </div>
        <div class="livetv-filter-bar" role="group" aria-label="${I18n.t("live_tv_filter_label", {}, "Filter channels")}">
          <button class="livetv-filter-chip${this.filterMode === "all" ? " selected" : ""} focusable" data-filter="all" data-action="filter-all">${allLabel}</button>
          <button class="livetv-filter-chip${this.filterMode === "favorites" ? " selected" : ""} focusable" data-filter="favorites" data-action="filter-favorites">${favoritesLabel}</button>
          <div class="livetv-category-dropdown">
            <button class="livetv-filter-chip${this.filterMode === "category" ? " selected" : ""} focusable" data-action="toggle-category-dropdown" aria-expanded="${this.filterMode === "category"}" aria-haspopup="listbox">
              ${this.filterMode === "category" && this.selectedCategoryName ? this.selectedCategoryName : chooseCategoryLabel}
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 10l5 5 5-5z"/></svg>
            </button>
            <div class="livetv-category-dropdown-menu" role="listbox" aria-label="${chooseCategoryLabel}" hidden>
              ${categories.map(
          (cat) => `
                <button class="livetv-category-option focusable" role="option" data-category="${cat.categoryName}" data-action="filter-category" ${cat.categoryName === this.selectedCategoryName ? 'aria-selected="true"' : ""}>
                  ${cat.label}
                </button>
              `
        ).join("")}
            </div>
          </div>
          <span class="livetv-channel-count" aria-live="polite">${this.visibleChannels.length}</span>
        </div>
      `;
      },
      buildCategoryOptions(state3) {
        const allLabel = I18n.t("live_tv_group_all_channels", {}, "All Channels");
        const favoritesLabel = I18n.t("live_tv_filter_favorites", {}, "Favorites");
        const uncategorizedLabel = I18n.t("live_tv_group_uncategorized", {}, "Uncategorized");
        const categories = state3.channels.map((ch) => ch.group?.trim()).filter(Boolean).filter((v, i, a) => a.indexOf(v) === i).filter((cat) => ![allLabel, favoritesLabel, uncategorizedLabel].some((l) => l.equalsIgnoreCase(cat))).sort((a, b) => a.localeCompare(b));
        const options = [
          { label: allLabel, mode: "all", categoryName: null },
          { label: favoritesLabel, mode: "favorites", categoryName: null },
          { label: uncategorizedLabel, mode: "category", categoryName: uncategorizedLabel }
        ];
        categories.forEach((cat) => {
          options.push({ label: cat, mode: "category", categoryName: cat });
        });
        return options;
      },
      renderChannelList(state3) {
        this.visibleChannels = this.filterChannels(state3.channels, state3.favoriteChannelIds);
        this.lastWatchedChannel = state3.lastWatchedChannelId ? state3.channels.find((ch) => ch.id === state3.lastWatchedChannelId) : null;
        let html = "";
        if (this.lastWatchedChannel) {
          const categoryName = this.getCategoryName(this.lastWatchedChannel, I18n.t("live_tv_group_uncategorized", {}, "Uncategorized"));
          const programs = state3.epgPrograms[this.lastWatchedChannel.id] || [];
          const nowMillis = Date.now();
          const currentProgram = programs.find((p) => p.startMillis <= nowMillis && p.endMillis > nowMillis);
          const nextProgram = programs.find((p) => p.startMillis > nowMillis);
          html += `
          <div class="livetv-recent-channel focusable" data-channel-id="${this.lastWatchedChannel.id}" data-action="play-recent" role="listitem" style="display: flex; align-items: center; gap: 16px; padding: 12px 16px; min-height: 72px; background: rgba(255,255,255,0.03); border-radius: 8px; margin-bottom: 16px;">
            <div class="livetv-recent-logo" aria-hidden="true" style="flex: 0 0 56px; width: 56px; height: 56px; border-radius: 8px; overflow: hidden; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center;">
              <img src="${this.lastWatchedChannel.logoUrl || ""}" alt="" onerror="this.src='data:image/svg+xml;base64,PHN2ZyB2aWV3Qm94PSIwIDAgMjQgMjQiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHBhdGggZD0iTTEyIDN2MTAuNTVjLS41OS0uMzQtMS4yNy0uNTUtMi0uNTUtMi4yMSAwLTQgMS43OS00IDRzMS43OSA0IDQgNCA0LTEuNzkgNC00VjdoNHYtNmgtNnoiIGZpbGw9IiM2NjYiLz48L3N2Zz4='" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <div class="livetv-recent-info" style="flex: 1; min-width: 0;">
              <span class="livetv-recent-label">${I18n.t("live_tv_last_watched_title", {}, "Last Watched")}</span>
              <h3 class="livetv-recent-name">${this.lastWatchedChannel.name}</h3>
              <span class="livetv-recent-category">${categoryName}</span>
              ${currentProgram ? `
                <div class="livetv-epg-now-next">
                  <div class="livetv-epg-now">
                    <span class="livetv-epg-now-label">${I18n.t("live_tv_epg_now", {}, "Now")}</span>
                    <span class="livetv-epg-now-title">${currentProgram.title}</span>
                    <div class="livetv-epg-progress" style="--progress: ${((nowMillis - currentProgram.startMillis) / (currentProgram.endMillis - currentProgram.startMillis) * 100).toFixed(1)}%"></div>
                  </div>
                  ${nextProgram ? `
                    <div class="livetv-epg-next">
                      <span class="livetv-epg-next-label">${I18n.t("live_tv_epg_next", {}, "Next")}</span>
                      <span class="livetv-epg-next-time">${this.formatEpgTime(nextProgram.startMillis)}</span>
                      <span class="livetv-epg-next-title">${nextProgram.title}</span>
                    </div>
                  ` : ""}
                </div>
              ` : ""}
            </div>
            <button class="livetv-recent-play focusable" data-action="play-recent" aria-label="${I18n.t("live_tv_button_continue", {}, "Continue Watching")}" style="flex: 0 0 44px; width: 44px; height: 44px; border: none; background: #4ade80; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #0f0f23; transition: all 0.2s;">
              <svg viewBox="0 0 24 24" aria-hidden="true" style="width: 22px; height: 22px; margin-left: 2px;"><path d="M8 5v14l11-7z"/></svg>
            </button>
          </div>
        `;
        }
        html += this.visibleChannels.map((channel) => this.renderChannelCard(channel, state3)).join("");
        return html;
      },
      renderChannelCard(channel, state3) {
        const isFavorite = state3.favoriteChannelIds.has(channel.id);
        const categoryName = this.getCategoryName(channel, I18n.t("live_tv_group_uncategorized", {}, "Uncategorized"));
        const programs = state3.epgPrograms[channel.id] || [];
        const nowMillis = Date.now();
        const currentProgram = programs.find((p) => p.startMillis <= nowMillis && p.endMillis > nowMillis);
        const nextProgram = programs.find((p) => p.startMillis > nowMillis);
        return `
        <div class="livetv-channel-card focusable" data-channel-id="${channel.id}" role="listitem" tabindex="0" style="display: flex; align-items: center; gap: 16px; padding: 12px 16px; min-height: 72px; background: rgba(255,255,255,0.03); border-radius: 8px; margin-bottom: 8px;">
          <div class="livetv-channel-logo" aria-hidden="true" style="flex: 0 0 56px; width: 56px; height: 56px; border-radius: 8px; overflow: hidden; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center;">
            <img src="${channel.logoUrl || ""}" alt="" onerror="this.src='data:image/svg+xml;base64,PHN2ZyB2aWV3Qm94PSIwIDAgMjQgMjQiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHBhdGggZD0iTTEyIDN2MTAuNTVjLS41OS0uMzQtMS4yNy0uNTUtMi0uNTUtMi4yMSAwLTQgMS43OS00IDRzMS43OSA0IDQgNCA0LTEuNzkgNC00VjdoNHYtNmgtNnoiIGZpbGw9IiM2NjYiLz48L3N2Zz4='" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div class="livetv-channel-info" style="flex: 1; min-width: 0;">
            <h3 class="livetv-channel-name" style="margin: 0 0 4px; font-size: 18px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${channel.name}</h3>
            <span class="livetv-channel-category" style="font-size: 14px; color: #aaa;">${categoryName}</span>
            ${currentProgram ? `
              <div class="livetv-epg-now-next" style="margin-top: 8px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                <div class="livetv-epg-now" style="display: flex; align-items: center; gap: 8px; flex: 1; min-width: 200px;">
                  <span class="livetv-epg-now-label" style="font-size: 11px; color: #4ade80; text-transform: uppercase; font-weight: 600;">${I18n.t("live_tv_epg_now", {}, "Now")}</span>
                  <span class="livetv-epg-now-title" style="font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${currentProgram.title}</span>
                  <div class="livetv-epg-progress" style="--progress: ${((nowMillis - currentProgram.startMillis) / (currentProgram.endMillis - currentProgram.startMillis) * 100).toFixed(1)}%; flex: 1; height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; position: relative; overflow: hidden;">
                    <div style="width: ${((nowMillis - currentProgram.startMillis) / (currentProgram.endMillis - currentProgram.startMillis) * 100).toFixed(1)}%; height: 100%; background: #4ade80; border-radius: 2px;"></div>
                  </div>
                </div>
                ${nextProgram ? `
                  <div class="livetv-epg-next" style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: #ccc;">
                    <span class="livetv-epg-next-label" style="font-size: 11px; color: #888; text-transform: uppercase;">${I18n.t("live_tv_epg_next", {}, "Next")}</span>
                    <span class="livetv-epg-next-time" style="color: #888; font-size: 12px;">${this.formatEpgTime(nextProgram.startMillis)}</span>
                    <span class="livetv-epg-next-title" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px;">${nextProgram.title}</span>
                  </div>
                ` : ""}
              </div>
            ` : ""}
          </div>
          <button class="livetv-favorite-btn${isFavorite ? " favorite" : ""} focusable" data-action="toggle-favorite" data-channel-id="${channel.id}" aria-label="${isFavorite ? I18n.t("live_tv_remove_favorite", {}, "Remove from favorites") : I18n.t("live_tv_add_favorite", {}, "Add to favorites")}" aria-pressed="${isFavorite}" style="flex: 0 0 44px; width: 44px; height: 44px; border: none; background: rgba(255,255,255,0.08); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: ${isFavorite ? "#ef4444" : "#888"}; transition: all 0.2s;">
            <svg viewBox="0 0 24 24" aria-hidden="true" style="width: 22px; height: 22px;"><path d="${isFavorite ? "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" : "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"}" fill="${isFavorite ? "currentColor" : "none"}" stroke="${isFavorite ? "none" : "currentColor"}" stroke-width="2"/></svg>
          </button>
          <button class="livetv-play-btn focusable" data-action="play-channel" data-channel-id="${channel.id}" aria-label="${I18n.t("live_tv_button_play", {}, "Play")}" style="flex: 0 0 44px; width: 44px; height: 44px; border: none; background: #4ade80; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #0f0f23; transition: all 0.2s;">
            <svg viewBox="0 0 24 24" aria-hidden="true" style="width: 22px; height: 22px; margin-left: 2px;"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
      `;
      },
      filterChannels(channels, favoriteChannelIds) {
        const query = (this.searchQuery || "").toLowerCase().trim();
        return channels.filter((channel) => {
          if (this.filterMode === "favorites" && !favoriteChannelIds.has(channel.id)) return false;
          if (this.filterMode === "category" && this.selectedCategoryName) {
            const catName = this.getCategoryName(channel, I18n.t("live_tv_group_uncategorized", {}, "Uncategorized"));
            if (catName !== this.selectedCategoryName) return false;
          }
          if (query) {
            const searchText2 = `${channel.name} ${channel.group || ""} ${channel.playlistName || ""}`.toLowerCase();
            if (!searchText2.includes(query)) return false;
          }
          return true;
        }).sort((a, b) => a.name.localeCompare(b.name));
      },
      getCategoryName(channel, uncategorizedLabel) {
        return channel.group?.trim() || uncategorizedLabel;
      },
      formatEpgTime(millis) {
        const date = new Date(millis);
        return `${date.getHours().toString().padStart(2, "0")}:${date.getMinutes().toString().padStart(2, "0")}`;
      },
      bindChannelCards() {
        this.container.querySelectorAll('[data-action="play-channel"]').forEach((btn) => {
          btn.onclick = async (e) => {
            e.stopPropagation();
            const channelId = btn.dataset.channelId;
            const state3 = LiveTvRepository.getUiState();
            const channel = state3.channels.find((c) => c.id === channelId);
            if (channel) await this.playChannel(channel);
          };
        });
        this.container.querySelectorAll('[data-action="play-recent"]').forEach((btn) => {
          btn.onclick = async (e) => {
            e.stopPropagation();
            if (this.lastWatchedChannel) await this.playChannel(this.lastWatchedChannel);
          };
        });
        this.container.querySelectorAll('[data-action="toggle-favorite"]').forEach((btn) => {
          btn.onclick = (e) => {
            e.stopPropagation();
            const channelId = btn.dataset.channelId;
            LiveTvRepository.toggleFavoriteChannel(channelId);
            this.render();
          };
        });
        this.container.querySelectorAll('[data-action="filter-all"]').forEach((btn) => {
          btn.onclick = () => {
            this.filterMode = "all";
            this.selectedCategoryName = null;
            this.render();
          };
        });
        this.container.querySelectorAll('[data-action="filter-favorites"]').forEach((btn) => {
          btn.onclick = () => {
            this.filterMode = "favorites";
            this.selectedCategoryName = null;
            this.render();
          };
        });
        this.container.querySelectorAll('[data-action="toggle-category-dropdown"]').forEach((btn) => {
          btn.onclick = () => {
            const menu = btn.nextElementSibling;
            const expanded = menu.hidden = !menu.hidden;
            btn.setAttribute("aria-expanded", expanded);
          };
        });
        this.container.querySelectorAll('[data-action="filter-category"]').forEach((btn) => {
          btn.onclick = () => {
            this.filterMode = "category";
            this.selectedCategoryName = btn.dataset.category;
            this.render();
          };
        });
        const searchInput = this.container.querySelector(".livetv-search-input");
        if (searchInput) {
          searchInput.oninput = (e) => {
            this.searchQuery = e.target.value;
            this.render();
          };
          searchInput.onkeydown = (e) => {
            if (e.key === "Escape") {
              this.searchQuery = "";
              this.render();
            }
          };
        }
        this.container.querySelectorAll('[data-action="clear-search"]').forEach((btn) => {
          btn.onclick = () => {
            this.searchQuery = "";
            this.render();
          };
        });
        this.container.querySelectorAll('[data-action="gotoSettings"]').forEach((btn) => {
          btn.onclick = (e) => {
            console.log("[DEBUG] Content gotoSettings onclick:", {
              isConnected: btn.isConnected,
              inContainer: this.container?.contains(btn)
            });
            Router.navigate("settings");
          };
        });
      },
      async playChannel(channel) {
        const preparedChannel = await LiveTvRepository.prepareForPlayback(channel);
        LiveTvRepository.markChannelWatched(preparedChannel);
        if (this.unsubscribeRepo) {
          this.unsubscribeRepo();
          this.unsubscribeRepo = null;
        }
        this.closeSidebarToContent();
        Router.navigate("player", {
          streamUrl: preparedChannel.streamUrl,
          itemId: preparedChannel.id,
          itemType: "livetv",
          imdbId: null,
          tmdbId: null,
          traktId: null,
          contentLanguage: null,
          videoId: null,
          resumePositionMs: 0,
          resumeProgressPercent: null,
          resumeDurationMs: 0,
          startFromBeginning: true,
          playerTitle: preparedChannel.name,
          playerSubtitle: "",
          playerEpisodeTitle: "",
          playerReleaseYear: "",
          playerBackdropUrl: null,
          playerLogoUrl: preparedChannel.logoUrl,
          parentalWarnings: null,
          parentalGuide: null,
          season: null,
          episode: null,
          episodes: [],
          streamCandidates: [
            {
              id: "livetv-" + preparedChannel.id,
              url: preparedChannel.streamUrl,
              title: preparedChannel.name,
              addonName: "Live TV",
              isSynthetic: true,
              headers: preparedChannel.headers,
              streamType: preparedChannel.streamType
            }
          ],
          preferredStreamId: "livetv-" + preparedChannel.id,
          playbackSourceContext: {
            addonId: "livetv",
            addonBaseUrl: "",
            addonName: "Live TV",
            addonOrderIndex: 0,
            sourceProviderId: "livetv",
            sourceIds: [],
            selectedStreamId: "livetv-" + preparedChannel.id
          },
          returnToStreamOnBack: false,
          streamRouteParams: null,
          fromDetailRoute: false
        });
      }
    };
  }

  // js/ui/screens/livetv/liveTvScreenMethods-03-load-data.js
  function createLiveTvScreenMethods03() {
    return {
      async loadData() {
        this._hasFocusedContent = false;
        await LiveTvRepository.ensureChannelsLoaded();
        this.unsubscribeRepo = LiveTvRepository.subscribe(() => {
          if (this.isMounted && this.container && this.container.isConnected) {
            const state3 = LiveTvRepository.getUiState();
            this.render();
            if (!this._hasFocusedContent && state3.channels && state3.channels.length > 0) {
              this._hasFocusedContent = true;
              requestAnimationFrame(() => this.applyFocus());
            }
          }
        });
      }
    };
  }

  // js/ui/screens/livetv/liveTvScreenMethods-04-handle-key-down.js
  function createLiveTvScreenMethods04() {
    return {
      onKeyDown(event) {
        const keyCode = event.keyCode || 0;
        const focusedNode = document.activeElement;
        if (isRootSidebarNode(focusedNode)) {
          if (keyCode === 37) {
            event.preventDefault();
            this.closeSidebarToContent();
            return true;
          }
          if (keyCode === 39) {
            event.preventDefault();
            this.closeSidebarToContent();
            return true;
          }
        }
        const searchInput = this.container?.querySelector(".livetv-search-input");
        if (searchInput && searchInput === focusedNode) {
          if (keyCode === 27) {
            event.preventDefault();
            this.searchQuery = "";
            this.render();
            return true;
          }
          return false;
        }
        const dropdownOpen = this.container?.querySelector(".livetv-category-dropdown-menu:not([hidden])");
        if (dropdownOpen) {
          if (keyCode === 27) {
            event.preventDefault();
            const toggleBtn = this.container.querySelector('[data-action="toggle-category-dropdown"]');
            dropdownOpen.hidden = true;
            toggleBtn?.setAttribute("aria-expanded", "false");
            toggleBtn?.focus();
            return true;
          }
          if (keyCode === 40 || keyCode === 38) {
            event.preventDefault();
            const options = dropdownOpen.querySelectorAll(".livetv-category-option");
            const currentIndex = Array.from(options).findIndex((o) => o === focusedNode);
            let nextIndex = currentIndex;
            if (keyCode === 40) nextIndex = Math.min(options.length - 1, currentIndex + 1);
            if (keyCode === 38) nextIndex = Math.max(0, currentIndex - 1);
            if (nextIndex !== currentIndex) {
              options[nextIndex]?.focus();
            }
            return true;
          }
          if (keyCode === 13) {
            event.preventDefault();
            focusedNode?.click();
            return true;
          }
        }
        const channelCards = this.container?.querySelectorAll(".livetv-channel-card, .livetv-recent-channel");
        if (channelCards.length > 0) {
          const currentIndex = Array.from(channelCards).findIndex((c) => c === focusedNode || c.contains(focusedNode));
          if (currentIndex >= 0) {
            if (keyCode === 40) {
              event.preventDefault();
              const nextIndex = Math.min(channelCards.length - 1, currentIndex + 1);
              channelCards[nextIndex]?.focus();
              return true;
            }
            if (keyCode === 38) {
              event.preventDefault();
              const prevIndex = Math.max(0, currentIndex - 1);
              channelCards[prevIndex]?.focus();
              return true;
            }
            if (keyCode === 39) {
              event.preventDefault();
              const card = channelCards[currentIndex];
              const playBtn = card.querySelector(".livetv-play-btn");
              playBtn?.focus();
              return true;
            }
            if (keyCode === 13 || keyCode === 32) {
              event.preventDefault();
              const card = channelCards[currentIndex];
              const playBtn = card.querySelector('[data-action="play-channel"], [data-action="play-recent"]');
              playBtn?.click();
              return true;
            }
          }
        }
        const actionBtns = this.container?.querySelectorAll(".livetv-favorite-btn, .livetv-play-btn, .livetv-recent-play");
        if (actionBtns.length > 0) {
          const currentIndex = Array.from(actionBtns).findIndex((b) => b === focusedNode);
          if (currentIndex >= 0) {
            if (keyCode === 37) {
              event.preventDefault();
              const btn = actionBtns[currentIndex];
              const card = btn.closest(".livetv-channel-card, .livetv-recent-channel");
              card?.focus();
              return true;
            }
            if (keyCode === 40 || keyCode === 38) {
              event.preventDefault();
              let nextIndex = currentIndex;
              if (keyCode === 40) nextIndex = Math.min(actionBtns.length - 1, currentIndex + 1);
              if (keyCode === 38) nextIndex = Math.max(0, currentIndex - 1);
              if (nextIndex !== currentIndex) {
                actionBtns[nextIndex]?.focus();
              }
              return true;
            }
          }
        }
        const filterChips = this.container?.querySelectorAll(".livetv-filter-chip");
        if (filterChips.length > 0) {
          const currentIndex = Array.from(filterChips).findIndex((c) => c === focusedNode);
          if (currentIndex >= 0) {
            if (keyCode === 39) {
              event.preventDefault();
              const nextIndex = Math.min(filterChips.length - 1, currentIndex + 1);
              filterChips[nextIndex]?.focus();
              return true;
            }
            if (keyCode === 37) {
              event.preventDefault();
              const prevIndex = Math.max(0, currentIndex - 1);
              filterChips[prevIndex]?.focus();
              return true;
            }
          }
        }
        return false;
      }
    };
  }

  // js/ui/screens/livetv/liveTvScreenMethods-05-cleanup.js
  function createLiveTvScreenMethods05() {
    return {
      cleanup() {
        this.isMounted = false;
        if (this.unsubscribeRepo) {
          this.unsubscribeRepo();
          this.unsubscribeRepo = null;
        }
        this.container = null;
        this.focusZone = null;
        this.sidebarFocusIndex = 0;
        this.searchQuery = "";
        this.filterMode = "all";
        this.selectedCategoryName = null;
        this.visibleChannels = [];
        this.lastWatchedChannel = null;
      }
    };
  }

  // js/ui/screens/livetv/liveTvScreenMethods-06-focus-node.js
  function createLiveTvScreenMethods06() {
    return {
      applyFocus() {
        console.log("[LiveTvScreen] applyFocus called, focusZone:", this.focusZone, "hasFocusedContent:", this._hasFocusedContent);
        const focusables = this.getFocusableNodes();
        if (focusables.length === 0) {
          console.log("[LiveTvScreen] applyFocus: no focusables");
          return;
        }
        const connectedFocusables = focusables.filter((node) => node.isConnected && this.container?.contains(node));
        console.log("[LiveTvScreen] applyFocus: focusables:", focusables.length, "connected:", connectedFocusables.length);
        if (connectedFocusables.length === 0) return;
        let targetIndex = Math.min(this.sidebarFocusIndex, connectedFocusables.length - 1);
        const target = connectedFocusables[targetIndex];
        if (target) {
          console.log("[LiveTvScreen] applyFocus: focusing", target.className, target.dataset?.action);
          target.focus();
          focusWithoutAutoScroll(target);
        }
      },
      getFocusableNodes() {
        if (!this.container) return [];
        const focusZone = this.focusZone || "content";
        if (focusZone === "sidebar") {
          return Array.from(this.container.querySelectorAll(".home-sidebar .focusable, .modern-sidebar-panel .focusable"));
        }
        const contentRoot = this.container.querySelector(".livetv-content") || this.container;
        const channelCards = Array.from(contentRoot.querySelectorAll(".livetv-channel-card"));
        const recentChannels = Array.from(contentRoot.querySelectorAll(".livetv-recent-channel"));
        const otherFocusables = Array.from(
          contentRoot.querySelectorAll(
            '.livetv-favorite-btn, .livetv-play-btn, .livetv-recent-play, .livetv-filter-chip, .livetv-search-input, [data-action="refresh"]:not(.home-nav-item), [data-action="gotoSettings"]:not(.home-nav-item)'
          )
        );
        return [...channelCards, ...recentChannels, ...otherFocusables];
      },
      focusSidebarNode() {
        this.focusZone = "sidebar";
        const sidebarNodes = this.container?.querySelectorAll(".home-sidebar .focusable, .modern-sidebar-panel .focusable");
        if (sidebarNodes?.length) {
          this.sidebarFocusIndex = Math.min(this.sidebarFocusIndex, sidebarNodes.length - 1);
          this.applyFocus();
        }
      },
      focusContentNode() {
        console.log("[LiveTvScreen] focusContentNode called");
        this.focusZone = "content";
        this.applyFocus();
      }
    };
  }

  // js/ui/screens/livetv/liveTvScreenMethods-07-on-sidebar-reselect.js
  function createLiveTvScreenMethods07() {
    return {
      onSidebarReselect() {
        const channelList = this.container?.querySelector(".livetv-channel-list");
        if (channelList) {
          channelList.scrollTop = 0;
        }
        const firstChannel = this.container?.querySelector(".livetv-channel-card, .livetv-recent-channel");
        firstChannel?.focus();
      }
    };
  }

  // js/ui/screens/livetv/liveTvScreenMethods-08-mount.js
  init_localStore();
  function createLiveTvScreenMethods08() {
    return {
      async mount(params, navigationContext) {
        console.log("[LiveTvScreen] mount() start");
        try {
          this.container = document.getElementById("livetv");
          if (!this.container) {
            console.error("[LiveTvScreen] No container found!");
            return;
          }
          ScreenUtils.show(this.container);
          this.focusZone = "content";
          this.sidebarFocusIndex = 0;
          this.searchQuery = "";
          this.filterMode = "all";
          this.selectedCategoryName = null;
          this.visibleChannels = [];
          this.lastWatchedChannel = null;
          this.isMounted = true;
          this.routeStateKey = this.getRouteStateKey();
          console.log("[LiveTvScreen] calling loadData()");
          await this.loadData();
          console.log("[LiveTvScreen] loadData() done");
          this.render();
          const isModern = LocalStore.get("modernSidebar", false);
          if (isModern) {
            setModernSidebarExpanded(this.container, false);
            setModernSidebarPillIconOnly(this.container, false);
          } else {
            setLegacySidebarExpanded(this.container, false);
          }
          const state3 = LiveTvRepository.getUiState();
          if (state3.channels && state3.channels.length > 0 && !this._hasFocusedContent) {
            this._hasFocusedContent = true;
            requestAnimationFrame(() => this.applyFocus());
          }
          console.log("[LiveTvScreen] mount() complete");
        } catch (e) {
          console.error("[LiveTvScreen] mount error:", e);
        }
      },
      async unmount() {
        console.log("[LiveTvScreen] unmount()");
        this.isMounted = false;
        if (this.unsubscribeRepo) {
          this.unsubscribeRepo();
          this.unsubscribeRepo = null;
        }
        this.cleanup();
      }
    };
  }

  // js/ui/screens/livetv/liveTvScreenMethods-09-sidebar.js
  init_localStore();
  function createLiveTvScreenMethods09() {
    return {
      onSelectedAction(node) {
        const action = node?.dataset?.action || "";
        const currentRoute = Router?.getCurrent?.() || "";
        if (action === "gotoLiveTv" && currentRoute === "livetv") {
          return;
        }
        this.closeSidebarToContent();
      },
      onExpandSidebar() {
        this.openSidebar();
      },
      closeSidebarToContent() {
        const isModern = LocalStore.get("modernSidebar", false);
        if (isModern) {
          setModernSidebarExpanded(this.container, false);
          setModernSidebarPillIconOnly(this.container, false);
        } else {
          setLegacySidebarExpanded(this.container, false);
        }
        const state3 = LiveTvRepository.getUiState();
        if (state3.channels && state3.channels.length > 0) {
          requestAnimationFrame(() => this.focusContentNode());
        }
      },
      openSidebar() {
        const isModern = LocalStore.get("modernSidebar", false);
        if (isModern) {
          setModernSidebarExpanded(this.container, true);
        } else {
          setLegacySidebarExpanded(this.container, true);
        }
        this.focusSidebarNode();
      }
    };
  }

  // js/ui/screens/livetv/liveTvScreenMethods-10-nav-model.js
  function getDirectionFromKeyCode2(keyCode) {
    switch (Number(keyCode || 0)) {
      case 37:
        return "left";
      case 38:
        return "up";
      case 39:
        return "right";
      case 40:
        return "down";
      default:
        return null;
    }
  }
  function createLiveTvScreenMethods10() {
    return {
      getDirectionalRepeatThrottleMs(direction) {
        if (direction === "up" || direction === "down") {
          return 140;
        }
        return 120;
      },
      buildNavModel() {
        const sidebar = this.container?.querySelector(".home-sidebar .focusable, .modern-sidebar-panel .focusable") ? Array.from(this.container.querySelectorAll(".home-sidebar .focusable, .modern-sidebar-panel .focusable")) : [];
        const contentRoot = this.container?.querySelector(".livetv-content") || this.container;
        const channelCards = Array.from(contentRoot.querySelectorAll(".livetv-channel-card"));
        const recentChannels = Array.from(contentRoot.querySelectorAll(".livetv-recent-channel"));
        const filterChips = Array.from(contentRoot.querySelectorAll(".livetv-filter-chip"));
        const searchInput = contentRoot.querySelector(".livetv-search-input");
        const actionBtns = Array.from(contentRoot.querySelectorAll(".livetv-favorite-btn, .livetv-play-btn, .livetv-recent-play"));
        const refreshBtn = contentRoot.querySelector('[data-action="refresh"]:not(.home-nav-item)');
        const gotoSettingsBtn = contentRoot.querySelector('[data-action="gotoSettings"]:not(.home-nav-item)');
        const rows = [];
        if (filterChips.length) rows.push(filterChips);
        if (searchInput) rows.push([searchInput]);
        if (channelCards.length) rows.push(channelCards);
        if (recentChannels.length) rows.push(recentChannels);
        const actionRow = [];
        if (actionBtns.length) actionRow.push(...actionBtns);
        if (refreshBtn) actionRow.push(refreshBtn);
        if (gotoSettingsBtn) actionRow.push(gotoSettingsBtn);
        if (actionRow.length) rows.push(actionRow);
        sidebar.forEach((node, index) => {
          node.dataset.navZone = "sidebar";
          node.dataset.navIndex = String(index);
        });
        rows.forEach((rowNodes, rowIndex) => {
          rowNodes.forEach((node, colIndex) => {
            node.dataset.navZone = "main";
            node.dataset.navRow = String(rowIndex);
            node.dataset.navCol = String(colIndex);
          });
        });
        this.navModel = { sidebar, rows };
        if (!this.lastMainFocus || !this.container?.contains(this.lastMainFocus)) {
          this.lastMainFocus = rows[0]?.[0] || null;
        }
      },
      isSidebarNode(node) {
        return node?.dataset?.navZone === "sidebar";
      },
      isMainNode(node) {
        return node?.dataset?.navZone === "main";
      },
      getCurrentFocusedNode() {
        return this.container?.querySelector(".focusable.focused") || document.activeElement;
      },
      focusWithoutAutoScroll(node, options = {}) {
        try {
          node.focus({ preventScroll: true });
        } catch (_) {
          try {
            node.focus();
          } catch (_2) {
          }
        }
      },
      focusNode(current2, target, direction = null, inputMeta = null) {
        if (!current2 || !target || current2 === target) return false;
        current2.classList.remove("focused");
        target.classList.add("focused");
        this.focusWithoutAutoScroll(target, { suppressDelegatedFocus: true });
        if (this.isMainNode(target)) {
          this.lastMainFocus = target;
        }
        return true;
      },
      handleLiveTvDpad(event) {
        const keyCode = Number(event?.keyCode || 0);
        const direction = getDirectionFromKeyCode2(keyCode);
        if (!direction) return false;
        const nav = this.navModel;
        if (!nav) return false;
        let current2 = this.getCurrentFocusedNode();
        if (!current2) return false;
        const isSidebar = this.isSidebarNode(current2);
        if (typeof event?.preventDefault === "function") {
          event.preventDefault();
        }
        const inputMeta = { repeat: Boolean(event?.repeat) };
        if (inputMeta.repeat && !isSidebar && (direction === "up" || direction === "down")) {
          const now3 = Date.now();
          const repeatThrottleMs = this.getDirectionalRepeatThrottleMs(direction);
          const repeatTimes = this.lastDirectionalKeyAtByDirection || (this.lastDirectionalKeyAtByDirection = {});
          const lastDirectionalKeyAt = Number(repeatTimes[direction] || 0);
          if (lastDirectionalKeyAt > 0 && now3 - lastDirectionalKeyAt < repeatThrottleMs) {
            return true;
          }
          repeatTimes[direction] = now3;
        }
        if (isSidebar) {
          const sidebarIndex = Number(current2.dataset.navIndex || 0);
          if (direction === "up") {
            const target = nav.sidebar[Math.max(0, sidebarIndex - 1)] || current2;
            return this.focusNode(current2, target, direction, inputMeta) || true;
          }
          if (direction === "down") {
            const target = nav.sidebar[Math.min(nav.sidebar.length - 1, sidebarIndex + 1)] || current2;
            return this.focusNode(current2, target, direction, inputMeta) || true;
          }
          if (direction === "right") {
            return this.closeSidebarToContent() || true;
          }
          return true;
        }
        const row = Number(current2.dataset.navRow || 0);
        const col = Number(current2.dataset.navCol || 0);
        const rowNodes = nav.rows[row] || [];
        if (direction === "left") {
          const targetInRow = rowNodes[col - 1] || null;
          if (this.focusNode(current2, targetInRow, direction, inputMeta)) return true;
          const sidebarFallback = nav.sidebar[0] || null;
          return this.focusNode(current2, sidebarFallback, direction, inputMeta) || true;
        }
        if (direction === "right") {
          const target = rowNodes[col + 1] || null;
