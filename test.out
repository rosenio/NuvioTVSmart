            label: `${item.label} (${item.count})`
          }))
        ];
      }
      if (picker === "watched") {
        return [
          {
            value: LIBRARY_WATCHED_FILTER.ALL,
            label: t10("library_watched_filter_all", {}, "All")
          },
          {
            value: LIBRARY_WATCHED_FILTER.WATCHED,
            label: t10("library_watched_filter_watched", {}, "Watched")
          },
          {
            value: LIBRARY_WATCHED_FILTER.UNWATCHED,
            label: t10("library_watched_filter_unwatched", {}, "Unwatched")
          }
