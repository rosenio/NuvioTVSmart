  // js/ui/screens/detail/metaDetailsScreenMethods-21-consume-back-request.js
  function createMetaDetailsScreenMethods21() {
    const {
      Router: Router2,
      ScreenUtils: ScreenUtils2,
      resolveMovieStreamIdentity: resolveMovieStreamIdentity2,
      StreamPreferencesStore: StreamPreferencesStore2,
      resolvePlayableDetailType: resolvePlayableDetailType2,
