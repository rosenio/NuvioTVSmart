    } = metaDetailsScreenContext_exports;
    const PREVIEW_RAIL_WINDOW = 24;
    const COMMENTS_WINDOW = 12;
    const RAIL_EXTEND_AHEAD = 6;
    return {
      openSynopsis() {
        if (this.synopsisDialog) return;
        const text5 = document.createElement("div");
        text5.className = "detail-synopsis-full-text";
