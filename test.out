  }
  function formatPlaybackTime2(milliseconds) {
    const total = Math.max(0, Math.floor(Number(milliseconds || 0) / 1e3));
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor(total % 3600 / 60);
    const seconds = total % 60;
    const pad2 = (value) => String(value).padStart(2, "0");
    return hours > 0 ? `${hours}:${pad2(minutes)}:${pad2(seconds)}` : `${pad2(minutes)}:${pad2(seconds)}`;
  }
  function formatPlayerTime(milliseconds) {
    const millis = Number(milliseconds || 0);
    if (millis <= 0) return "0:00";
    const total = Math.floor(millis / 1e3);
    const hours = Math.floor(total / 3600);
    const minutes = Math.floor(total % 3600 / 60);
    const seconds = total % 60;
    const pad2 = (value) => String(value).padStart(2, "0");
    return hours > 0 ? `${hours}:${pad2(minutes)}:${pad2(seconds)}` : `${minutes}:${pad2(seconds)}`;
  }
  function formatSpeedLabel(rate) {
