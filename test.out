        if (isBackEvent9(event)) {
          event?.preventDefault?.();
          if (!this.navigateBackFromStream()) {
            Router2.back();
          }
          return;
        }
        const direction = getDpadDirection3(event);
        if (direction && event?.repeat) {
          const now3 = Date.now();
          const lastRepeatAt = Number(this.streamLastNavigationRepeatAt || 0);
          if (now3 - lastRepeatAt < STREAM_DPAD_REPEAT_THROTTLE_MS2) {
            event?.preventDefault?.();
