          const fileLabel = playableFiles.length === 0 ? t31("cloud_library_no_playable_files", {}, "No playable files") : playableFiles.length === 1 ? t31("cloud_library_one_playable_file", {}, "1 playable file") : t31("cloud_library_playable_file_count", { count: playableFiles.length }, `${playableFiles.length} playable files`);
          const metadata = [
