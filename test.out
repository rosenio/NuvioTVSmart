                ${date ? `<div class="player-episode-date">${escapeHtml31(date)}</div>` : ""}
                <div class="player-episode-item-subtitle" dir="${contentTextDirection2(episode.overview || "")}">${escapeHtml31(episode.overview || "")}</div>
              </div>
