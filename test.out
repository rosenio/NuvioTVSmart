  // js/ui/screens/settings/settingsScreenPlaybackMarkup-06-section.js
  function renderPlaybackSectionMarkup(model) {
    const { TorrentSettingsStore: TorrentSettingsStore2, Platform: Platform2, TizenCapabilities: TizenCapabilities2, SECTION_META: SECTION_META2, t: t31 } = settingsScreenContext_exports;
    const expanded = this.expandedSections.playback;
