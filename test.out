      },
      renderCompanyLogosSection(rawCompanies = [], title = "Studios", entityKind = "company") {
        const toLogo = (logo) => {
          const value = String(logo || "").trim();
          if (!value) {
            return "";
          }
          if (value.startsWith("http://") || value.startsWith("https://")) {
            return value;
          }
