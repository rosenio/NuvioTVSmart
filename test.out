        [LIBRARY_WATCHED_FILTER.WATCHED]: t10("library_watched_filter_watched", {}, "Watched"),
        [LIBRARY_WATCHED_FILTER.UNWATCHED]: t10("library_watched_filter_unwatched", {}, "Unwatched")
      };
      return labels[this.state.selectedWatchedFilter] || labels[LIBRARY_WATCHED_FILTER.ALL];
    }
    getEmptyStateTitle() {
