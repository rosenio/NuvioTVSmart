      return removable ? `<button class="party-row party-member-row focusable" data-party-action="remove" data-member-id="${escapeHtml5(member.id)}" aria-label="${escapeHtml5(t5("party_remove"))}">${content}</button>` : `<div class="party-row party-member-row is-static">${content}</div>`;
    }).join("");
