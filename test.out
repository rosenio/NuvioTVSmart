  // js/ui/screens/library/libraryScreenMethods-04-render.js
  function createLibraryScreenMethods04() {
    const {
      Router: Router2,
      ScreenUtils: ScreenUtils2,
      LayoutPreferences: LayoutPreferences2,
      PosterOptionsDialogController: PosterOptionsDialogController2,
      posterItemFromNode: posterItemFromNode2,
      bindRootSidebarEvents: bindRootSidebarEvents2,
      getRootSidebarNodes: getRootSidebarNodes2,
      getRootSidebarSelectedNode: getRootSidebarSelectedNode2,
      setLegacySidebarExpanded: setLegacySidebarExpanded2,
      POSTER_HOLD_DELAY_MS: POSTER_HOLD_DELAY_MS8,
      escapeHtml: escapeHtml31,
      t: t31,
      selectorValue: selectorValue2
    } = libraryScreen_exports;
    return {
      render() {
        this.cancelScheduledRender();
        this.layoutPrefs = LayoutPreferences2.get();
        this.sidebarExpanded = Boolean(this.layoutPrefs?.modernSidebar && this.sidebarExpanded);
        const state3 = this.controller.getState();
        const expandedPicker = state3.expandedPicker || null;
        if (this.lastRenderedExpandedPicker && this.lastRenderedExpandedPicker !== expandedPicker) {
          this.startClosingPicker(this.lastRenderedExpandedPicker);
        }
        if (expandedPicker && this.closingPicker === expandedPicker) {
          this.clearClosingPicker();
        }
        this.lastRenderedExpandedPicker = expandedPicker;
        const posterWidth = 252;
        const posterRadius = 24;
        const libraryStyle = `--library-poster-width:${posterWidth}px;--library-poster-height:${Math.round(posterWidth * 1.5)}px;--library-poster-radius:${posterRadius}px;`;
        const hasLibraryItems = Array.isArray(state3.allItems) && state3.allItems.length > 0;
        if (state3.viewMode !== "servers" && (state3.isLoading || state3.isSyncing && !hasLibraryItems)) {
          this.renderLoading();
          ScreenUtils2.indexFocusables(this.container);
          if (!this.layoutPrefs?.modernSidebar) {
            setLegacySidebarExpanded2(this.container, false);
          }
          return;
        }
        this.container.innerHTML = `
          <div class="home-shell library-shell${this.libraryRouteEnterPending ? " library-route-enter" : ""}" style="${escapeHtml31(libraryStyle)}">
            ${this.renderSidebar()}
            <main class="home-main library-main">
              <section class="library-page">
                <header class="library-page-header">
                  <h1 class="library-page-title">${escapeHtml31(t31("library_title", {}, "Library"))}</h1>
                  <div class="library-page-source" id="libraryPageSource">${escapeHtml31(this.controller.getSourceLabel())}</div>
