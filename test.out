            ${this.episodePanelStreamsError ? `<div class="player-episode-stream-empty">${escapeHtml31(this.episodePanelStreamsError)}</div>` : ""}
            ${!this.episodePanelStreamsLoading && !this.episodePanelStreamsError && !streams.length ? `<div class="player-episode-stream-empty">${escapeHtml31(t31("episodes_panel_no_streams", {}, "No streams found"))}</div>` : streams.map((stream, index) => {
          const focused = focus.zone === "streams" && focus.index === index;
