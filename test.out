    const label = t5("party_episode_format", [media.season, media.episode]);
    return media.title ? `${media.title} \xB7 ${label}` : label;
  }
  function presenceOf(party, member) {
    return party.presence[member.id] || (member.id === party.memberId ? {
      member_id: member.id,
      status: PartyMemberStatus.Browsing,
      media_key: null,
      behind_ms: null
    } : null);
  }
  function presenceState(party, member) {
    const presence = presenceOf(party, member);
    if (!presence) return PartyPresenceState.Offline;
    if (presence.media_key !== party.mediaKey) return PartyPresenceState.Away;
    switch (presence.status) {
      case PartyMemberStatus.Ready:
        return PartyPresenceState.Watching;
      case PartyMemberStatus.Loading:
      case PartyMemberStatus.Buffering:
        return PartyPresenceState.Busy;
      default:
        return PartyPresenceState.Away;
    }
  }
  function memberBehindMs(party, member) {
    const presence = presenceOf(party, member);
    if (!presence || presence.status !== PartyMemberStatus.Behind || presence.media_key !== party.mediaKey)
      return null;
    return presence.behind_ms ?? 0;
  }
  function memberStatusText(party, member) {
    const presence = presenceOf(party, member);
    if (!presence) return t5("party_status_offline");
    if (presence.media_key !== party.mediaKey) {
      return presence.status === PartyMemberStatus.Browsing ? t5("party_status_choosing") : t5("party_status_elsewhere");
    }
    switch (presence.status) {
      case PartyMemberStatus.Ready:
      case PartyMemberStatus.Behind:
        return t5("party_status_ready");
      case PartyMemberStatus.Buffering:
        return t5("party_status_buffering");
