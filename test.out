              if (chips.length) {
                const nextIndex = clamp7(index + (direction === "left" ? -1 : 1), 0, chips.length - 1);
                const target = chips[nextIndex];
                if (target?.dataset.action === "refreshStreams") {
                  this.focusState = { zone: "filter", index: nextIndex };
                  this.applyFocus();
