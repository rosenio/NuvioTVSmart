    if (response?.ok && accessToken) {
      return { status: DEBRID_DEVICE_AUTH_STATUS.AUTHORIZED, accessToken };
    }
    const error = textValue(data.error).toLowerCase();
    if (error === "authorization_pending" || error === "slow_down") {
