          return true;
        }
        return false;
      },
      async onKeyDown(event) {
        const code = Number(event?.keyCode || 0);
        const key3 = String(event?.key || "");
        if (Platform2.isBackEvent(event) || code === 27 || key3 === "Escape" || key3 === "Esc" || key3 === "Backspace") {
          event?.preventDefault?.();
          return this.handleBack();
        }
        const direction = code === 37 ? "left" : code === 38 ? "up" : code === 39 ? "right" : code === 40 ? "down" : null;
        if (direction) {
          event?.preventDefault?.();
          const nodes = visibleFocusableNodes2(this.dialog ? this.container.querySelector(".supporters-dialog") : this.container);
          const current3 = this.container.querySelector(".focusable.focused") || nodes[0];
          const target = this.getDirectionalTarget(current3, direction);
          if (target) {
            this.focusTarget(target);
            if (target.dataset.action === "selectTab" && target.dataset.tab !== this.selectedTab) {
              await this.selectTab(String(target.dataset.tab || DEFAULT_TAB2), { focus: true });
            }
          }
          return;
        }
        const isActivate = code === 13 || code === 23 || ["Enter", "NumpadEnter", "OK", "Select"].includes(String(event?.key || ""));
        if (!isActivate) return;
        event?.preventDefault?.();
        const current2 = this.container.querySelector(".focusable.focused");
        await this.activateTarget(current2);
      },
      consumeBackRequest() {
        if (!this.dialog && !this.showMembershipQr) {
          return false;
        }
        void this.handleBack();
        return true;
      },
      async handleBack() {
        if (this.dialog) {
          const returnFocusKey = this.dialog.returnFocusKey;
          this.dialog = null;
          this.focusKey = returnFocusKey || `tab:${this.selectedTab}`;
          this.preserveListScrollAfterFocus = true;
          await this.render();
