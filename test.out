  }
  function registerMdbListAccountActions() {
    this.actionMap.set("integration:mdblist:account", () => {
      if (!MdbListAccount.connected()) {
        openMdbListAuthorization.call(this);
        return;
      }
      const scope = MdbListAccount.scope();
      this.openOptionDialog({
        title: "MDBList",
        message: t16("mdblist_tracking_description") + (MdbListTracking.getSnapshot().checkedAt ? ` \xB7 ${t16("mdblist_last_synced", [new Date(MdbListTracking.getSnapshot().checkedAt).toLocaleString()])}` : ""),
        options: [
          { id: "sync", label: t16("simkl_sync_now") },
          { id: "disconnect", label: t16("debrid_disconnect") },
          { id: "cancel", label: t16("common.cancel") }
        ],
        returnFocusKey: "integration:mdblist:account",
        onSelect: async (option) => {
          if (option.id === "sync") {
            MdbListAccount.check(scope);
