    return `
    <span class="party-seats-hero party-seats-hero-${size}">
      ${avatarMarkup({ name: profile2?.name, imageUrl: profile2?.imageUrl, color: profile2?.color }, { size, ring: "hero" })}
      ${openSeatMarkup(size)}${openSeatMarkup(size)}
    </span>`;
  }
  function codeSlotsMarkup(code, { activeIndex = null, size = "md" } = {}) {
    const value = String(code || "");
    let slots = "";
    for (let index = 0; index < PARTY_CODE_LENGTH; index += 1) {
      const character = value[index] || "";
      const active3 = index === activeIndex;
      slots += `
      <span class="party-code-slot${active3 ? " is-active" : ""}${character ? " is-filled" : ""}">
        <span class="party-code-char">${character ? escapeHtml5(character) : active3 ? '<span class="party-code-caret"></span>' : ""}</span>
        <span class="party-code-line"></span>
      </span>`;
    }
    return `<div class="party-code-slots party-code-slots-${size}" dir="ltr" aria-label="${escapeHtml5(formatPartyCode(value))}">${slots}</div>`;
  }
  function codeSectionMarkup(party, size = "md") {
    const label = party.connected ? `<span class="party-code-label">${escapeHtml5(t5("party_code_label"))}</span>` : `<span class="party-code-label is-reconnecting"><span class="party-pulsing-dot"></span>${escapeHtml5(t5("party_reconnecting"))}</span>`;
    return `<div class="party-code-section">${label}${codeSlotsMarkup(party.code, { size })}</div>`;
