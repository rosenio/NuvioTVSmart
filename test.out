          const index = Number(target.dataset.itemIndex || 0);
          const item = this.state?.[tab]?.items?.[index];
          if (item) {
            this.dialog = { type: tab, item, returnFocusKey: this.focusKey, showSupportQr: false };
            this.focusKey = "dialog:primary";
