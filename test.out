      const nonTextFocusables = enabledFocusables.filter(
        (node) => !node.matches?.("input, textarea")
      );
      if (!enabledFocusables.length) return;
      const target = enabledFocusables.find((node) => node.dataset.focusKey === this.focusKey) || nonTextFocusables[0] || enabledFocusables[0];
