        }
        const modeButtons = isSeriesDetailMeta2(this.meta, this.episodes) ? `<div class="detail-comments-modes">
              <button class="detail-comments-mode focusable${this.commentsMode !== "episode" ? " selected" : ""}" data-action="setCommentsMode" data-comments-mode="title">${escapeHtml31(t31("detail_comments_mode_show", {}, "Show"))}</button>
              <button class="detail-comments-mode focusable${this.commentsMode === "episode" ? " selected" : ""}" data-action="setCommentsMode" data-comments-mode="episode">${escapeHtml31(this.commentsEpisodeTarget ? `S${this.commentsEpisodeTarget.season}E${this.commentsEpisodeTarget.episode}` : t31("detail_comments_mode_episode", {}, "Episode"))}</button>
            </div>` : "";
        const subtitle = this.commentsMode === "episode" && this.commentsEpisodeTarget ? t31(
          "detail_comments_subtitle_episode",
