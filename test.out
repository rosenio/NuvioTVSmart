  // js/ui/screens/settings/settingsIntegrationDetailDebridState.js
  function createDebridIntegrationState(model) {
    const { normalizeDebridStreamPreferences: normalizeDebridStreamPreferences2, DebridProviders: DebridProviders2 } = settingsScreenContext_exports;
    const providers3 = DebridProviders2.visible();
    const configuredProviders = providers3.filter((provider) => DebridProviders2.apiKeyFor(model.debrid, provider.id));
    const resolverProviders = DebridProviders2.configuredResolverServices(model.debrid).map((credential) => credential.provider);
    const activeResolverProvider = DebridProviders2.preferredResolverService(model.debrid)?.provider || null;
    const hasResolverProvider = Boolean(activeResolverProvider);
    const canResolvePlayableLinks = Boolean(model.debrid.enabled && hasResolverProvider);
    const hasCloudLibraryProvider = configuredProviders.some((provider) => provider.capabilities?.includes?.("cloudLibrary"));
    const canUseCloudLibrary = Boolean(model.debrid.cloudLibraryEnabled && hasCloudLibraryProvider);
    const streamPreferences = normalizeDebridStreamPreferences2(model.debrid.streamPreferences);
    const resolverOptions = resolverProviders.map((provider) => ({
      id: provider.id,
      label: provider.displayName
    }));
    const preferredProviderId = activeResolverProvider?.id || "";
    return {
      providers: providers3,
      configuredProviders,
      resolverProviders,
      activeResolverProvider,
      hasResolverProvider,
      canResolvePlayableLinks,
      hasCloudLibraryProvider,
      canUseCloudLibrary,
      streamPreferences,
      resolverOptions,
      preferredProviderId
    };
  }

  // js/ui/screens/settings/settingsIntegrationDetailDebridActions.js
  function registerDebridIntegrationActions(model, state3) {
    const {
      DEBRID_SETTINGS_DEFAULTS: DEBRID_SETTINGS_DEFAULTS2,
      DEBRID_SORT_PROFILES: DEBRID_SORT_PROFILES2,
      DebridSettingsStore: DebridSettingsStore2,
      DEBRID_AUTH_METHODS: DEBRID_AUTH_METHODS2,
      DebridProviders: DebridProviders2,
      DEBRID_PREPARE_COUNT_OPTIONS: DEBRID_PREPARE_COUNT_OPTIONS2,
      DEBRID_MAX_RESULTS_OPTIONS: DEBRID_MAX_RESULTS_OPTIONS2,
      DEBRID_SORT_PROFILE_OPTIONS: DEBRID_SORT_PROFILE_OPTIONS2,
      DEBRID_SIZE_RANGE_OPTIONS: DEBRID_SIZE_RANGE_OPTIONS2,
      DEBRID_MIN_QUALITY_OPTIONS: DEBRID_MIN_QUALITY_OPTIONS2,
      DEBRID_FEATURE_FILTER_OPTIONS: DEBRID_FEATURE_FILTER_OPTIONS2,
      DEBRID_CODEC_OPTIONS: DEBRID_CODEC_OPTIONS2,
      t: t31,
      debridSortProfileFor: debridSortProfileFor2,
      debridSizeRangeId: debridSizeRangeId2,
      debridSizeRangeLabel: debridSizeRangeLabel2,
      debridRuleRows: debridRuleRows2,
      validateDebridApiKey: validateDebridApiKey2
    } = settingsScreenContext_exports;
    const {
      providers: providers3,
      configuredProviders,
      resolverProviders,
      activeResolverProvider,
      hasResolverProvider,
      canResolvePlayableLinks,
      hasCloudLibraryProvider,
      canUseCloudLibrary,
      streamPreferences,
      resolverOptions,
      preferredProviderId
    } = state3;
    this.actionMap.set("integration:debrid:enabled", () => {
      if (!hasResolverProvider) return;
      DebridSettingsStore2.set({ enabled: !DebridSettingsStore2.get().enabled });
    });
    this.actionMap.set("integration:debrid:cloud", () => {
      if (!hasCloudLibraryProvider) return;
      DebridSettingsStore2.set({
        cloudLibraryEnabled: !DebridSettingsStore2.get().cloudLibraryEnabled
      });
    });
    this.actionMap.set("integration:debrid:provider", () => {
      this.openOptionDialog({
        title: t31("settings.integration.debrid.resolveWith.title", {}, "Resolve with"),
        options: resolverOptions,
        selectedId: preferredProviderId,
        returnFocusKey: "integration:debrid:provider",
        onSelect: (option) => {
          DebridSettingsStore2.set({ preferredResolverProviderId: String(option.id || "") });
        }
      });
    });
    providers3.forEach((provider) => {
      this.actionMap.set(`integration:debrid:key:${provider.id}`, () => {
        if (provider.authMethod === DEBRID_AUTH_METHODS2.DEVICE_CODE) {
          this.openDebridDeviceAuthDialog(provider);
          return;
        }
        const current2 = DebridProviders2.apiKeyFor(DebridSettingsStore2.get(), provider.id);
        this.openTextDialog({
          title: t31("settings.integration.debrid.apiKey.prompt", { provider: provider.displayName }, `${provider.displayName} API key`),
          value: current2,
          returnFocusKey: `integration:debrid:key:${provider.id}`,
          onSubmit: async (value) => {
            const trimmed = String(value || "").trim();
            if (trimmed && !await validateDebridApiKey2(provider.id, trimmed)) {
              window.alert?.(t31("settings.integration.debrid.apiKey.invalid", {}, "Invalid Debrid API key."));
              return false;
            }
            DebridSettingsStore2.setProviderApiKey(provider.id, trimmed);
            return true;
          }
        });
      });
    });
    this.actionMap.set("integration:debrid:prepareToggle", () => {
      const enabled = Number(DebridSettingsStore2.get().instantPlaybackPreparationLimit || 0) > 0;
      DebridSettingsStore2.set({ instantPlaybackPreparationLimit: enabled ? 0 : 2 });
    });
    this.actionMap.set("integration:debrid:prepareCount", () => {
      this.openOptionDialog({
        title: t31("settings.integration.debrid.prepare.count.title", {}, "Links to prepare"),
        options: DEBRID_PREPARE_COUNT_OPTIONS2,
        selectedId: model.debrid.instantPlaybackPreparationLimit,
        returnFocusKey: "integration:debrid:prepareCount",
        onSelect: (option) => DebridSettingsStore2.set({ instantPlaybackPreparationLimit: Number(option.id || 0) })
      });
    });
    this.actionMap.set("integration:debrid:maxResults", () => {
      this.openOptionDialog({
        title: t31("settings.integration.debrid.maxResults.title", {}, "Max results"),
        options: DEBRID_MAX_RESULTS_OPTIONS2,
        selectedId: streamPreferences.maxResults,
        returnFocusKey: "integration:debrid:maxResults",
        onSelect: (option) => DebridSettingsStore2.setStreamMaxResults(Number(option.id || 0))
      });
    });
    this.actionMap.set("integration:debrid:sort", () => {
      this.openOptionDialog({
        title: t31("settings.integration.debrid.sort.title", {}, "Sort streams"),
        options: DEBRID_SORT_PROFILE_OPTIONS2,
        selectedId: debridSortProfileFor2(streamPreferences.sortCriteria),
        returnFocusKey: "integration:debrid:sort",
        onSelect: (option) => DebridSettingsStore2.setStreamPreferences({
          ...DebridSettingsStore2.get().streamPreferences,
          sortCriteria: DEBRID_SORT_PROFILES2[option.id] || []
        })
      });
    });
    this.actionMap.set("integration:debrid:minQuality", () => {
      this.openOptionDialog({
        title: t31("settings.integration.debrid.minQuality.title", {}, "Minimum quality"),
        options: DEBRID_MIN_QUALITY_OPTIONS2,
        selectedId: model.debrid.streamMinimumQuality,
        returnFocusKey: "integration:debrid:minQuality",
        onSelect: (option) => DebridSettingsStore2.setStreamMinimumQuality(option.id)
      });
    });
    this.actionMap.set("integration:debrid:dv", () => {
      this.openOptionDialog({
        title: t31("settings.integration.debrid.dolbyVision.title", {}, "Dolby Vision"),
        options: DEBRID_FEATURE_FILTER_OPTIONS2,
        selectedId: model.debrid.streamDolbyVisionFilter,
        returnFocusKey: "integration:debrid:dv",
        onSelect: (option) => DebridSettingsStore2.setStreamDolbyVisionFilter(option.id)
      });
    });
    this.actionMap.set("integration:debrid:hdr", () => {
      this.openOptionDialog({
        title: t31("settings.integration.debrid.hdr.title", {}, "HDR"),
        options: DEBRID_FEATURE_FILTER_OPTIONS2,
        selectedId: model.debrid.streamHdrFilter,
        returnFocusKey: "integration:debrid:hdr",
        onSelect: (option) => DebridSettingsStore2.setStreamHdrFilter(option.id)
      });
    });
    this.actionMap.set("integration:debrid:codec", () => {
      this.openOptionDialog({
        title: t31("settings.integration.debrid.codec.title", {}, "Codec"),
        options: DEBRID_CODEC_OPTIONS2,
        selectedId: model.debrid.streamCodecFilter,
        returnFocusKey: "integration:debrid:codec",
        onSelect: (option) => DebridSettingsStore2.setStreamCodecFilter(option.id)
      });
    });
    this.actionMap.set("integration:debrid:maxPerResolution", () => {
      this.openOptionDialog({
        title: t31("debrid_stream_per_resolution_limit_title", {}, "Per resolution limit"),
        options: DEBRID_MAX_RESULTS_OPTIONS2,
        selectedId: streamPreferences.maxPerResolution,
        returnFocusKey: "integration:debrid:maxPerResolution",
        onSelect: (option) => DebridSettingsStore2.setStreamPreferences({
          ...DebridSettingsStore2.get().streamPreferences,
          maxPerResolution: Number(option.id || 0)
        })
      });
    });
    this.actionMap.set("integration:debrid:maxPerQuality", () => {
      this.openOptionDialog({
        title: t31("debrid_stream_per_quality_limit_title", {}, "Per quality limit"),
        options: DEBRID_MAX_RESULTS_OPTIONS2,
        selectedId: streamPreferences.maxPerQuality,
        returnFocusKey: "integration:debrid:maxPerQuality",
        onSelect: (option) => DebridSettingsStore2.setStreamPreferences({
          ...DebridSettingsStore2.get().streamPreferences,
          maxPerQuality: Number(option.id || 0)
        })
      });
    });
    this.actionMap.set("integration:debrid:sizeRange", () => {
      this.openOptionDialog({
        title: t31("debrid_stream_size_range_title", {}, "Size range"),
        options: DEBRID_SIZE_RANGE_OPTIONS2.map((option) => ({
          ...option,
          label: debridSizeRangeLabel2(option.min, option.max)
        })),
        selectedId: debridSizeRangeId2(streamPreferences),
        returnFocusKey: "integration:debrid:sizeRange",
        onSelect: (option) => DebridSettingsStore2.setStreamPreferences({
          ...DebridSettingsStore2.get().streamPreferences,
          sizeMinGb: option.min,
          sizeMaxGb: option.max
        })
      });
    });
    debridRuleRows2(streamPreferences).forEach((row) => {
      this.actionMap.set(`integration:debrid:pref:${row.field}`, () => {
        if (row.textList) {
          this.openTextDialog({
            title: t31(row.dialogTitleKey, {}, row.field),
            value: row.selectedValues.join("\n"),
            multiline: true,
            returnFocusKey: `integration:debrid:pref:${row.field}`,
            onSubmit: (value) => {
              const values = String(value || "").split(/[\n,]/).map((entry) => entry.trim()).filter(Boolean).filter((entry, index, array) => array.indexOf(entry) === index);
              DebridSettingsStore2.setStreamPreferences({
                ...DebridSettingsStore2.get().streamPreferences,
                [row.field]: values
              });
              return true;
            }
          });
          return;
        }
        this.openMultiChoiceDialog({
          title: t31(row.dialogTitleKey, {}, row.field),
          options: row.options,
          selectedIds: row.selectedValues,
          returnFocusKey: `integration:debrid:pref:${row.field}`,
          onToggle: (selectedIds) => {
            DebridSettingsStore2.setStreamPreferences({
              ...DebridSettingsStore2.get().streamPreferences,
              [row.field]: selectedIds.length ? selectedIds : row.defaultWhenEmpty || []
            });
          }
        });
      });
    });
    this.actionMap.set("integration:debrid:nameTemplate", () => {
      this.openTextDialog({
        title: t31("settings.integration.debrid.template.name.prompt", {}, "Stream name pattern"),
        value: DebridSettingsStore2.get().streamNameTemplate || DEBRID_SETTINGS_DEFAULTS2.streamNameTemplate,
        returnFocusKey: "integration:debrid:nameTemplate",
        onSubmit: (value) => {
          DebridSettingsStore2.set({ streamNameTemplate: String(value) });
          return true;
        }
      });
    });
    this.actionMap.set("integration:debrid:descriptionTemplate", () => {
      this.openTextDialog({
        title: t31("settings.integration.debrid.template.description.prompt", {}, "Stream description pattern"),
        value: DebridSettingsStore2.get().streamDescriptionTemplate ?? DEBRID_SETTINGS_DEFAULTS2.streamDescriptionTemplate,
        multiline: true,
        returnFocusKey: "integration:debrid:descriptionTemplate",
        onSubmit: (value) => {
          DebridSettingsStore2.set({ streamDescriptionTemplate: String(value) });
          return true;
        }
      });
    });
    this.actionMap.set("integration:debrid:resetTemplates", () => {
      DebridSettingsStore2.set({
        streamNameTemplate: DEBRID_SETTINGS_DEFAULTS2.streamNameTemplate,
        streamDescriptionTemplate: DEBRID_SETTINGS_DEFAULTS2.streamDescriptionTemplate
      });
    });
  }

  // js/ui/screens/settings/settingsIntegrationDetailDebridMarkup.js
  function renderDebridIntegrationMarkup(model, state3) {
    const {
