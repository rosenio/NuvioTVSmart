        method: "GET",
        headers: {
          Accept: "application/vnd.github+json"
        },
        cache: "no-store",
        signal: controller?.signal
      });
      const response = await Promise.race([
        request2,
        new Promise((_, reject) => {
          timeoutId = setTimeout(
            () => {
