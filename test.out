          if (!availableSequence.length) {
            return true;
          }
          const current2 = availableSequence.includes(this.postPlayFocusedAction) ? availableSequence.indexOf(this.postPlayFocusedAction) : 0;
          const nextIndex = Math.max(0, Math.min(availableSequence.length - 1, current2 + (keyCode === 39 ? 1 : -1)));
