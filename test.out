          this.renderControlButtons();
          return;
        }
        if (action === "backFromMore") {
          this.stickyProgressFocus = false;
          this.moreActionsVisible = false;
          this.controlFocusZone = "buttons";
          this.controlFocusIndex = 0;
          this.renderControlButtons();
          return;
        }
        if (action === "speed") {
          this.openSpeedDialog();
          return;
        }
        if (action === "aspect") {
          this.cycleAspectMode();
          return;
        }
      }
    };
  }

