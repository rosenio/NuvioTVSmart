  // js/ui/screens/settings/settingsScreenMethods-09-render-integration-section.js
  function createSettingsScreenMethods09() {
    const {
      StreamBadgeSettingsStore: StreamBadgeSettingsStore2,
      getStreamBadgePreviewSections: getStreamBadgePreviewSections2,
      normalizeStreamBadgeChipColor: normalizeStreamBadgeChipColor3,
      STREAM_BADGE_IMPORT_LIMIT: STREAM_BADGE_IMPORT_LIMIT2,
      SECTION_META: SECTION_META2,
      t: t31,
      escapeHtml: escapeHtml31
    } = settingsScreenContext_exports;
    return {
      renderIntegrationSection(model) {
        if (this.integrationView && this.integrationView !== "hub") {
          return this.renderIntegrationDetail(model, this.integrationView);
        }
        return this.renderIntegrationHub();
      },
      renderStreamsSection(model) {
        const badgeSettings = model.streamBadgeSettings || StreamBadgeSettingsStore2.get();
        const rules = badgeSettings.rules || { imports: [] };
        const imports = Array.isArray(rules.imports) ? rules.imports : [];
        const previewSourceUrl = String(this.streamBadgePreviewSourceUrl || "").trim();
        const previewImport = previewSourceUrl ? imports.find(
          (importItem) => String(importItem?.sourceUrl || "").trim().toLowerCase() === previewSourceUrl.toLowerCase()
        ) : null;
        this.actionMap.set("streams:add", () => {
          this.openTextDialog({
            title: t31("settings_stream_badge_urls_title", {}, "Fusion badge URLs"),
            value: "",
            placeholder: "https://...",
            returnFocusKey: "streams:add",
            onSubmit: async (value) => {
              const result = await StreamBadgeSettingsStore2.importStreamBadgeRulesFromUrl(value);
              if (result.status !== "success") {
                if (this.textDialog) {
                  this.textDialog.statusMessage = result.message || t31("settings_fusion_badges_empty", {}, "No Fusion badge URLs imported.");
                  this.textDialog.statusKind = "error";
                }
                return false;
              }
              this.streamBadgePreviewSourceUrl = result.rules?.imports?.[0]?.sourceUrl || this.streamBadgePreviewSourceUrl || null;
              return true;
            }
          });
        });
        this.actionMap.set("streams:toggle:sizeBadges", () => {
          StreamBadgeSettingsStore2.setShowFileSizeBadges(!badgeSettings.showFileSizeBadges);
        });
        this.actionMap.set("streams:toggle:addonLogo", () => {
          StreamBadgeSettingsStore2.setShowAddonLogo(!badgeSettings.showAddonLogo);
        });
        const badgePlacement = String(badgeSettings.badgePlacement || "BOTTOM").trim().toUpperCase() === "TOP" ? "TOP" : "BOTTOM";
        const badgePlacementOptions = [
          { id: "BOTTOM", label: t31("settings_stream_badge_position_bottom", {}, "Bottom") },
          { id: "TOP", label: t31("settings_stream_badge_position_top", {}, "Top") }
        ];
        this.actionMap.set("streams:badgePlacement", () => {
          this.openOptionDialog({
            title: t31("settings_stream_badge_position_dialog_title", {}, "Badge position"),
            subtitle: t31("settings_stream_badge_position_dialog_description", {}, "Select where stream badges appear on stream cards."),
            options: badgePlacementOptions,
            selectedId: badgePlacement,
            returnFocusKey: "streams:badgePlacement",
            onSelect: (option) => StreamBadgeSettingsStore2.setBadgePlacement(option.id)
          });
        });
        this.actionMap.set("streams:preview:close", () => {
          this.streamBadgePreviewSourceUrl = null;
        });
        imports.forEach((importItem, index) => {
          const focusKey = `streams:import:${index}`;
          this.actionMap.set(focusKey, () => {
            const sourceUrl = String(importItem?.sourceUrl || "").trim();
            const options = [];
            if (imports.length > 1 && !importItem.isActive) {
              options.push({ id: "activate", label: "Activate" });
            }
            options.push({ id: "edit", label: "Edit URL" });
            options.push({ id: "preview", label: "Preview" });
            options.push({ id: "delete", label: "Delete" });
            options.push({ id: "cancel", labelKey: "action_cancel", label: "Cancel" });
            this.openOptionDialog({
              title: sourceUrl || t31("settings_stream_badge_urls_title", {}, "Fusion badge URLs"),
              options,
              selectedId: "preview",
              returnFocusKey: focusKey,
              onSelect: async (option) => {
                if (option.id === "activate") {
                  StreamBadgeSettingsStore2.setActiveStreamBadgeRulesSource(sourceUrl);
                  this.streamBadgePreviewSourceUrl = sourceUrl;
                  return true;
                }
                if (option.id === "preview") {
                  this.streamBadgePreviewSourceUrl = sourceUrl;
                  return true;
                }
                if (option.id === "delete") {
                  StreamBadgeSettingsStore2.deleteStreamBadgeRulesSource(sourceUrl);
                  if (previewSourceUrl && previewSourceUrl.toLowerCase() === sourceUrl.toLowerCase()) {
                    this.streamBadgePreviewSourceUrl = null;
                  }
                  return true;
                }
                if (option.id === "edit") {
                  this.openTextDialog({
                    title: t31("settings_fusion_badge_url_label", {}, "Fusion badge JSON URL"),
                    value: sourceUrl,
                    placeholder: "https://...",
                    returnFocusKey: focusKey,
                    onSubmit: async (nextValue) => {
                      const trimmed = String(nextValue || "").trim();
                      if (!trimmed) {
                        if (this.textDialog) {
                          this.textDialog.statusMessage = "Enter a badge JSON URL.";
                          this.textDialog.statusKind = "error";
                        }
                        return false;
                      }
                      if (trimmed.toLowerCase() === sourceUrl.toLowerCase()) {
                        return true;
                      }
                      const result = await StreamBadgeSettingsStore2.importStreamBadgeRulesFromUrl(trimmed);
                      if (result.status !== "success") {
                        if (this.textDialog) {
                          this.textDialog.statusMessage = result.message || t31("settings_fusion_badges_empty", {}, "No Fusion badge URLs imported.");
                          this.textDialog.statusKind = "error";
                        }
                        return false;
                      }
                      StreamBadgeSettingsStore2.deleteStreamBadgeRulesSource(sourceUrl);
                      this.streamBadgePreviewSourceUrl = result.rules?.imports?.[0]?.sourceUrl || trimmed;
                      return true;
                    }
                  });
                  return true;
                }
                return true;
              }
            });
          });
        });
        this.actionMap.set("streams:toggle:playerBadges", () => {
          StreamBadgeSettingsStore2.setShowInPlayer(!badgeSettings.showInPlayer);
        });
        const playerBadgeOptions = [
          { id: "", label: t31("settings_player_badges_use_stream_pack", {}, "Use stream badge pack") },
          ...imports.map((entry) => ({ id: entry.sourceUrl, label: entry.sourceUrl }))
        ];
        this.actionMap.set("streams:playerBadgeSource", () => {
          this.openOptionDialog({
            title: t31("settings_player_badges_pack_title", {}, "Player badge pack"),
            options: playerBadgeOptions,
            selectedId: badgeSettings.playerBadgeSource || "",
            returnFocusKey: "streams:playerBadgeSource",
            onSelect: (option) => StreamBadgeSettingsStore2.setPlayerBadgeSource(option.id)
          });
        });
        const previewHtml = previewImport ? this.renderStreamBadgePreviewCard(previewImport) : "";
        const emptyHtml = imports.length ? "" : `<p class="settings-row-subtitle">${escapeHtml31(t31("settings_fusion_badges_empty", {}, "No Fusion badge URLs imported."))}</p>`;
        return `
          ${this.renderSectionHeader(SECTION_META2.find((item) => item.id === "streams"))}
          <div class="settings-group-card settings-group-card-fill">
            <div class="settings-stack">
              ${this.renderToggleRow({
          focusKey: "streams:toggle:playerBadges",
          title: t31("settings_player_badges_title", {}, "Badges in player"),
          subtitle: t31("settings_player_badges_description", {}, "Show badges for the playing video and selected audio track."),
          checked: badgeSettings.showInPlayer === true
        })}
              ${this.renderActionRow({
          focusKey: "streams:playerBadgeSource",
          title: t31("settings_player_badges_pack_title", {}, "Player badge pack"),
          subtitle: t31(
            "settings_player_badges_pack_description",
            {},
            "Choose an imported pack for the player independently of stream cards."
          ),
          value: playerBadgeOptions.find((option) => option.id === badgeSettings.playerBadgeSource)?.label || playerBadgeOptions[0].label
        })}
              ${this.renderToggleRow({
          focusKey: "streams:toggle:sizeBadges",
          title: t31("settings_stream_size_badges_title", {}, "Size badges"),
          subtitle: t31(
            "settings_stream_size_badges_description",
            {},
            "Show file size badges in stream results and player source panels."
          ),
          checked: badgeSettings.showFileSizeBadges !== false
        })}
              ${this.renderToggleRow({
          focusKey: "streams:toggle:addonLogo",
          title: t31("settings_stream_addon_logo_title", {}, "Addon logo"),
          subtitle: t31("settings_stream_addon_logo_description", {}, "Show addon logo and name next to stream sources."),
          checked: badgeSettings.showAddonLogo === true
        })}
              ${this.renderActionRow({
          focusKey: "streams:badgePlacement",
          title: t31("settings_stream_badge_position_title", {}, "Badge position"),
          subtitle: t31(
            "settings_stream_badge_position_description",
            {},
            "Choose whether Fusion and size badges appear above or below stream cards."
          ),
          value: badgePlacementOptions.find((option) => option.id === badgePlacement)?.label || badgePlacementOptions[0].label
        })}
              ${this.renderActionRow({
          focusKey: "streams:add",
          title: t31("settings_stream_badge_urls_title", {}, "Fusion badge URLs"),
          subtitle: t31(
            "settings_stream_badge_urls_description",
            [STREAM_BADGE_IMPORT_LIMIT2],
            `Import up to ${STREAM_BADGE_IMPORT_LIMIT2} Fusion-style stream badge JSON URLs.`
          ),
          value: t31("action_import", {}, "Import")
        })}
              ${imports.map((importItem, index) => {
          const sourceUrl = String(importItem?.sourceUrl || "").trim();
          const enabledCount = Array.isArray(importItem?.filters) ? importItem.filters.filter((filter) => filter?.isEnabled !== false).length : 0;
          const groupCount = Array.isArray(importItem?.groups) ? importItem.groups.length : 0;
          const statusLabel = importItem?.isActive === false ? t31("settings_fusion_badge_url_inactive", {}, "Inactive") : t31("settings_fusion_badge_url_active", {}, "Active");
          const summary = t31(
            "settings_fusion_badge_url_status_summary",
            [statusLabel, enabledCount, groupCount],
            `${statusLabel}, ${enabledCount} enabled badges, ${groupCount} groups`
          );
          return this.renderActionRow({
            focusKey: `streams:import:${index}`,
            title: sourceUrl || `Badge URL ${index + 1}`,
            subtitle: summary,
            value: statusLabel
          });
        }).join("")}
              ${emptyHtml}
            </div>
          </div>
          ${previewHtml}
        `;
      },
      renderStreamBadgePreviewCard(importItem) {
        const sections = getStreamBadgePreviewSections2(importItem);
        const badgeCount = sections.reduce((total, section) => total + (Array.isArray(section.filters) ? section.filters.length : 0), 0);
        const sourceUrl = String(importItem?.sourceUrl || "").trim();
        const bodyHtml = sections.length ? sections.map(
          (section) => `
              <div class="settings-stream-badge-preview-section">
                <div class="settings-row-title">${escapeHtml31(
            section.id === "other" ? t31("settings_fusion_badge_other_group_title", {}, "Other Fusion badges") : section.title
          )}</div>
                <div class="stream-route-card-badges">
                  ${(section.filters || []).filter((filter) => String(filter?.imageURL || "").trim()).map((filter) => {
            const filled = String(filter?.tagStyle || "").trim().toLowerCase() === "filled";
            const background = filled ? normalizeStreamBadgeChipColor3(filter?.tagColor) : "";
            const border = normalizeStreamBadgeChipColor3(filter?.borderColor);
            const textColor = normalizeStreamBadgeChipColor3(filter?.textColor);
            const style = [
              background ? `background:${background};` : "",
              border ? `border-color:${border};` : "",
              textColor ? `color:${textColor};` : ""
            ].join("");
            return `
            <span class="stream-route-stream-badge image${filled ? " filled" : ""}"${style ? ` style="${escapeHtml31(style)}"` : ""}>
              <img src="${escapeHtml31(filter?.imageURL || "")}" alt="${escapeHtml31(filter?.name || "")}" loading="lazy" />
            </span>
          `;
          }).join("")}
                </div>
              </div>
            `
        ).join("") : `<p class="settings-row-subtitle">${escapeHtml31(t31("settings_fusion_badge_preview_empty", {}, "No Fusion-style badge images in this URL."))}</p>`;
        this.actionMap.set("streams:preview:close", () => {
          this.streamBadgePreviewSourceUrl = null;
        });
        return `
          <div class="settings-group-card settings-group-card-fill">
            <div class="settings-stack">
              <div class="settings-row-title">${escapeHtml31(t31("settings_fusion_badge_preview_title", {}, "Fusion badge preview"))}</div>
              <div class="settings-row-subtitle">${escapeHtml31(sourceUrl)}</div>
              <div class="settings-row-subtitle">${escapeHtml31(t31("settings_fusion_badge_preview_count", [badgeCount], `${badgeCount} Fusion-style badges from this URL`))}</div>
              ${bodyHtml}
              ${this.renderActionRow({
          focusKey: "streams:preview:close",
          title: t31("common.close", {}, "Close"),
          subtitle: "",
          value: ""
        })}
            </div>
          </div>
        `;
      }
    };
  }

  // js/ui/screens/settings/settingsScreenPlaybackActions-01.js
  function registerPlaybackActionsPart01(model) {
    const {
      addonRepository: addonRepository2,
      PlayerSettingsStore: PlayerSettingsStore2,
      PluginManager: PluginManager2,
      NEXT_EPISODE_THRESHOLD_MODE_OPTIONS: NEXT_EPISODE_THRESHOLD_MODE_OPTIONS2,
      NEXT_EPISODE_THRESHOLD_PERCENT_OPTIONS: NEXT_EPISODE_THRESHOLD_PERCENT_OPTIONS2,
      NEXT_EPISODE_THRESHOLD_MINUTE_OPTIONS: NEXT_EPISODE_THRESHOLD_MINUTE_OPTIONS2,
      STILL_WATCHING_THRESHOLD_OPTIONS: STILL_WATCHING_THRESHOLD_OPTIONS2,
      STREAM_AUTOPLAY_MODE_OPTIONS: STREAM_AUTOPLAY_MODE_OPTIONS2,
      STREAM_AUTOPLAY_SOURCE_OPTIONS: STREAM_AUTOPLAY_SOURCE_OPTIONS2,
      STREAM_AUTOPLAY_TIMEOUT_OPTIONS: STREAM_AUTOPLAY_TIMEOUT_OPTIONS2,
      STREAM_REUSE_CACHE_HOURS_OPTIONS: STREAM_REUSE_CACHE_HOURS_OPTIONS2,
      formatReuseCacheDuration: formatReuseCacheDuration2,
      t: t31,
      arePluginsSupported: arePluginsSupported2
    } = settingsScreenContext_exports;
    this.actionMap.set("playback:toggle:general", () => {
      this.toggleExpandedSection("playback", "general");
    });
    this.actionMap.set("playback:toggle:audio", () => {
      this.toggleExpandedSection("playback", "audio");
    });
    this.actionMap.set("playback:toggle:subtitles", () => {
      this.toggleExpandedSection("playback", "subtitles");
    });
    this.actionMap.set("playback:toggle:p2p", () => {
      this.toggleExpandedSection("playback", "p2p");
    });
    this.actionMap.set("playback:autoplay", () => {
      PlayerSettingsStore2.set({
        autoplayNextEpisode: !PlayerSettingsStore2.get().autoplayNextEpisode
      });
    });
    this.actionMap.set("playback:postPlayRecommendations", () => {
      PlayerSettingsStore2.set({
        postPlayRecommendationsEnabled: !PlayerSettingsStore2.get().postPlayRecommendationsEnabled
      });
    });
    this.actionMap.set("playback:postPlayMovieThreshold", () => {
      const current2 = PlayerSettingsStore2.get().postPlayMovieThresholdPercent ?? 90;
      this.openOptionDialog({
        title: t31("autoplay_post_play_movie_threshold", {}, "Movie Recommendation Timing"),
        options: Array.from({ length: 21 }, (_, index) => {
          const value = 80 + index;
          return { id: value, label: `${value}%` };
        }),
        selectedId: current2,
        returnFocusKey: "playback:postPlayMovieThreshold",
        onSelect: (option) => {
          PlayerSettingsStore2.set({ postPlayMovieThresholdPercent: Number(option.id) });
        }
      });
    });
    this.actionMap.set("playback:preferBingeGroup", () => {
      PlayerSettingsStore2.set({
        streamAutoPlayPreferBingeGroupForNextEpisode: !PlayerSettingsStore2.get().streamAutoPlayPreferBingeGroupForNextEpisode
      });
    });
    this.actionMap.set("playback:reuseBingeGroup", () => {
      PlayerSettingsStore2.set({
        streamAutoPlayReuseBingeGroup: !PlayerSettingsStore2.get().streamAutoPlayReuseBingeGroup
      });
    });
    this.actionMap.set("playback:reuseLastLink", () => {
      PlayerSettingsStore2.set({
        streamReuseLastLinkEnabled: !PlayerSettingsStore2.get().streamReuseLastLinkEnabled
      });
    });
    this.actionMap.set("playback:reuseLastLinkCache", () => {
      this.openOptionDialog({
        title: t31("autoplay_last_link_cache", {}, "Last Link Cache Duration"),
        options: STREAM_REUSE_CACHE_HOURS_OPTIONS2.map((option) => ({
          ...option,
          label: formatReuseCacheDuration2(option.id)
        })),
        selectedId: PlayerSettingsStore2.get().streamReuseLastLinkCacheHours,
        returnFocusKey: "playback:reuseLastLinkCache",
        onSelect: (option) => {
          PlayerSettingsStore2.set({ streamReuseLastLinkCacheHours: Number(option.id) });
        }
      });
    });
    this.actionMap.set("playback:trailer", () => {
      PlayerSettingsStore2.set({ trailerAutoplay: !PlayerSettingsStore2.get().trailerAutoplay });
    });
    this.actionMap.set(
      "playback:trailerDelay",
      () => this.openOptionDialog({
        title: t31("audio_trailer_delay", {}, "Trailer delay"),
        options: Array.from({ length: 16 }, (_, value) => ({
          id: String(value),
          label: `${value}s`
        })),
        selectedId: String(model.player.trailerDelaySeconds ?? 7),
        returnFocusKey: "playback:trailerDelay",
        onSelect: (option) => PlayerSettingsStore2.set({ trailerDelaySeconds: Number(option.id) })
      })
    );
    this.actionMap.set("playback:skipIntro", () => {
      PlayerSettingsStore2.set({ skipIntroEnabled: !PlayerSettingsStore2.get().skipIntroEnabled });
    });
    const togglePlayerSetting = (focusKey, field) => this.actionMap.set(focusKey, () => PlayerSettingsStore2.set({ [field]: !PlayerSettingsStore2.get()[field] }));
    togglePlayerSetting("playback:loadingOverlay", "loadingOverlayEnabled");
    togglePlayerSetting("playback:loadingStatus", "showPlayerLoadingStatus");
    togglePlayerSetting("playback:pauseOverlay", "pauseOverlayEnabled");
    togglePlayerSetting("playback:parentalGuide", "parentalGuideEnabled");
    ["intro", "recap", "outro", "movie-credits"].forEach(
      (type) => this.actionMap.set(`playback:autoSkip:${type}`, () => {
        const current2 = PlayerSettingsStore2.get().autoSkipSegmentTypes || [];
        PlayerSettingsStore2.set({
          autoSkipSegmentTypes: current2.includes(type) ? current2.filter((entry) => entry !== type) : [...current2, type]
        });
      })
    );
    this.actionMap.set("playback:osdClock", () => {
      PlayerSettingsStore2.set({
        osdClockEnabled: !PlayerSettingsStore2.get().osdClockEnabled
      });
    });
    this.actionMap.set("playback:nextEpisodeThresholdMode", () => {
      this.openOptionDialog({
        title: t31("settings.playback.nextEpisodeThresholdMode.title", {}, "Next episode threshold"),
        options: NEXT_EPISODE_THRESHOLD_MODE_OPTIONS2,
        selectedId: PlayerSettingsStore2.get().nextEpisodeThresholdMode,
        returnFocusKey: "playback:nextEpisodeThresholdMode",
        onSelect: (option) => {
          PlayerSettingsStore2.set({ nextEpisodeThresholdMode: String(option.id) });
        }
      });
    });
    this.actionMap.set("playback:nextEpisodeThresholdValue", () => {
      const mode = String(PlayerSettingsStore2.get().nextEpisodeThresholdMode || "PERCENTAGE").toUpperCase();
      const options = mode === "MINUTES_BEFORE_END" ? NEXT_EPISODE_THRESHOLD_MINUTE_OPTIONS2 : NEXT_EPISODE_THRESHOLD_PERCENT_OPTIONS2;
      const selectedId = mode === "MINUTES_BEFORE_END" ? PlayerSettingsStore2.get().nextEpisodeThresholdMinutesBeforeEnd : PlayerSettingsStore2.get().nextEpisodeThresholdPercent;
      this.openOptionDialog({
        title: mode === "MINUTES_BEFORE_END" ? t31("settings.playback.nextEpisodeThresholdMinutes.title", {}, "Next episode minutes before end") : t31("settings.playback.nextEpisodeThresholdPercent.title", {}, "Next episode percentage"),
        options,
        selectedId,
        returnFocusKey: "playback:nextEpisodeThresholdValue",
        onSelect: (option) => {
          const value = Number(option.id);
          if (mode === "MINUTES_BEFORE_END") {
            PlayerSettingsStore2.set({ nextEpisodeThresholdMinutesBeforeEnd: value });
          } else {
            PlayerSettingsStore2.set({ nextEpisodeThresholdPercent: value });
          }
        }
      });
    });
    this.actionMap.set("playback:stillWatching", () => {
      PlayerSettingsStore2.set({
        stillWatchingEnabled: !PlayerSettingsStore2.get().stillWatchingEnabled
      });
    });
    this.actionMap.set("playback:stillWatchingThreshold", () => {
      this.openOptionDialog({
        title: t31("settings.playback.stillWatchingThreshold.title", {}, "Still watching threshold"),
        options: STILL_WATCHING_THRESHOLD_OPTIONS2,
        selectedId: PlayerSettingsStore2.get().stillWatchingEpisodeThreshold,
        returnFocusKey: "playback:stillWatchingThreshold",
        onSelect: (option) => {
          PlayerSettingsStore2.set({ stillWatchingEpisodeThreshold: Number(option.id) });
        }
      });
    });
    this.actionMap.set("playback:autoStreamMode", () => {
      this.openOptionDialog({
        title: t31("autoplay_stream_selection", {}, "Auto Stream Selection"),
        options: STREAM_AUTOPLAY_MODE_OPTIONS2,
        selectedId: PlayerSettingsStore2.get().streamAutoPlayMode,
        returnFocusKey: "playback:autoStreamMode",
        onSelect: (option) => {
          PlayerSettingsStore2.set({ streamAutoPlayMode: option.id });
        }
      });
    });
    this.actionMap.set("playback:autoStreamTimeout", () => {
      this.openOptionDialog({
        title: t31("autoplay_timeout_title", {}, "Stream Selection Timeout"),
        options: STREAM_AUTOPLAY_TIMEOUT_OPTIONS2,
        selectedId: PlayerSettingsStore2.get().streamAutoPlayTimeoutSeconds,
        returnFocusKey: "playback:autoStreamTimeout",
        onSelect: (option) => {
          PlayerSettingsStore2.set({ streamAutoPlayTimeoutSeconds: Number(option.id) });
        }
      });
    });
    this.actionMap.set("playback:autoStreamSource", () => {
      this.openOptionDialog({
        title: t31("autoplay_scope", {}, "Auto-play Source Scope"),
        options: STREAM_AUTOPLAY_SOURCE_OPTIONS2,
        selectedId: PlayerSettingsStore2.get().streamAutoPlaySource,
        returnFocusKey: "playback:autoStreamSource",
        onSelect: (option) => {
          PlayerSettingsStore2.set({ streamAutoPlaySource: option.id });
        }
      });
    });
    this.actionMap.set("playback:autoStreamRegex", () => {
      this.openTextDialog({
        title: t31("autoplay_regex_title", {}, "Regex Pattern"),
        value: PlayerSettingsStore2.get().streamAutoPlayRegex || "",
        returnFocusKey: "playback:autoStreamRegex",
        onSubmit: (value) => {
          PlayerSettingsStore2.set({ streamAutoPlayRegex: String(value || "").trim() });
          return true;
        }
      });
    });
    this.actionMap.set("playback:autoStreamAddons", async () => {
      const addons = await addonRepository2.getInstalledAddons().catch(() => []);
      const options = addons.map((addon) => String(addon?.displayName || addon?.name || "").trim()).filter(Boolean).map((name) => ({ id: name, label: name }));
      this.openMultiChoiceDialog({
        title: t31("autoplay_allowed_addons", {}, "Allowed Addons"),
        options,
        selectedIds: PlayerSettingsStore2.get().streamAutoPlaySelectedAddons,
        returnFocusKey: "playback:autoStreamAddons",
        onToggle: (selectedIds) => PlayerSettingsStore2.set({ streamAutoPlaySelectedAddons: selectedIds })
      });
    });
    if (arePluginsSupported2()) {
      this.actionMap.set("playback:autoStreamPlugins", () => {
        const options = (PluginManager2.pluginsEnabled ? PluginManager2.listScrapers() : []).filter((scraper) => scraper?.type === "NUVIO_JS" && scraper?.enabled !== false).map((scraper) => String(scraper?.name || "").trim()).filter(Boolean).filter((name, index, names) => names.indexOf(name) === index).sort((left, right) => left.localeCompare(right)).map((name) => ({ id: name, label: name }));
        this.openMultiChoiceDialog({
          title: t31("autoplay_allowed_plugins", {}, "Allowed Plugins"),
          options,
          selectedIds: PlayerSettingsStore2.get().streamAutoPlaySelectedPlugins,
          returnFocusKey: "playback:autoStreamPlugins",
          onToggle: (selectedIds) => PlayerSettingsStore2.set({ streamAutoPlaySelectedPlugins: selectedIds })
        });
      });
    }
  }

  // js/ui/screens/settings/settingsScreenPlaybackActions-02.js
  function registerPlaybackActionsPart02(model) {
    const {
      PlayerSettingsStore: PlayerSettingsStore2,
      SUBTITLE_VERTICAL_OFFSET_DEFAULT: SUBTITLE_VERTICAL_OFFSET_DEFAULT2,
      TorrentSettingsStore: TorrentSettingsStore2,
      TizenCapabilities: TizenCapabilities2,
      PREFERRED_SUBTITLE_LANGUAGE_OPTIONS: PREFERRED_SUBTITLE_LANGUAGE_OPTIONS2,
      PREFERRED_PLAYBACK_LANGUAGE_OPTIONS: PREFERRED_PLAYBACK_LANGUAGE_OPTIONS2,
      SECONDARY_PLAYBACK_LANGUAGE_OPTIONS: SECONDARY_PLAYBACK_LANGUAGE_OPTIONS2,
      SUBTITLE_SIZE_OPTIONS: SUBTITLE_SIZE_OPTIONS2,
      SUBTITLE_OFFSET_OPTIONS: SUBTITLE_OFFSET_OPTIONS2,
      SUBTITLE_TEXT_COLOR_OPTIONS: SUBTITLE_TEXT_COLOR_OPTIONS2,
      SUBTITLE_TEXT_OPACITY_OPTIONS: SUBTITLE_TEXT_OPACITY_OPTIONS2,
      SUBTITLE_OUTLINE_COLOR_OPTIONS: SUBTITLE_OUTLINE_COLOR_OPTIONS2,
      normalizeSubtitleStyleHex: normalizeSubtitleStyleHex2,
      clampSubtitleSize: clampSubtitleSize2,
      clampSubtitleTextOpacity: clampSubtitleTextOpacity2,
      clampSubtitleOffset: clampSubtitleOffset2,
      SECTION_META: SECTION_META2,
      t: t31,
      escapeHtml: escapeHtml31,
      normalizeSelectableSubtitleLanguageCode: normalizeSelectableSubtitleLanguageCode3
    } = settingsScreenContext_exports;
    this.actionMap.set("playback:audioLanguage", () => {
      this.openOptionDialog({
        title: t31("settings.dialogs.preferredAudioLanguage"),
        options: PREFERRED_PLAYBACK_LANGUAGE_OPTIONS2,
        selectedId: PlayerSettingsStore2.get().preferredAudioLanguage,
        returnFocusKey: "playback:audioLanguage",
        onSelect: (option) => {
          PlayerSettingsStore2.set({ preferredAudioLanguage: option.id });
        }
      });
    });
    this.actionMap.set("playback:secondaryAudioLanguage", () => {
      this.openOptionDialog({
        title: t31("sub_secondary_lang", {}, "Secondary Preferred Language"),
        options: SECONDARY_PLAYBACK_LANGUAGE_OPTIONS2,
        selectedId: PlayerSettingsStore2.get().secondaryPreferredAudioLanguage,
        returnFocusKey: "playback:secondaryAudioLanguage",
        onSelect: (option) => {
          PlayerSettingsStore2.set({ secondaryPreferredAudioLanguage: option.id });
        }
      });
    });
    this.actionMap.set("playback:useForcedSubtitles", () => {
      const currentSettings = PlayerSettingsStore2.get();
      PlayerSettingsStore2.set({
        subtitleStyle: {
          ...currentSettings.subtitleStyle,
          useForcedSubtitles: !currentSettings.subtitleStyle?.useForcedSubtitles
        }
      });
    });
    this.actionMap.set("playback:showOnlyPreferredSubtitleLanguages", () => {
      const currentSettings = PlayerSettingsStore2.get();
      const enabled = !currentSettings.subtitleStyle?.showOnlyPreferredLanguages;
      PlayerSettingsStore2.set({
        subtitleStyle: {
          ...currentSettings.subtitleStyle,
          showOnlyPreferredLanguages: enabled
        }
      });
    });
    this.actionMap.set("playback:subtitleLanguage", () => {
      const currentSettings = PlayerSettingsStore2.get();
      const currentLanguage = normalizeSelectableSubtitleLanguageCode3(
        currentSettings.subtitleStyle?.preferredLanguage || currentSettings.subtitleLanguage
      );
      this.openOptionDialog({
        title: t31("settings.dialogs.preferredSubtitleLanguage"),
        options: PREFERRED_SUBTITLE_LANGUAGE_OPTIONS2,
        selectedId: currentLanguage === "system" ? "off" : currentLanguage,
        returnFocusKey: "playback:subtitleLanguage",
        dialogClassName: "settings-language-dialog",
        optionRenderer: "subtitle-language",
        onSelect: (option) => {
          const normalized = normalizeSelectableSubtitleLanguageCode3(option.id);
          PlayerSettingsStore2.set({
            subtitlesEnabled: true,
            subtitleLanguage: normalized,
            subtitleStyle: {
              ...currentSettings.subtitleStyle,
              preferredLanguage: normalized
            }
          });
        }
      });
    });
    this.actionMap.set("playback:secondarySubtitleLanguage", () => {
      const currentSettings = PlayerSettingsStore2.get();
      this.openOptionDialog({
        title: t31("sub_secondary_lang", {}, "Secondary subtitle language"),
        options: PREFERRED_SUBTITLE_LANGUAGE_OPTIONS2,
        selectedId: currentSettings.secondarySubtitleLanguage || "off",
        returnFocusKey: "playback:secondarySubtitleLanguage",
        dialogClassName: "settings-language-dialog",
        optionRenderer: "subtitle-language",
        onSelect: (option) => PlayerSettingsStore2.set({
          secondarySubtitleLanguage: option.id,
          subtitleStyle: {
            ...currentSettings.subtitleStyle,
            secondaryPreferredLanguage: option.id
          }
        })
      });
    });
    this.actionMap.set("playback:renderMode", () => {
      this.openOptionDialog({
        title: t31("settings.dialogs.subtitleRenderMode"),
        options: [
          { id: "native", labelKey: "common.native" },
          { id: "html", labelKey: "common.htmlOverlay" }
        ],
        selectedId: String(PlayerSettingsStore2.get().subtitleRenderMode || "native").toLowerCase(),
        returnFocusKey: "playback:renderMode",
        onSelect: (option) => {
          PlayerSettingsStore2.set({ subtitleRenderMode: option.id });
        }
      });
    });
    const updateSubtitleStyle = (partial) => {
      const current2 = PlayerSettingsStore2.get();
      PlayerSettingsStore2.set({
        subtitleStyle: { ...current2.subtitleStyle, ...partial }
      });
    };
    this.actionMap.set("playback:subtitleSize", () => {
      this.openOptionDialog({
        title: t31("settings.playback.subtitleSize.title", {}, "Subtitle size"),
        options: SUBTITLE_SIZE_OPTIONS2,
        selectedId: clampSubtitleSize2(PlayerSettingsStore2.get().subtitleStyle?.fontSize ?? 120),
        returnFocusKey: "playback:subtitleSize",
        onSelect: (option) => {
          updateSubtitleStyle({ fontSize: clampSubtitleSize2(option.id) });
        }
      });
    });
    this.actionMap.set("playback:subtitleOffset", () => {
      this.openOptionDialog({
        title: t31("settings.playback.subtitleOffset.title", {}, "Subtitle position"),
        options: SUBTITLE_OFFSET_OPTIONS2,
        selectedId: clampSubtitleOffset2(PlayerSettingsStore2.get().subtitleStyle?.verticalOffset ?? SUBTITLE_VERTICAL_OFFSET_DEFAULT2),
        returnFocusKey: "playback:subtitleOffset",
        onSelect: (option) => {
          updateSubtitleStyle({ verticalOffset: clampSubtitleOffset2(option.id) });
        }
      });
    });
    this.actionMap.set("playback:subtitleBold", () => {
      updateSubtitleStyle({ bold: !PlayerSettingsStore2.get().subtitleStyle?.bold });
    });
    this.actionMap.set("playback:subtitleTextColor", () => {
      this.openOptionDialog({
        title: t31("settings.playback.subtitleTextColor.title", {}, "Subtitle color"),
        options: SUBTITLE_TEXT_COLOR_OPTIONS2,
        selectedId: normalizeSubtitleStyleHex2(PlayerSettingsStore2.get().subtitleStyle?.textColor, "#FFFFFF"),
        returnFocusKey: "playback:subtitleTextColor",
        onSelect: (option) => {
          updateSubtitleStyle({ textColor: normalizeSubtitleStyleHex2(option.id, "#FFFFFF") });
        }
      });
    });
    this.actionMap.set("playback:subtitleTextOpacity", () => {
      this.openOptionDialog({
        title: t31("subtitle_style_text_opacity", {}, "Text Opacity"),
        options: SUBTITLE_TEXT_OPACITY_OPTIONS2,
        selectedId: clampSubtitleTextOpacity2(PlayerSettingsStore2.get().subtitleStyle?.textOpacity),
        returnFocusKey: "playback:subtitleTextOpacity",
        onSelect: (option) => {
          updateSubtitleStyle({ textOpacity: clampSubtitleTextOpacity2(option.id) });
        }
      });
    });
    this.actionMap.set(
      "playback:subtitleBackgroundColor",
      () => this.openOptionDialog({
        title: t31("sub_bg_color", {}, "Subtitle background color"),
        options: [
          { id: "#00000000", labelKey: "common_off" },
          { id: "#00000080", label: "50%" },
          { id: "#000000CC", label: "80%" },
          { id: "#000000", label: "100%" }
        ],
        selectedId: PlayerSettingsStore2.get().subtitleStyle?.backgroundColor || "#00000000",
        returnFocusKey: "playback:subtitleBackgroundColor",
        onSelect: (option) => updateSubtitleStyle({ backgroundColor: option.id })
      })
    );
    this.actionMap.set("playback:subtitleOutline", () => {
      updateSubtitleStyle({
        outlineEnabled: !PlayerSettingsStore2.get().subtitleStyle?.outlineEnabled
      });
    });
    this.actionMap.set("playback:subtitleOutlineColor", () => {
      this.openOptionDialog({
        title: t31("settings.playback.subtitleOutlineColor.title", {}, "Outline color"),
        options: SUBTITLE_OUTLINE_COLOR_OPTIONS2,
        selectedId: normalizeSubtitleStyleHex2(PlayerSettingsStore2.get().subtitleStyle?.outlineColor, "#000000"),
        returnFocusKey: "playback:subtitleOutlineColor",
        onSelect: (option) => {
          updateSubtitleStyle({ outlineColor: normalizeSubtitleStyleHex2(option.id, "#000000") });
        }
      });
    });
    this.actionMap.set("playback:p2pEnabled", () => {
      if (TizenCapabilities2.isP2pUnsupported()) {
        return;
      }
      const current2 = TorrentSettingsStore2.get();
      if (current2.p2pEnabled) {
        TorrentSettingsStore2.setP2pEnabled(false);
        return;
      }
      this.openOptionDialog({
        title: t31("settings_p2p_title"),
        message: t31("p2p_consent_body"),
        options: [
          { id: "cancel", labelKey: "p2p_consent_cancel" },
          { id: "enable", labelKey: "p2p_consent_enable" }
        ],
        selectedId: "enable",
        returnFocusKey: "playback:p2pEnabled",
        dialogClassName: "settings-p2p-consent-dialog",
        optionColumns: 2,
        onSelect: (option) => {
          if (String(option.id) === "enable") {
            TorrentSettingsStore2.setP2pEnabled(true);
          }
        }
      });
    });
    this.actionMap.set("playback:hideTorrentStats", () => {
      if (TizenCapabilities2.isP2pUnsupported()) {
        return;
      }
      TorrentSettingsStore2.setHideTorrentStats(!TorrentSettingsStore2.get().hideTorrentStats);
    });
    if (model.experience?.mode === "ESSENTIAL") {
      const torrentSettings = model.torrent || TorrentSettingsStore2.get();
      const tizenP2pUnsupported = TizenCapabilities2.isP2pUnsupported();
      const p2pUnavailableSubtitle = tizenP2pUnsupported ? t31("settings_p2p_unsupported_subtitle", {}, "Not supported on this TV.") : t31("settings_p2p_subtitle");
      this.actionMap.set("playback:autoStreamMode", () => {
        const current2 = String(PlayerSettingsStore2.get().streamAutoPlayMode || "MANUAL");
        PlayerSettingsStore2.set({
          streamAutoPlayMode: current2 === "MANUAL" ? "FIRST_STREAM" : "MANUAL"
        });
      });
      const preferredSubtitle = model.player.subtitleStyle?.preferredLanguage || model.player.subtitleLanguage || "off";
      return `
            ${this.renderSectionHeader({
        ...SECTION_META2.find((item) => item.id === "playback"),
        labelKey: "essential_playback_header_title",
        subtitleKey: "essential_playback_header_subtitle"
      })}
