  // js/ui/screens/home/homeScreenMethods-10-schedule-modern-hero-update.js
  function createHomeScreenMethods10() {
    const { MODERN_HOME_CONSTANTS: MODERN_HOME_CONSTANTS2, getTvRuntimePerformanceProfile: getTvRuntimePerformanceProfile2, shouldEnrichModernHero: shouldEnrichModernHero2, preloadHeroAssets: preloadHeroAssets2, buildHeroIdentity: buildHeroIdentity2 } = homeScreenContext_exports;
    return {
      scheduleModernHeroUpdate(node, { deferUntilVerticalSettle = false, immediate = false } = {}) {
        if (this.layoutMode !== "modern") {
          return;
        }
        const hero = this.getNodeHeroSource(node);
        if (!hero || !hero.id) {
          return;
        }
        const currentHeroIdentity = buildHeroIdentity2(this.heroItem);
        const nextHeroIdentity = buildHeroIdentity2(hero);
        if (currentHeroIdentity === nextHeroIdentity && !this.heroItem?.heroMetaEnriching && !shouldEnrichModernHero2(hero)) {
          this.container?.querySelector(".home-modern-hero-card")?.classList.remove("is-hero-focus-pending");
          this.syncCollectionHeroMedia(hero);
          return;
        }
        this.cancelPendingHeroFocus();
        const focusToken = Number(this.heroFocusToken || 0) + 1;
        this.heroFocusToken = focusToken;
        const scheduledHeroIdentity = nextHeroIdentity;
        const now3 = Date.now();
        const previous = Number(this.lastModernHeroNavAt || 0);
        const isRapidNav = previous > 0 && now3 - previous < MODERN_HOME_CONSTANTS2.heroRapidNavThresholdMs;
        const delay3 = immediate ? 0 : this.getHeroFocusDelay({ rapid: isRapidNav });
        this.lastModernHeroNavAt = now3;
        if (isRapidNav || immediate) {
          this.container?.querySelector(".home-modern-hero-card")?.classList.add("is-hero-focus-pending");
        }
        const canPreloadHeroDuringVerticalScroll = deferUntilVerticalSettle && getTvRuntimePerformanceProfile2().isTvRuntime && !this.isPerformanceConstrained();
        const waitForVerticalSettle = (callback) => {
          if (deferUntilVerticalSettle && !canPreloadHeroDuringVerticalScroll && this.isModernVerticalScrollActive()) {
            this.heroBackdropPreloadTimer = setTimeout(
              () => waitForVerticalSettle(callback),
              MODERN_HOME_CONSTANTS2.verticalScrollSettlePollMs
            );
            return;
          }
          callback();
        };
        const preloadDelay = Math.max(0, Math.min(120, delay3 - 80));
        this.heroBackdropPreloadTimer = setTimeout(() => {
          this.heroBackdropPreloadTimer = null;
          waitForVerticalSettle(() => {
            if (Number(this.heroFocusToken || 0) !== focusToken) {
              return;
            }
            const focusedNode = this.getCurrentFocusedNode();
            if (focusedNode !== node || !node?.isConnected || !node.classList.contains("focused")) {
              return;
            }
            const focusedHero = this.getNodeHeroSource(node);
            if (buildHeroIdentity2(focusedHero) !== scheduledHeroIdentity) {
              return;
            }
            void preloadHeroAssets2(focusedHero, "modern");
          });
        }, preloadDelay);
        const commitHeroWhenSettled = () => {
          if (deferUntilVerticalSettle && this.isModernVerticalScrollActive()) {
            this.heroFocusDelayTimer = setTimeout(commitHeroWhenSettled, MODERN_HOME_CONSTANTS2.verticalScrollSettlePollMs);
            return;
          }
          this.heroFocusDelayTimer = null;
          if (Number(this.heroFocusToken || 0) !== focusToken) {
            return;
          }
          const currentFocusedNode = this.getCurrentFocusedNode();
          if (currentFocusedNode !== node || !node?.isConnected || !node.classList.contains("focused")) {
            return;
          }
          const currentHero = this.getNodeHeroSource(node);
          if (buildHeroIdentity2(currentHero) !== scheduledHeroIdentity) {
            return;
          }
          requestAnimationFrame(() => {
            if (Number(this.heroFocusToken || 0) !== focusToken) {
              return;
            }
            const focusedNode = this.getCurrentFocusedNode();
            if (focusedNode !== node || !node?.isConnected || !node.classList.contains("focused")) {
              return;
            }
            const latestHero = this.getNodeHeroSource(node);
            if (!latestHero || buildHeroIdentity2(latestHero) !== scheduledHeroIdentity) {
              return;
            }
            const shouldEnrichHero = shouldEnrichModernHero2(latestHero);
            const focusedHero = shouldEnrichHero ? { ...latestHero, heroMetaEnriching: true } : { ...latestHero, heroMetaEnriching: false };
            this.heroItem = focusedHero;
            const matchedIndex = this.heroCandidates.findIndex((item) => String(item?.id || "") === String(focusedHero.id || ""));
            if (matchedIndex >= 0) {
              this.heroIndex = matchedIndex;
            }
            this.applyHeroToDom();
            if (shouldEnrichHero) {
              void this.enrichCurrentHeroAsync(focusedHero, focusToken, { deferCommit: true });
              return;
            }
            void preloadHeroAssets2(focusedHero, "modern");
            if (Number(this.heroFocusToken || 0) !== focusToken) {
              return;
            }
            const settledFocusedNode = this.getCurrentFocusedNode();
            if (settledFocusedNode !== node || !node?.isConnected || !node.classList.contains("focused")) {
              return;
            }
            const settledHero = this.getNodeHeroSource(node);
            if (!settledHero || buildHeroIdentity2(settledHero) !== scheduledHeroIdentity) {
              return;
            }
            if (buildHeroIdentity2(this.heroItem) !== scheduledHeroIdentity) {
              return;
            }
          });
        };
        this.heroFocusDelayTimer = setTimeout(commitHeroWhenSettled, delay3);
      }
    };
  }

  // js/ui/screens/home/homeScreenMethods-11-enrich-current-hero-async.js
  init_mdbListSettingsStore();
  function createHomeScreenMethods11() {
    const {
