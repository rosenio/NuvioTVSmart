    Watching: "watching",
    Busy: "busy",
    Away: "away",
    Offline: "offline"
  });
  function t5(key3, params = [], fallback2 = key3) {
    return I18n.t(key3, params, { fallback: fallback2 });
  }
  function escapeHtml5(value) {
